        Token.Hover(inner),
        Token.Focus(inner),
        Token.FocusWithin(inner),
        Token.FocusVisible(inner),
        Token.Active(inner),
        Token.Visited(inner),
        Token.Target(inner),
        Token.Open(inner),
        Token.Inert(inner),
        Token.Disabled(inner),
        Token.Enabled(inner),
        Token.Checked(inner),
        Token.Indeterminate(inner),
        Token.Default(inner),
        Token.Optional(inner),
        Token.Required(inner),
        Token.Valid(inner),
        Token.Invalid(inner),
        Token.UserValid(inner),
        Token.UserInvalid(inner),
        Token.InRange(inner),
        Token.OutOfRange(inner),
        Token.PlaceholderShown(inner),
        Token.Autofill(inner),
        Token.ReadOnly(inner),
        Token.First(inner),
        Token.Last(inner),
        Token.Only(inner),
        Token.Odd(inner),
        Token.Even(inner),
        Token.FirstOfType(inner),
        Token.LastOfType(inner),
        Token.OnlyOfType(inner),
        Token.Empty(inner),
        Token.Nth(index: 3, inner: inner),
        Token.NthLast(index: 5, inner: inner),
        Token.Before(inner),
        Token.After(inner),
        Token.FirstLetter(inner),
        Token.FirstLine(inner),
        Token.Placeholder(inner),
        Token.File(inner),
        Token.Marker(inner),
        Token.Selection(inner),
        Token.Backdrop(inner),
        Token.GroupHover(inner),
        Token.GroupFocus(inner),
        Token.GroupActive(inner),
        Token.GroupVisited(inner),
        Token.GroupDisabled(inner),
        Token.GroupOpen(inner),
        Token.PeerHover(inner),
        Token.PeerFocus(inner),
        Token.PeerActive(inner),
        Token.PeerChecked(inner),
        Token.PeerInvalid(inner),
        Token.PeerRequired(inner),
        Token.PeerDisabled(inner),
        Token.PeerPlaceholderShown(inner),
        Token.Rtl(inner),
        Token.Ltr(inner),
        Token.Children(inner),
        Token.Descendants(inner),
        Token.Important(inner),
    ];
    return out;
}

test "the table — 82 Variant fns and 83 modifier tokens, and no row is a copy" {
    assert everyVariant(defaultTheme()).length == 82;
    assert everyModifier().length == 83;
}

// The distinct-pair fold: two rows that resolved to the same at-rule and the
// same selector would be two names for one variant, which the reference has
// nowhere in its table.
fn pushDistinctString(acc: string[], s: string) -> string[] {
    val present = acc.any({ x -> x == s });
    val one: string[] = [s];
    val out = if (present) acc else acc.append(one);
    return out;
}

fn distinctStrings(xs: string[]) -> string[] {
    val seed: string[] = [];
    return xs.fold(seed, { acc, x -> pushDistinctString(acc, x) });
}

test "the walk — every selector template carries exactly one ampersand" {
    val vs = everyVariant(defaultTheme());
    assert vs.all({ v -> v.selector.split("&").length == 2 });
}

test "the walk — this front builds no brace, and every at-rule is an at-rule" {
    val vs = everyVariant(defaultTheme());
    assert vs.all({ v -> v.selector.split("{").length == 1 });
    assert vs.all({ v -> v.selector.split("}").length == 1 });
    assert vs.all({ v -> v.atRule.split("{").length == 1 });
    assert vs.all({ v -> v.atRule == "" || v.atRule.startsWith("@") });
}

test "the walk — no two rows resolve to the same pair" {
    val vs = everyVariant(defaultTheme());
    val pairs = vs.map({ v -> v.atRule + " <> " + v.selector });
    assert distinctStrings(pairs).length == pairs.length;
}

test "the walk — every modifier wraps its declaration, and none drops it" {
    val ms = everyModifier();
    val sheets = ms.map({ m -> tokenToSheet(m, defaultTheme()) });
    assert sheets.all({ s -> s.rules.length == 1 });
    assert sheets.all({ s -> declarationsOf(s).join("") == "font-weight:bold" });
}

test "the walk — no breakpoint query resolves a pixel, and none is min-width" {
    val vs = everyVariant(defaultTheme());
    assert vs.all({ v -> v.atRule.split("px").length == 1 });
    assert vs.all({ v -> v.atRule.split("min-width").length == 1 });
    assert vs.all({ v -> v.atRule.split("max-width").length == 1 });
}

test "the walk — no variant carries a codec separator" {
    val vs = everyVariant(defaultTheme());
    assert vs.all({ v -> carriesSeparator(v.selector) == false });
    assert vs.all({ v -> carriesSeparator(v.atRule) == false });
}

// ── dark mode — one cell per strategy, all three from front 54 ─────────────
//
// This front does not know which strategy is in force: it asks `darkAtRule`
// and `darkSelector` and hands the pair to `nestVariant`. The three tests
// below are the proof that the pair is enough — `Media` puts the whole
// strategy in the at-rule, `Class` and `Attribute` put it in the selector, and
// the `Dark` token is the same token in all three.

test "dark — the `Media` strategy is an at-rule over the bare ampersand" {
    val th = defaultTheme();
    assert darkVariant(th).atRule == "@media (prefers-color-scheme: dark)";
    assert darkVariant(th).selector == "&";
    val inner = boldInner();
    assert modifierCssWith(Token.Dark(inner), th)
        == "@media (prefers-color-scheme: dark){.x{font-weight:bold}}";
}

test "dark — the `Class` strategy is a selector and no at-rule at all" {
    val th = withDarkMode(defaultTheme(), DarkMode.Class(name: "dark"));
    assert darkVariant(th).atRule == "";
    assert darkVariant(th).selector == "&:where(.dark, .dark *)";
    val inner = boldInner();
    assert modifierCssWith(Token.Dark(inner), th)
        == ".x:where(.dark, .dark *){font-weight:bold}";
}

test "dark — the `Attribute` strategy is the same shape, on a data attribute" {
    val th = withDarkMode(defaultTheme(), DarkMode.Attribute(name: "data-theme", value: "dark"));
    assert darkVariant(th).atRule == "";
    assert darkVariant(th).selector == "&:where([data-theme=dark], [data-theme=dark] *)";
    val inner = boldInner();
    assert modifierCssWith(Token.Dark(inner), th)
        == ".x:where([data-theme=dark], [data-theme=dark] *){font-weight:bold}";
}

test "dark — the strategy is an input to the class, because the rule differs" {
    val inner = boldInner();
    val tokens: Token[] = [Token.Dark(inner)];
    val byMedia = defaultTheme();
    val byClass = withDarkMode(byMedia, DarkMode.Class(name: "dark"));
    assert emiliaWith(tokens, byMedia) != emiliaWith(tokens, byClass);
    val _drop = await flush();
}

// ── ranges, order and depth ───────────────────────────────────────────────

test "a breakpoint RANGE is nesting, not a variant — `md:max-xl:`" {
    val inner = boldInner();
    val mid: Token[] = [Token.MaxXl(inner)];
    assert modifierCss(Token.Md(mid))
        == "@media (width >= 48rem){@media (width < 80rem){.x{font-weight:bold}}}";
}

test "the other range the reference shows — `sm:max-md:`" {
    val inner = boldInner();
    val mid: Token[] = [Token.MaxMd(inner)];
    assert modifierCss(Token.Sm(mid))
        == "@media (width >= 40rem){@media (width < 48rem){.x{font-weight:bold}}}";
}

test "three deep — `dark:md:hover:` comes out in source order" {
    val inner = boldInner();
    val hover: Token[] = [Token.Hover(inner)];
    val md: Token[] = [Token.Md(hover)];
    assert modifierCss(Token.Dark(md))
        == "@media (prefers-color-scheme: dark){@media (width >= 48rem){@media (hover: hover){.x:hover{font-weight:bold}}}}";
}

test "a pseudo-element under a state nests the right way round" {
    val inner = boldInner();
    val before: Token[] = [Token.Before(inner)];
    assert modifierCss(Token.Hover(before))
        == "@media (hover: hover){.x:hover::before{font-weight:bold}}";
}

test "a breakpoint override reaches both directions of the ladder" {
    val wide: ThemeEntry[] = [ThemeEntry(name: "--breakpoint-md", value: "50rem")];
    val th = extendTheme(defaultTheme(), wide);
    val inner = boldInner();
    assert modifierCssWith(Token.Md(inner), th) == "@media (width >= 50rem){.x{font-weight:bold}}";
    assert modifierCssWith(Token.MaxMd(inner), th) == "@media (width < 50rem){.x{font-weight:bold}}";
}

// ── the two indexed rows ──────────────────────────────────────────────────

test "Nth — three indices, including a two-digit one" {
    val inner = boldInner();
    assert modifierCss(Token.Nth(index: 1, inner: inner)) == ".x:nth-child(1){font-weight:bold}";
    assert modifierCss(Token.Nth(index: 3, inner: inner)) == ".x:nth-child(3){font-weight:bold}";
    assert modifierCss(Token.Nth(index: 12, inner: inner)) == ".x:nth-child(12){font-weight:bold}";
    assert nthVariant(7).atRule == "";
    assert nthVariant(7).selector == "&:nth-child(7)";
}

test "NthLast — the same three, counted from the end" {
    val inner = boldInner();
    assert modifierCss(Token.NthLast(index: 1, inner: inner)) == ".x:nth-last-child(1){font-weight:bold}";
    assert modifierCss(Token.NthLast(index: 5, inner: inner)) == ".x:nth-last-child(5){font-weight:bold}";
    assert modifierCss(Token.NthLast(index: 12, inner: inner)) == ".x:nth-last-child(12){font-weight:bold}";
    assert nthLastVariant(7).selector == "&:nth-last-child(7)";
}

// ── the rows whose text is easy to get wrong ──────────────────────────────

// The reference spells this row `&:open, &:popover-open` — two `&`, which
// front 56 refuses. `:is()` holds the two states instead, so the comma is
// INSIDE one selector and never a separator emilia added.

test "the two states of `open` live inside one selector, not a selector list" {
    assert openVariant().selector == "&:is(:open, :popover-open)";
    val inner = boldInner();
    assert modifierCss(Token.Open(inner)) == ".x:is(:open, :popover-open){font-weight:bold}";
    assert tokenToSheet(Token.Open(inner), defaultTheme()).rules.length == 1;
}

test "`marker` and `selection` carry the space before `::`, and the others do not" {
    assert markerVariant().selector == "& ::marker";
    assert selectionVariant().selector == "& ::selection";
    assert beforeVariant().selector == "&::before";
    assert placeholderVariant().selector == "&::placeholder";
}

test "`rtl` and `ltr` put the ampersand LAST, and the class still lands there" {
    val inner = boldInner();
    assert modifierCss(Token.Rtl(inner)) == "[dir=\"rtl\"] .x{font-weight:bold}";
    assert modifierCss(Token.Ltr(inner)) == "[dir=\"ltr\"] .x{font-weight:bold}";
}

test "`*:` and `**:` wrap the ampersand rather than following it" {
    val inner = boldInner();
    assert modifierCss(Token.Children(inner)) == ":is(.x > *){font-weight:bold}";
    assert modifierCss(Token.Descendants(inner)) == ":is(.x *){font-weight:bold}";
}

test "`inert` is the attribute pair the reference gives, not a pseudo-class" {
    assert inertVariant().selector == "&:is([inert], [inert] *)";
}

// ── Important — decision 81, and the one row that is not a variant ─────────

test "Important — the wrapper sets the flag; it adds no selector and no at-rule" {
    val inner = boldInner();
    val r = firstRuleOf(tokenToSheet(Token.Important(inner), defaultTheme()));
    assert r.important == true;
    assert r.selector == "&";
    assert r.atRules.length == 0;
    assert modifierCss(Token.Important(inner)) == ".x{font-weight:bold!important}";
}

test "Important — every rule it wraps is flagged, and a variant nests over it" {
    val two: Token[] = [.Text.Bold, .Layout.Flex];
    val marked: Token[] = [Token.Important(two)];
    val s = tokenToSheet(Token.Hover(marked), defaultTheme());
    assert s.rules.length == 2;
    assert s.rules.all({ r -> r.important });
    val css = s.rules.map({ r -> renderRule("x", r, bareOptions()) }).join("");
    assert css == "@media (hover: hover){.x:hover{font-weight:bold!important}}"
        + "@media (hover: hover){.x:hover{display:flex!important}}";
}

// ── the empty list ────────────────────────────────────────────────────────

test "a modifier whose inner list is empty produces an empty sheet, and is dropped" {
    val none: Token[] = [];
    assert tokenToSheet(Token.Hover(none), defaultTheme()).rules.length == 0;
    assert tokenToSheet(Token.Dark(none), defaultTheme()).rules.length == 0;
    assert tokenToSheet(Token.Nth(index: 2, inner: none), defaultTheme()).rules.length == 0;
    assert tokenToSheet(Token.Important(none), defaultTheme()).rules.length == 0;
}

test "an empty modifier beside a real token leaves exactly the real rule" {
    val none: Token[] = [];
    val tokens: Token[] = [.Text.Bold, Token.Focus(none)];
    val cls = emilia(tokens);
    val styles = await flushWith(bareOptions());
    assert styles == "<style>@layer theme, base, components, utilities;@layer utilities{."
        + cls + "{font-weight:bold}}</style>";
}

// ── end to end ────────────────────────────────────────────────────────────

test "end to end — a light background and its dark override, as one document" {
    val dark: Token[] = [.Bg.Color.Slate.900];
    val tokens: Token[] = [.Bg.Color.White, Token.Dark(dark)];
    val cls = emilia(tokens);
    val styles = await flushWith(bareOptions());
    assert styles == "<style>@layer theme, base, components, utilities;@layer utilities{."
        + cls + "{background-color:var(--color-white)}@media (prefers-color-scheme: dark){."
        + cls + "{background-color:var(--color-slate-900)}}}</style>";
}

test "end to end — a responsive, stateful button is one class and four rules" {
    val hover: Token[] = [.Bg.Color.Blue.700];
    val focus: Token[] = [.Text.Underline];
    val md: Token[] = [.Text.Size.Lg];
    val tokens: Token[] = [
        .Bg.Color.Blue.600,
        Token.Hover(hover),
        Token.FocusVisible(focus),
        Token.Md(md),
    ];
    val cls = emilia(tokens);
    val styles = await flushWith(bareOptions());
    assert styles == "<style>@layer theme, base, components, utilities;@layer utilities{."
        + cls + "{background-color:var(--color-blue-600)}."
        + cls + ":focus-visible{text-decoration:underline}@media (hover: hover){."
        + cls + ":hover{background-color:var(--color-blue-700)}}@media (width >= 48rem){."
        + cls + "{font-size:1.125rem}}}</style>";
}

test "end to end — a peer-driven error message reaches its sibling" {
    val peer: Token[] = [.Bg.Color.Red.600];
    val tokens: Token[] = [.Layout.Hidden, Token.PeerInvalid(peer)];
    val cls = emilia(tokens);
    val styles = await flushWith(bareOptions());
    assert styles == "<style>@layer theme, base, components, utilities;@layer utilities{."
        + cls + "{display:none}."
        + cls + ":is(:where(.peer):invalid ~ *){background-color:var(--color-red-600)}}</style>";
}

//// ═══ END FRONT 34 ═════════════════════════════════════════════════════════════════

fn textTokenToCss(t: Token.Text) -> string {
    val out = case t {
        Bold -> "font-weight:bold";
        Italic -> "font-style:italic";
        Underline -> "text-decoration:underline";
        LineThrough -> "text-decoration:line-through";
        Left -> "text-align:left";
        Center -> "text-align:center";
        Right -> "text-align:right";
        Justify -> "text-align:justify";
        Size(_inner) -> textSizeToCss(_inner);
    };
    return out;
}

fn textSizeToCss(s: Token.Text.Size) -> string {
    val out = case s {
        Xs -> "font-size:0.75rem";
        Sm -> "font-size:0.875rem";
        Base -> "font-size:1rem";
        Lg -> "font-size:1.125rem";
        Xl -> "font-size:1.25rem";
        X2xl -> "font-size:1.5rem";
        X3xl -> "font-size:1.875rem";
        X4xl -> "font-size:2.25rem";
    };
    return out;
}

fn fontTokenToCss(t: Token.Font) -> string {
    val out = case t {
        Sans -> "font-family:ui-sans-serif,system-ui,sans-serif";
        Serif -> "font-family:ui-serif,Georgia,serif";
        Mono -> "font-family:ui-monospace,SFMono-Regular,Menlo,monospace";
        Weight(_inner) -> fontWeightToCss(_inner);
    };
    return out;
}

fn fontWeightToCss(w: Token.Font.Weight) -> string {
    val out = case w {
        Light -> "font-weight:300";
        Normal -> "font-weight:400";
        Medium -> "font-weight:500";
        Bold -> "font-weight:700";
        Black -> "font-weight:900";
    };
    return out;
}

// FRONT 39 OWNS THIS DISPATCHER; front 33 owns the `Color` arm and the theme
// parameter it needs. The four legacy leaves below keep their pre-33 output —
// the `background` SHORTHAND, and a shade the arm discards — so nothing that
// compiled before this front changed meaning. Upstream emits
// `background-color` (`§ 10.3`), which is what the new `Color` sub-section
// emits and what front 39 folds these four into when it lands.
fn bgTokenToCss(t: Token.Bg, th: Theme) -> string {
    val out = case t {
        Color(_inner) -> bgColorTokenToCss(_inner, th);
        Red(_inner) -> "background:red";
        Blue(_inner) -> "background:blue";
        Gray(_inner) -> "background:gray";
        White -> "background:#ffffff";
        Black -> "background:#000000";
        Hex(value) -> "background:" + value;
    };
    return out;
}

// ── front 35 — spacing and sizing ────────────────────────────────────────────
//
// FRONT 35 OWNS EVERYTHING BETWEEN THIS BANNER AND ITS CLOSING ONE: the `Pad`,
// `Margin`, `Size` and `Space` sections of `tokens.bp` and the four dispatchers
// they reach.
//
// EMILIA NEVER RESOLVES A SPACING VALUE. Every leaf below answers `spacing(n)`
// or `spacingHalf(n)` from `spacing.bp` — `calc(var(--spacing) * n)` — and
// never a `rem` literal. A resolved `rem` is byte-different from upstream for
// every spacing utility in the library AND it makes a project's
// `--spacing: 4px` override silently ineffective, so it is wrong by contract
// (`contracts.md` 4a) rather than by taste.
//
// WHAT THIS FRONT CORRECTED. Before it, six hand-written ladders lived here and
// had drifted apart: `padTokenToCss` emitted `padding-x:` and `padding-y:`,
// which are not CSS properties and which every browser discards, and
// `marginScaleX` emitted `m-0.25`, `m-0.5`, `m-1`, `m-2` and `margin-auto` —
// Tailwind CLASS FRAGMENTS, in a position where only a declaration is legal.
// Three of emilia's ten sections emitted text that was not CSS and all three
// were here. The paths that compiled before still compile; only the CSS they
// emit changed, and what they emitted was never valid.

// One declaration — `padding-top:calc(var(--spacing) * 4)`.
fn oneDecl(prop: string, value: string) -> string {
    return prop + ":" + value;
}

// The two-property form an axis utility expands to: `px-4` is BOTH
// `padding-left` and `padding-right`, `;`-joined inside one token, because CSS
// has no `padding-x`.
fn axisDecl(first: string, second: string, value: string) -> string {
    return first + ":" + value + ";" + second + ":" + value;
}

// THE NINE DIRECTIONS OF PADDING. Upstream's `p-`, `px-`, `py-`, `pt-`, `pr-`,
// `pb-`, `pl-`, `ps-` and `pe-`, over the 35-leaf scale: the thirty multipliers
// of the default theme, the `Px` step, and `Half { 0, 1, 2, 3 }` for the `0.5`,
// `1.5`, `2.5` and `3.5` rungs. `0.5` cannot be an enum leaf — a numeric leaf is
// a run of digits — so `Half.1` reads "one and a half".
//
// An axis is TWO properties. The logical pair `S`/`E` is
// `padding-inline-start` / `padding-inline-end`, which follow the writing
// direction where `L`/`R` do not.
fn padTokenToCss(t: Token.Pad, th: Theme) -> string {
    val out = case t {
        All(_inner) -> oneDecl("padding", padScaleAll(_inner, th));
        X(_inner) -> axisDecl("padding-left", "padding-right", padScaleX(_inner, th));
        Y(_inner) -> axisDecl("padding-top", "padding-bottom", padScaleY(_inner, th));
        T(_inner) -> oneDecl("padding-top", padScaleT(_inner, th));
        R(_inner) -> oneDecl("padding-right", padScaleR(_inner, th));
        B(_inner) -> oneDecl("padding-bottom", padScaleB(_inner, th));
        L(_inner) -> oneDecl("padding-left", padScaleL(_inner, th));
        S(_inner) -> oneDecl("padding-inline-start", padScaleS(_inner, th));
        E(_inner) -> oneDecl("padding-inline-end", padScaleE(_inner, th));
    };
    return out;
}

fn padScaleAll(s: Token.Pad.All, th: Theme) -> string {
    val out = case s {
        __0 -> spacing(0); __1 -> spacing(1); __2 -> spacing(2); __3 -> spacing(3);
        __4 -> spacing(4); __5 -> spacing(5); __6 -> spacing(6); __7 -> spacing(7);
        __8 -> spacing(8); __9 -> spacing(9); __10 -> spacing(10); __11 -> spacing(11);
        __12 -> spacing(12); __14 -> spacing(14); __16 -> spacing(16); __20 -> spacing(20);
        __24 -> spacing(24); __28 -> spacing(28); __32 -> spacing(32); __36 -> spacing(36);
        __40 -> spacing(40); __44 -> spacing(44); __48 -> spacing(48); __52 -> spacing(52);
        __56 -> spacing(56); __60 -> spacing(60); __64 -> spacing(64); __72 -> spacing(72);
        __80 -> spacing(80); __96 -> spacing(96);
        Px -> "1px";
        Half(_inner) -> padHalfAll(_inner, th);
    };
    return out;
}

fn padHalfAll(h: Token.Pad.All.Half, th: Theme) -> string {
    val out = case h {
        __0 -> spacingHalf(0); __1 -> spacingHalf(1); __2 -> spacingHalf(2);
        __3 -> spacingHalf(3);
    };
    return out;
}

fn padScaleX(s: Token.Pad.X, th: Theme) -> string {
    val out = case s {
        __0 -> spacing(0); __1 -> spacing(1); __2 -> spacing(2); __3 -> spacing(3);
        __4 -> spacing(4); __5 -> spacing(5); __6 -> spacing(6); __7 -> spacing(7);
        __8 -> spacing(8); __9 -> spacing(9); __10 -> spacing(10); __11 -> spacing(11);
        __12 -> spacing(12); __14 -> spacing(14); __16 -> spacing(16); __20 -> spacing(20);
        __24 -> spacing(24); __28 -> spacing(28); __32 -> spacing(32); __36 -> spacing(36);
        __40 -> spacing(40); __44 -> spacing(44); __48 -> spacing(48); __52 -> spacing(52);
        __56 -> spacing(56); __60 -> spacing(60); __64 -> spacing(64); __72 -> spacing(72);
        __80 -> spacing(80); __96 -> spacing(96);
        Px -> "1px";
        Half(_inner) -> padHalfX(_inner, th);
    };
    return out;
}

fn padHalfX(h: Token.Pad.X.Half, th: Theme) -> string {
    val out = case h {
        __0 -> spacingHalf(0); __1 -> spacingHalf(1); __2 -> spacingHalf(2);
        __3 -> spacingHalf(3);
    };
    return out;
}

fn padScaleY(s: Token.Pad.Y, th: Theme) -> string {
    val out = case s {
        __0 -> spacing(0); __1 -> spacing(1); __2 -> spacing(2); __3 -> spacing(3);
        __4 -> spacing(4); __5 -> spacing(5); __6 -> spacing(6); __7 -> spacing(7);
        __8 -> spacing(8); __9 -> spacing(9); __10 -> spacing(10); __11 -> spacing(11);
        __12 -> spacing(12); __14 -> spacing(14); __16 -> spacing(16); __20 -> spacing(20);
        __24 -> spacing(24); __28 -> spacing(28); __32 -> spacing(32); __36 -> spacing(36);
        __40 -> spacing(40); __44 -> spacing(44); __48 -> spacing(48); __52 -> spacing(52);
        __56 -> spacing(56); __60 -> spacing(60); __64 -> spacing(64); __72 -> spacing(72);
        __80 -> spacing(80); __96 -> spacing(96);
        Px -> "1px";
        Half(_inner) -> padHalfY(_inner, th);
    };
    return out;
}

fn padHalfY(h: Token.Pad.Y.Half, th: Theme) -> string {
    val out = case h {
        __0 -> spacingHalf(0); __1 -> spacingHalf(1); __2 -> spacingHalf(2);
        __3 -> spacingHalf(3);
    };
    return out;
}

fn padScaleT(s: Token.Pad.T, th: Theme) -> string {
    val out = case s {
        __0 -> spacing(0); __1 -> spacing(1); __2 -> spacing(2); __3 -> spacing(3);
        __4 -> spacing(4); __5 -> spacing(5); __6 -> spacing(6); __7 -> spacing(7);
        __8 -> spacing(8); __9 -> spacing(9); __10 -> spacing(10); __11 -> spacing(11);
        __12 -> spacing(12); __14 -> spacing(14); __16 -> spacing(16); __20 -> spacing(20);
        __24 -> spacing(24); __28 -> spacing(28); __32 -> spacing(32); __36 -> spacing(36);
        __40 -> spacing(40); __44 -> spacing(44); __48 -> spacing(48); __52 -> spacing(52);
        __56 -> spacing(56); __60 -> spacing(60); __64 -> spacing(64); __72 -> spacing(72);
        __80 -> spacing(80); __96 -> spacing(96);
        Px -> "1px";
        Half(_inner) -> padHalfT(_inner, th);
    };
