import {Token} from "tokens";
import {Theme, ThemeEntry, DarkMode, defaultTheme, emptyTheme, extendTheme, themeValue} from "theme";
import {darkAtRule, darkSelector, withDarkMode} from "theme";
import {Ns, nsPrefix, themeVar, namespace} from "theme";
import {spacing, spacingHalf} from "spacing";
import {Rule, Block, Sheet, Variant, Options} from "output";
import {emptySheet, declSheet, mergeSheet, declarationsOf, nestVariant, markImportant} from "output";
import {encodeSheet, decodeSheet, carriesSeparator} from "output";
import {defaultOptions, withTheme, renderRule, renderDocument} from "output";

//// ═══ FRONT 56 · the host cells and the public entry points ═══════════════
////
//// Everything between this banner and the section sub-dispatchers below is
//// front 56's (`specs/1.0.10-beta/05-emilia/56-emilia-cascade-and-output/`).
//// The per-section sub-dispatchers under it are fronts 33-47's, 57's and
//// 58's, and this front does not touch them.

// ── host cells ────────────────────────────────────────────────────
//
// The `Stylesheet` host cell is a JS `Map` lazily created on `globalThis`
// (commonJS), or an ordered `[{Name, Body}]` list in the process dictionary
// under `'__emilia_sheet'` (erlang: `lists:keystore` keeps the Map's
// insertion order, `erase` clears it).
//
// THE CELL IS A DUMB STRING STORE AND NOTHING ELSE. It used to assemble the
// `<style>` document itself, twice — once in the commonJS template and once in
// the Erlang one — which is where the byte-level divergence risk lived and
// which nothing written in botopink could test. `drainRules()` hands the raw
// payloads back instead and `output.bp` renders them, in one place, on both
// targets. Every ordering decision, every brace and the `<style>` element
// itself now live in `renderDocument`.
//
// `register(name, body)` writes (name -> body). `drainRules()` returns the
// entries as `name + "\t" + payload` records joined by `"\n"`, in insertion
// order, and clears the cell — the per-render contract the old `flushSheet`
// had: two consecutive drains give two independent documents, and the second
// registers nothing.
//
// A payload is an `encodeSheet` string, whose own records are ALSO joined by
// `"\n"`, so the drain stream layers two separators on one character. It stays
// unambiguous because a payload record is tagged `R` or `B` and a registered
// name never is; `output.bp`'s `drainStep` is where that is written down.
//
// `drainRules` returns `@Future<string>` — wrapped in `Promise.resolve(...)`
// so the public `flush()` surface is awaitable from any callsite (an SSR
// pipeline may chain it with `await renderToString(page)` symmetric to
// `await fetch(url)` from `std/http`). Tests support `await` via the
// implicit future context (`inferTestDecl`) + `async function` emission
// in `commonJS.emitTestFn`. The erlang backend's eager `@Future<T>` = `T`
// rule makes `await` an identity there.
//
// Both commonJS and erlang carry the cells; beam/wasm are not ported.
#[@External.node(when(argc == 2): """(function(__N, __B){ (globalThis.__emilia_sheet ||= new Map()).set(__N, __B); })($0, $1)""")]
#[@External.Erlang("""(fun(N__, B__) -> L__ = case get('__emilia_sheet') of undefined -> []; X__ -> X__ end, put('__emilia_sheet', lists:keystore(N__, 1, L__, {N__, B__})), ok end)($0, $1)""")]
declare fn register(name: string, body: string) -> void;

#[@future]
#[@External.node(when(argc == 0): """Promise.resolve((function(){ var __M = (globalThis.__emilia_sheet ||= new Map()); var __S = Array.from(__M.entries()).map(function(__E){ return __E[0] + "\t" + __E[1]; }).join("\n"); __M.clear(); return __S; })())""")]
#[@External.Erlang("""(fun() -> L__ = case erase('__emilia_sheet') of undefined -> []; X__ -> X__ end, iolist_to_binary(lists:join(<<"\n">>, [[K__, <<"\t">>, V__] || {K__, V__} <- L__])) end)()""")]
declare fn drainRules() -> @Future<string>;

// Content-derived class id. djb2-style fold over the body's UTF-16 code
// units, rendered as a lowercase hex string. Identical inputs → identical
// hex → identical class name (the acceptance gate `hash`). The erlang form
// folds the same djb2 over the codepoints masked to 32 bits, so both targets
// produce the same class name for ASCII rule bodies (astral characters are one
// codepoint in erlang, two UTF-16 units in JS).
//
// WHAT IS FOLDED CHANGED WITH FRONT 56, and contract 4 of the milestone takes
// the amendment. It used to be `tokensToCss(tokens)`; it is
// `encodeSheet(tokensToSheet(tokens, th))` now, because a `Sheet` is what a
// token list produces. Every property the contract rests on survives: still a
// pure function of its input, still ASCII-only, token order is still class
// identity. The one clause that changes is clause 1 — the hash is a pure
// function of the token list AND THE THEME, because a `md:` variant carries the
// theme's `--breakpoint-md` and a themed utility will carry more. The literal
// hex of any pinned fixture is regenerated once, here.
#[@External.node(when(argc == 1): """(function(__S){ var __H = 5381; for (var __I = 0; __I < __S.length; __I++) { __H = (Math.imul(__H, 33) + __S.charCodeAt(__I)) >>> 0; } return __H.toString(16); })($0)""")]
#[@External.Erlang("""(fun(S__) -> H__ = lists:foldl(fun(C__, A__) -> (A__ * 33 + C__) band 16#FFFFFFFF end, 5381, unicode:characters_to_list(S__)), list_to_binary(string:lowercase(integer_to_list(H__, 16))) end)($0)""")]
declare fn hashHex(s: string) -> string;

// ── public API ───────────────────────────────────────────────────

// Walk a `Token[]` under a theme → encode the `Sheet` it produces → register
// it under its content hash → return the assigned class name.
pub fn emiliaWith(tokens: Token[], th: Theme) -> string {
    val payload = encodeSheet(tokensToSheet(tokens, th));
    val name = "e_" + hashHex(payload);
    register(name, payload);
    return name;
}

// The single public emilia call, on the stock theme. The signature is the one
// it had before front 56, so no consumer changes.
pub fn emilia(tokens: Token[]) -> string {
    return emiliaWith(tokens, defaultTheme());
}

// Drain the cell and render the document under `o`. Per-render contract — two
// consecutive calls emit two independent documents; the second carries the
// theme and base layers `o` asks for and no `@layer utilities` body, because
// nothing registered in between.
//
// Async (`@Future<string>`) so the SSR caller can chain it with the other
// async pieces of a render pipeline (`await renderToString(page) + await
// flush()`). Tests resolve the future inline via the implicit `test {…}`
// future context.
#[@future]
pub fn flushWith(o: Options) -> @Future<string> {
    val raw = await drainRules();
    return renderDocument(raw, o);
}

// The stock render: emilia's default theme, no reset, no prefix, cascade
// layers on. The signature is the one it had before front 56.
#[@future]
pub fn flush() -> @Future<string> {
    return await flushWith(defaultOptions());
}

// ── the shared dispatcher ───────────────────────────────────────────

// Exhaustive dispatch over the V1 nested-section `Token` enum, and the ONE
// line each of fronts 33-47 owns. A section arm adapts its sub-dispatcher's
// declaration string with `declSheet(…)`; a modifier arm wraps the inner
// sheet in a `Variant`. A front whose tokens genuinely need a selector
// (`space-x-*`, `divide-*`) swaps its arm for `…TokenToSheet(_inner, th)` and
// says so in its own README: two shapes, one line each.
//
// THE THEME REACHES THIS DISPATCHER, NOT THE SUB-DISPATCHERS. The ten section
// sub-dispatchers keep their front 54 signature; the front that needs the
// theme adds the parameter to its own function and to its own line here. The
// spec of this front asks 56 to change all ten signatures at once, which would
// have front 56 editing ten functions three other fronts are rewriting in
// parallel for no gain — the arm is one line either way.
fn tokenToSheet(t: Token, th: Theme) -> Sheet {
    val out = case t {
        Text(_inner) -> declSheet(textTokenToCss(_inner));
        Font(_inner) -> declSheet(fontTokenToCss(_inner));
        Color(_inner) -> declSheet(colorTokenToCss(_inner, th));
        Bg(_inner) -> declSheet(bgTokenToCss(_inner, th));
        Pad(_inner) -> declSheet(padTokenToCss(_inner, th));
        Margin(_inner) -> declSheet(marginTokenToCss(_inner, th));
        Size(_inner) -> declSheet(sizeTokenToCss(_inner, th));
        Space(_inner) -> spaceTokenToSheet(_inner, th);
        Layout(_inner) -> declSheet(layoutTokenToCss(_inner));
        Flex(_inner) -> declSheet(flexTokenToCss(_inner));
        Border(_inner) -> declSheet(borderTokenToCss(_inner));
        Effect(_inner) -> declSheet(effectTokenToCss(_inner));
        Alpha(percent, inner) -> alphaSheet(tokensToSheet(inner, th), percent);
        // ── front 34 — modifiers ─────────────────────────────────────────
        Sm(inner) -> nestVariant(tokensToSheet(inner, th), smVariant(th));
        Md(inner) -> nestVariant(tokensToSheet(inner, th), mdVariant(th));
        Lg(inner) -> nestVariant(tokensToSheet(inner, th), lgVariant(th));
        Xl(inner) -> nestVariant(tokensToSheet(inner, th), xlVariant(th));
        X2xl(inner) -> nestVariant(tokensToSheet(inner, th), x2xlVariant(th));
        MaxSm(inner) -> nestVariant(tokensToSheet(inner, th), maxSmVariant(th));
        MaxMd(inner) -> nestVariant(tokensToSheet(inner, th), maxMdVariant(th));
        MaxLg(inner) -> nestVariant(tokensToSheet(inner, th), maxLgVariant(th));
        MaxXl(inner) -> nestVariant(tokensToSheet(inner, th), maxXlVariant(th));
        MaxX2xl(inner) -> nestVariant(tokensToSheet(inner, th), maxX2xlVariant(th));
        Dark(inner) -> nestVariant(tokensToSheet(inner, th), darkVariant(th));
        Print(inner) -> nestVariant(tokensToSheet(inner, th), printVariant());
        Portrait(inner) -> nestVariant(tokensToSheet(inner, th), portraitVariant());
        Landscape(inner) -> nestVariant(tokensToSheet(inner, th), landscapeVariant());
        MotionSafe(inner) -> nestVariant(tokensToSheet(inner, th), motionSafeVariant());
        MotionReduce(inner) -> nestVariant(tokensToSheet(inner, th), motionReduceVariant());
        ContrastMore(inner) -> nestVariant(tokensToSheet(inner, th), contrastMoreVariant());
        ContrastLess(inner) -> nestVariant(tokensToSheet(inner, th), contrastLessVariant());
        ForcedColors(inner) -> nestVariant(tokensToSheet(inner, th), forcedColorsVariant());
        Hover(inner) -> nestVariant(tokensToSheet(inner, th), hoverVariant());
        Focus(inner) -> nestVariant(tokensToSheet(inner, th), focusVariant());
        FocusWithin(inner) -> nestVariant(tokensToSheet(inner, th), focusWithinVariant());
        FocusVisible(inner) -> nestVariant(tokensToSheet(inner, th), focusVisibleVariant());
        Active(inner) -> nestVariant(tokensToSheet(inner, th), activeVariant());
        Visited(inner) -> nestVariant(tokensToSheet(inner, th), visitedVariant());
        Target(inner) -> nestVariant(tokensToSheet(inner, th), targetVariant());
        Open(inner) -> nestVariant(tokensToSheet(inner, th), openVariant());
        Inert(inner) -> nestVariant(tokensToSheet(inner, th), inertVariant());
        Disabled(inner) -> nestVariant(tokensToSheet(inner, th), disabledVariant());
        Enabled(inner) -> nestVariant(tokensToSheet(inner, th), enabledVariant());
        Checked(inner) -> nestVariant(tokensToSheet(inner, th), checkedVariant());
        Indeterminate(inner) -> nestVariant(tokensToSheet(inner, th), indeterminateVariant());
        Default(inner) -> nestVariant(tokensToSheet(inner, th), defaultVariant());
        Optional(inner) -> nestVariant(tokensToSheet(inner, th), optionalVariant());
        Required(inner) -> nestVariant(tokensToSheet(inner, th), requiredVariant());
        Valid(inner) -> nestVariant(tokensToSheet(inner, th), validVariant());
        Invalid(inner) -> nestVariant(tokensToSheet(inner, th), invalidVariant());
        UserValid(inner) -> nestVariant(tokensToSheet(inner, th), userValidVariant());
        UserInvalid(inner) -> nestVariant(tokensToSheet(inner, th), userInvalidVariant());
        InRange(inner) -> nestVariant(tokensToSheet(inner, th), inRangeVariant());
        OutOfRange(inner) -> nestVariant(tokensToSheet(inner, th), outOfRangeVariant());
        PlaceholderShown(inner) -> nestVariant(tokensToSheet(inner, th), placeholderShownVariant());
        Autofill(inner) -> nestVariant(tokensToSheet(inner, th), autofillVariant());
        ReadOnly(inner) -> nestVariant(tokensToSheet(inner, th), readOnlyVariant());
        First(inner) -> nestVariant(tokensToSheet(inner, th), firstVariant());
        Last(inner) -> nestVariant(tokensToSheet(inner, th), lastVariant());
        Only(inner) -> nestVariant(tokensToSheet(inner, th), onlyVariant());
        Odd(inner) -> nestVariant(tokensToSheet(inner, th), oddVariant());
        Even(inner) -> nestVariant(tokensToSheet(inner, th), evenVariant());
        FirstOfType(inner) -> nestVariant(tokensToSheet(inner, th), firstOfTypeVariant());
        LastOfType(inner) -> nestVariant(tokensToSheet(inner, th), lastOfTypeVariant());
        OnlyOfType(inner) -> nestVariant(tokensToSheet(inner, th), onlyOfTypeVariant());
        Empty(inner) -> nestVariant(tokensToSheet(inner, th), emptyVariant());
        Nth(index, inner) -> nestVariant(tokensToSheet(inner, th), nthVariant(index));
        NthLast(index, inner) -> nestVariant(tokensToSheet(inner, th), nthLastVariant(index));
        Before(inner) -> nestVariant(tokensToSheet(inner, th), beforeVariant());
        After(inner) -> nestVariant(tokensToSheet(inner, th), afterVariant());
        FirstLetter(inner) -> nestVariant(tokensToSheet(inner, th), firstLetterVariant());
        FirstLine(inner) -> nestVariant(tokensToSheet(inner, th), firstLineVariant());
        Placeholder(inner) -> nestVariant(tokensToSheet(inner, th), placeholderVariant());
        File(inner) -> nestVariant(tokensToSheet(inner, th), fileVariant());
        Marker(inner) -> nestVariant(tokensToSheet(inner, th), markerVariant());
        Selection(inner) -> nestVariant(tokensToSheet(inner, th), selectionVariant());
        Backdrop(inner) -> nestVariant(tokensToSheet(inner, th), backdropVariant());
        GroupHover(inner) -> nestVariant(tokensToSheet(inner, th), groupHoverVariant());
        GroupFocus(inner) -> nestVariant(tokensToSheet(inner, th), groupFocusVariant());
        GroupActive(inner) -> nestVariant(tokensToSheet(inner, th), groupActiveVariant());
        GroupVisited(inner) -> nestVariant(tokensToSheet(inner, th), groupVisitedVariant());
        GroupDisabled(inner) -> nestVariant(tokensToSheet(inner, th), groupDisabledVariant());
        GroupOpen(inner) -> nestVariant(tokensToSheet(inner, th), groupOpenVariant());
        PeerHover(inner) -> nestVariant(tokensToSheet(inner, th), peerHoverVariant());
        PeerFocus(inner) -> nestVariant(tokensToSheet(inner, th), peerFocusVariant());
        PeerActive(inner) -> nestVariant(tokensToSheet(inner, th), peerActiveVariant());
        PeerChecked(inner) -> nestVariant(tokensToSheet(inner, th), peerCheckedVariant());
        PeerInvalid(inner) -> nestVariant(tokensToSheet(inner, th), peerInvalidVariant());
        PeerRequired(inner) -> nestVariant(tokensToSheet(inner, th), peerRequiredVariant());
        PeerDisabled(inner) -> nestVariant(tokensToSheet(inner, th), peerDisabledVariant());
        PeerPlaceholderShown(inner) -> nestVariant(tokensToSheet(inner, th), peerPlaceholderShownVariant());
        Rtl(inner) -> nestVariant(tokensToSheet(inner, th), rtlVariant());
        Ltr(inner) -> nestVariant(tokensToSheet(inner, th), ltrVariant());
        Children(inner) -> nestVariant(tokensToSheet(inner, th), childrenVariant());
        Descendants(inner) -> nestVariant(tokensToSheet(inner, th), descendantsVariant());
        Important(inner) -> markImportant(tokensToSheet(inner, th));
        // ── end front 34 ─────────────────────────────────────────────────
    };
    return out;
}

// Fold a token list into one sheet. LIST ORDER IS PRESERVED, which is what
// makes token order class identity and what makes the last token setting a
// property the one that wins.
fn tokensToSheet(tokens: Token[], th: Theme) -> Sheet {
    return tokens.fold(emptySheet(), { acc, t -> mergeSheet(acc, tokenToSheet(t, th)) });
}

//// ═══ END FRONT 56 — everything below is fronts 33-47, 57 and 58 ═════════

//// ═══ FRONT 34 · the modifier variant table ═══════════════════════════════
////
//// A modifier is the only way a token reaches a state, a breakpoint or a
//// pseudo-element. There are eighty-three, and every one of them is the same
//// two things: a top-level `Token` variant carrying `inner: Token[]`
//// (`tokens.bp`, same banner), and ONE `Variant`-returning fn here.
////
//// THIS FRONT OWNS NO WRAPPING LOGIC. `Variant(atRule, selector)`,
//// `nestVariant` and the one-`&` nesting template are front 56's, and no
//// function below builds a `{` or a `}` or concatenates an inner sheet.
//// Two consequences worth stating, because they are what makes the two
//// fields enough for the whole reference table:
////
////   - a variant is nested by SUBSTITUTING the inner rule's `&` with the
////     outer variant's selector, so `[dir="rtl"] &` and `:is(& > *)` — where
////     the class is not leading — go through the same field as `&:focus`;
////   - an empty `atRule` means the variant is purely a selector, and a `"&"`
////     selector means it is purely an at-rule.
////
//// A BREAKPOINT READS THE THEME (decision 82), both ways round: `mdVariant`
//// and `maxMdVariant` both resolve `--breakpoint-md`, so a project that
//// overrides the ladder gets its own queries and its own class hashes.
//// `darkVariant` likewise consumes front 54's `darkAtRule`/`darkSelector`
//// rather than re-deciding the strategy: `DarkMode.Media` answers an at-rule
//// and a bare `&`, `DarkMode.Class` and `DarkMode.Attribute` answer no
//// at-rule and a `:where(…)` selector, and this front never learns which.
////
//// `Important` is the one row that is not a variant at all — decision 81
//// gives front 34 upstream's per-utility `!`, and it is one line on top of
//// front 56's `markImportant`.

// ── the shapes a variant takes ────────────────────────────────────────────

// Purely a selector — the reference's `focus`, `before`, `rtl`, `group-*` rows.
fn selectorVariant(selector: string) -> Variant {
    return Variant(atRule: "", selector: selector);
}

// Purely an at-rule — the reference's `print`, `portrait`, `motion-*` rows.
// The selector is the bare `&`, so the rule it wraps keeps its own.
fn atRuleVariant(atRule: string) -> Variant {
    return Variant(atRule: atRule, selector: "&");
}

// `sm:` … `2xl:`, upstream's `width >= <breakpoint>` form. The width is the
// THEME's, never a literal: `--breakpoint-md` is `48rem` in the stock theme
// and whatever the project says otherwise.
fn breakpointVariant(th: Theme, name: string) -> Variant {
    return Variant(atRule: "@media (width >= " + themeValue(th, name) + ")", selector: "&");
}

// `max-sm:` … `max-2xl:`, the same entry read as an exclusive upper bound. A
// RANGE is nesting and not a variant: `md:max-xl:` is `Md([MaxXl([…])])`.
fn maxBreakpointVariant(th: Theme, name: string) -> Variant {
    return Variant(atRule: "@media (width < " + themeValue(th, name) + ")", selector: "&");
}

// The reference gives `group-*` as one template with the state substituted in,
// so it is written once. `.group` is a class the CONSUMER's markup carries;
// emilia never emits it.
fn groupVariant(state: string) -> Variant {
    return selectorVariant("&:is(:where(.group)" + state + " *)");
}

// The same, for the sibling form. `.peer` is the consumer's too.
fn peerVariant(state: string) -> Variant {
    return selectorVariant("&:is(:where(.peer)" + state + " ~ *)");
}

// ── breakpoints — min-width, read from the theme's `--breakpoint-*` ladder ───

pub fn smVariant(th: Theme) -> Variant {
    return breakpointVariant(th, "--breakpoint-sm");
}

pub fn mdVariant(th: Theme) -> Variant {
    return breakpointVariant(th, "--breakpoint-md");
}

pub fn lgVariant(th: Theme) -> Variant {
    return breakpointVariant(th, "--breakpoint-lg");
}

pub fn xlVariant(th: Theme) -> Variant {
    return breakpointVariant(th, "--breakpoint-xl");
}

pub fn x2xlVariant(th: Theme) -> Variant {
    return breakpointVariant(th, "--breakpoint-2xl");
}

// ── breakpoints — max-width, the same ladder read the other way ──────────

pub fn maxSmVariant(th: Theme) -> Variant {
    return maxBreakpointVariant(th, "--breakpoint-sm");
}

pub fn maxMdVariant(th: Theme) -> Variant {
    return maxBreakpointVariant(th, "--breakpoint-md");
}

pub fn maxLgVariant(th: Theme) -> Variant {
    return maxBreakpointVariant(th, "--breakpoint-lg");
}

pub fn maxXlVariant(th: Theme) -> Variant {
    return maxBreakpointVariant(th, "--breakpoint-xl");
}

pub fn maxX2xlVariant(th: Theme) -> Variant {
    return maxBreakpointVariant(th, "--breakpoint-2xl");
}

// ── dark mode and the other media features ───────────────────────────────

pub fn darkVariant(th: Theme) -> Variant {
    return Variant(atRule: darkAtRule(th), selector: darkSelector(th));
}

pub fn printVariant() -> Variant {
    return atRuleVariant("@media print");
}

pub fn portraitVariant() -> Variant {
    return atRuleVariant("@media (orientation: portrait)");
}

pub fn landscapeVariant() -> Variant {
    return atRuleVariant("@media (orientation: landscape)");
}

pub fn motionSafeVariant() -> Variant {
    return atRuleVariant("@media (prefers-reduced-motion: no-preference)");
}

pub fn motionReduceVariant() -> Variant {
    return atRuleVariant("@media (prefers-reduced-motion: reduce)");
}

pub fn contrastMoreVariant() -> Variant {
    return atRuleVariant("@media (prefers-contrast: more)");
}

pub fn contrastLessVariant() -> Variant {
    return atRuleVariant("@media (prefers-contrast: less)");
}

pub fn forcedColorsVariant() -> Variant {
    return atRuleVariant("@media (forced-colors: active)");
}

// ── interaction state ────────────────────────────────────────────────────

pub fn hoverVariant() -> Variant {
    return Variant(atRule: "@media (hover: hover)", selector: "&:hover");
}

pub fn focusVariant() -> Variant {
    return selectorVariant("&:focus");
}

pub fn focusWithinVariant() -> Variant {
    return selectorVariant("&:focus-within");
}

pub fn focusVisibleVariant() -> Variant {
    return selectorVariant("&:focus-visible");
}

pub fn activeVariant() -> Variant {
    return selectorVariant("&:active");
}

pub fn visitedVariant() -> Variant {
    return selectorVariant("&:visited");
}

pub fn targetVariant() -> Variant {
    return selectorVariant("&:target");
}

// THE REFERENCE ROW DOES NOT SURVIVE FRONT 56. `§ 3.2` spells `open` as
// `&:open, &:popover-open`, which carries TWO `&` and is refused by
// `checkVariantSelector` with no opt-out — correctly, since the two-`&` form
// duplicates the rule it wraps. The two states go inside one `:is()` instead:
// one `&`, the same match set, and no selector list for front 56 to split.
pub fn openVariant() -> Variant {
    return selectorVariant("&:is(:open, :popover-open)");
}

pub fn inertVariant() -> Variant {
    return selectorVariant("&:is([inert], [inert] *)");
}

// ── form state ───────────────────────────────────────────────────────────

pub fn disabledVariant() -> Variant {
    return selectorVariant("&:disabled");
}

pub fn enabledVariant() -> Variant {
    return selectorVariant("&:enabled");
}

pub fn checkedVariant() -> Variant {
    return selectorVariant("&:checked");
}

pub fn indeterminateVariant() -> Variant {
    return selectorVariant("&:indeterminate");
}

pub fn defaultVariant() -> Variant {
    return selectorVariant("&:default");
}

pub fn optionalVariant() -> Variant {
    return selectorVariant("&:optional");
}

pub fn requiredVariant() -> Variant {
    return selectorVariant("&:required");
}

pub fn validVariant() -> Variant {
    return selectorVariant("&:valid");
}

pub fn invalidVariant() -> Variant {
    return selectorVariant("&:invalid");
}

pub fn userValidVariant() -> Variant {
    return selectorVariant("&:user-valid");
}

pub fn userInvalidVariant() -> Variant {
    return selectorVariant("&:user-invalid");
}

pub fn inRangeVariant() -> Variant {
    return selectorVariant("&:in-range");
}

pub fn outOfRangeVariant() -> Variant {
    return selectorVariant("&:out-of-range");
}

pub fn placeholderShownVariant() -> Variant {
    return selectorVariant("&:placeholder-shown");
}

pub fn autofillVariant() -> Variant {
    return selectorVariant("&:autofill");
}

pub fn readOnlyVariant() -> Variant {
    return selectorVariant("&:read-only");
}

// ── structural position ──────────────────────────────────────────────────

pub fn firstVariant() -> Variant {
    return selectorVariant("&:first-child");
}

pub fn lastVariant() -> Variant {
    return selectorVariant("&:last-child");
}

pub fn onlyVariant() -> Variant {
    return selectorVariant("&:only-child");
}

pub fn oddVariant() -> Variant {
    return selectorVariant("&:nth-child(odd)");
}

pub fn evenVariant() -> Variant {
    return selectorVariant("&:nth-child(even)");
}

pub fn firstOfTypeVariant() -> Variant {
    return selectorVariant("&:first-of-type");
}

pub fn lastOfTypeVariant() -> Variant {
    return selectorVariant("&:last-of-type");
}

pub fn onlyOfTypeVariant() -> Variant {
    return selectorVariant("&:only-of-type");
}

pub fn emptyVariant() -> Variant {
    return selectorVariant("&:empty");
}

pub fn nthVariant(index: i32) -> Variant {
    return selectorVariant("&:nth-child(" + index.toString() + ")");
}

pub fn nthLastVariant(index: i32) -> Variant {
    return selectorVariant("&:nth-last-child(" + index.toString() + ")");
}

// ── pseudo-elements ──────────────────────────────────────────────────────

pub fn beforeVariant() -> Variant {
    return selectorVariant("&::before");
}

pub fn afterVariant() -> Variant {
    return selectorVariant("&::after");
}

pub fn firstLetterVariant() -> Variant {
    return selectorVariant("&::first-letter");
}

pub fn firstLineVariant() -> Variant {
    return selectorVariant("&::first-line");
}

pub fn placeholderVariant() -> Variant {
    return selectorVariant("&::placeholder");
}

pub fn fileVariant() -> Variant {
    return selectorVariant("&::file-selector-button");
}

pub fn markerVariant() -> Variant {
    return selectorVariant("& ::marker");
}

pub fn selectionVariant() -> Variant {
    return selectorVariant("& ::selection");
}

pub fn backdropVariant() -> Variant {
    return selectorVariant("&::backdrop");
}

// ── parent state — the `.group` class is the consumer's, never emilia's ───

pub fn groupHoverVariant() -> Variant {
    return groupVariant(":hover");
}

pub fn groupFocusVariant() -> Variant {
    return groupVariant(":focus");
}

pub fn groupActiveVariant() -> Variant {
    return groupVariant(":active");
}

pub fn groupVisitedVariant() -> Variant {
    return groupVariant(":visited");
}

pub fn groupDisabledVariant() -> Variant {
    return groupVariant(":disabled");
}

pub fn groupOpenVariant() -> Variant {
    return groupVariant(":open");
}

// ── sibling state — the `.peer` class is the consumer's, never emilia's ───

pub fn peerHoverVariant() -> Variant {
    return peerVariant(":hover");
}

pub fn peerFocusVariant() -> Variant {
    return peerVariant(":focus");
}

pub fn peerActiveVariant() -> Variant {
    return peerVariant(":active");
}

pub fn peerCheckedVariant() -> Variant {
    return peerVariant(":checked");
}

pub fn peerInvalidVariant() -> Variant {
    return peerVariant(":invalid");
}

pub fn peerRequiredVariant() -> Variant {
    return peerVariant(":required");
}

pub fn peerDisabledVariant() -> Variant {
    return peerVariant(":disabled");
}

pub fn peerPlaceholderShownVariant() -> Variant {
    return peerVariant(":placeholder-shown");
}

// ── writing direction and descent ────────────────────────────────────────

pub fn rtlVariant() -> Variant {
    return selectorVariant("[dir=\"rtl\"] &");
}

pub fn ltrVariant() -> Variant {
    return selectorVariant("[dir=\"ltr\"] &");
}

pub fn childrenVariant() -> Variant {
    return selectorVariant(":is(& > *)");
}

pub fn descendantsVariant() -> Variant {
    return selectorVariant(":is(& *)");
}

// ── front 34 · tests ─────────────────────────────────────────────────────
//
// Each family gets two: the `Variant` halves against the reference's two
// columns, and the CSS the row renders once front 56's `nestVariant` and
// `renderRule` have applied it. The rendered form is what a reader checks
// against upstream; the halves are what this front actually writes.

fn boldInner() -> Token[] {
    val out: Token[] = [.Text.Bold];
    return out;
}

// The CSS one modifier renders around `font-weight:bold`, on a class called
// `x` and with the theme layer switched off, so the assertion is the row.
fn modifierCssWith(t: Token, th: Theme) -> string {
    return renderRule("x", firstRuleOf(tokenToSheet(t, th)), bareOptions());
}

fn modifierCss(t: Token) -> string {
    return modifierCssWith(t, defaultTheme());
}

test "breakpoints, min-width — the two halves of every Variant in the family" {
    val th = defaultTheme();
    assert smVariant(th).atRule == "@media (width >= 40rem)";
    assert smVariant(th).selector == "&";
    assert mdVariant(th).atRule == "@media (width >= 48rem)";
    assert mdVariant(th).selector == "&";
    assert lgVariant(th).atRule == "@media (width >= 64rem)";
    assert lgVariant(th).selector == "&";
    assert xlVariant(th).atRule == "@media (width >= 80rem)";
    assert xlVariant(th).selector == "&";
    assert x2xlVariant(th).atRule == "@media (width >= 96rem)";
    assert x2xlVariant(th).selector == "&";
}

