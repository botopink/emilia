import {Token} from "tokens";
import {Theme, ThemeEntry, DarkMode, defaultTheme, emptyTheme, extendTheme, themeValue} from "theme";
import {Rule, Block, Sheet, Variant, Options} from "output";
import {emptySheet, declSheet, mergeSheet, declarationsOf, nestVariant} from "output";
import {encodeSheet, decodeSheet, carriesSeparator} from "output";
import {defaultOptions, withTheme, renderDocument} from "output";

//// ═══ FRONT 56 · the host cells and the public entry points ═══════════════
////
//// Everything between this banner and the section sub-dispatchers below is
//// front 56's (`specs/1.0.10-beta/05-emilia/56-emilia-cascade-and-output/`).
//// The per-section sub-dispatchers under it are fronts 33-47's, 57's and
//// 58's, and this front does not touch them.

// ── host cells ────────────────────────────────────────────────────
//
// The `Stylesheet` host cell is a JS `Map` lazily created on `globalThis`
// (commonJS), or an ordered `[{Name, Body}]` list in the process dictionary
// under `'__emilia_sheet'` (erlang: `lists:keystore` keeps the Map's
// insertion order, `erase` clears it).
//
// THE CELL IS A DUMB STRING STORE AND NOTHING ELSE. It used to assemble the
// `<style>` document itself, twice — once in the commonJS template and once in
// the Erlang one — which is where the byte-level divergence risk lived and
// which nothing written in botopink could test. `drainRules()` hands the raw
// payloads back instead and `output.bp` renders them, in one place, on both
// targets. Every ordering decision, every brace and the `<style>` element
// itself now live in `renderDocument`.
//
// `register(name, body)` writes (name -> body). `drainRules()` returns the
// entries as `name + "\t" + payload` records joined by `"\n"`, in insertion
// order, and clears the cell — the per-render contract the old `flushSheet`
// had: two consecutive drains give two independent documents, and the second
// registers nothing.
//
// A payload is an `encodeSheet` string, whose own records are ALSO joined by
// `"\n"`, so the drain stream layers two separators on one character. It stays
// unambiguous because a payload record is tagged `R` or `B` and a registered
// name never is; `output.bp`'s `drainStep` is where that is written down.
//
// `drainRules` returns `@Future<string>` — wrapped in `Promise.resolve(...)`
// so the public `flush()` surface is awaitable from any callsite (an SSR
// pipeline may chain it with `await renderToString(page)` symmetric to
// `await fetch(url)` from `std/http`). Tests support `await` via the
// implicit future context (`inferTestDecl`) + `async function` emission
// in `commonJS.emitTestFn`. The erlang backend's eager `@Future<T>` = `T`
// rule makes `await` an identity there.
//
// Both commonJS and erlang carry the cells; beam/wasm are not ported.
#[@External.node(when(argc == 2): """(function(__N, __B){ (globalThis.__emilia_sheet ||= new Map()).set(__N, __B); })($0, $1)""")]
#[@External.Erlang("""(fun(N__, B__) -> L__ = case get('__emilia_sheet') of undefined -> []; X__ -> X__ end, put('__emilia_sheet', lists:keystore(N__, 1, L__, {N__, B__})), ok end)($0, $1)""")]
declare fn register(name: string, body: string) -> void;

#[@future]
#[@External.node(when(argc == 0): """Promise.resolve((function(){ var __M = (globalThis.__emilia_sheet ||= new Map()); var __S = Array.from(__M.entries()).map(function(__E){ return __E[0] + "\t" + __E[1]; }).join("\n"); __M.clear(); return __S; })())""")]
#[@External.Erlang("""(fun() -> L__ = case erase('__emilia_sheet') of undefined -> []; X__ -> X__ end, iolist_to_binary(lists:join(<<"\n">>, [[K__, <<"\t">>, V__] || {K__, V__} <- L__])) end)()""")]
declare fn drainRules() -> @Future<string>;

// Content-derived class id. djb2-style fold over the body's UTF-16 code
// units, rendered as a lowercase hex string. Identical inputs → identical
// hex → identical class name (the acceptance gate `hash`). The erlang form
// folds the same djb2 over the codepoints masked to 32 bits, so both targets
// produce the same class name for ASCII rule bodies (astral characters are one
// codepoint in erlang, two UTF-16 units in JS).
//
// WHAT IS FOLDED CHANGED WITH FRONT 56, and contract 4 of the milestone takes
// the amendment. It used to be `tokensToCss(tokens)`; it is
// `encodeSheet(tokensToSheet(tokens, th))` now, because a `Sheet` is what a
// token list produces. Every property the contract rests on survives: still a
// pure function of its input, still ASCII-only, token order is still class
// identity. The one clause that changes is clause 1 — the hash is a pure
// function of the token list AND THE THEME, because a `md:` variant carries the
// theme's `--breakpoint-md` and a themed utility will carry more. The literal
// hex of any pinned fixture is regenerated once, here.
#[@External.node(when(argc == 1): """(function(__S){ var __H = 5381; for (var __I = 0; __I < __S.length; __I++) { __H = (Math.imul(__H, 33) + __S.charCodeAt(__I)) >>> 0; } return __H.toString(16); })($0)""")]
#[@External.Erlang("""(fun(S__) -> H__ = lists:foldl(fun(C__, A__) -> (A__ * 33 + C__) band 16#FFFFFFFF end, 5381, unicode:characters_to_list(S__)), list_to_binary(string:lowercase(integer_to_list(H__, 16))) end)($0)""")]
declare fn hashHex(s: string) -> string;

// ── public API ───────────────────────────────────────────────────

// Walk a `Token[]` under a theme → encode the `Sheet` it produces → register
// it under its content hash → return the assigned class name.
pub fn emiliaWith(tokens: Token[], th: Theme) -> string {
    val payload = encodeSheet(tokensToSheet(tokens, th));
    val name = "e_" + hashHex(payload);
    register(name, payload);
    return name;
}

// The single public emilia call, on the stock theme. The signature is the one
// it had before front 56, so no consumer changes.
pub fn emilia(tokens: Token[]) -> string {
    return emiliaWith(tokens, defaultTheme());
}

// Drain the cell and render the document under `o`. Per-render contract — two
// consecutive calls emit two independent documents; the second carries the
// theme and base layers `o` asks for and no `@layer utilities` body, because
// nothing registered in between.
//
// Async (`@Future<string>`) so the SSR caller can chain it with the other
// async pieces of a render pipeline (`await renderToString(page) + await
// flush()`). Tests resolve the future inline via the implicit `test {…}`
// future context.
#[@future]
pub fn flushWith(o: Options) -> @Future<string> {
    val raw = await drainRules();
    return renderDocument(raw, o);
}

// The stock render: emilia's default theme, no reset, no prefix, cascade
// layers on. The signature is the one it had before front 56.
#[@future]
pub fn flush() -> @Future<string> {
    return await flushWith(defaultOptions());
}

// ── the shared dispatcher ───────────────────────────────────────────

// Exhaustive dispatch over the V1 nested-section `Token` enum, and the ONE
// line each of fronts 33-47 owns. A section arm adapts its sub-dispatcher's
// declaration string with `declSheet(…)`; a modifier arm wraps the inner
// sheet in a `Variant`. A front whose tokens genuinely need a selector
// (`space-x-*`, `divide-*`) swaps its arm for `…TokenToSheet(_inner, th)` and
// says so in its own README: two shapes, one line each.
//
// THE THEME REACHES THIS DISPATCHER, NOT THE SUB-DISPATCHERS. The ten section
// sub-dispatchers keep their front 54 signature; the front that needs the
// theme adds the parameter to its own function and to its own line here. The
// spec of this front asks 56 to change all ten signatures at once, which would
// have front 56 editing ten functions three other fronts are rewriting in
// parallel for no gain — the arm is one line either way.
fn tokenToSheet(t: Token, th: Theme) -> Sheet {
    val out = case t {
        Text(_inner) -> declSheet(textTokenToCss(_inner));
        Font(_inner) -> declSheet(fontTokenToCss(_inner));
        Color(_inner) -> declSheet(colorTokenToCss(_inner));
        Bg(_inner) -> declSheet(bgTokenToCss(_inner));
        Pad(_inner) -> declSheet(padTokenToCss(_inner));
        Margin(_inner) -> declSheet(marginTokenToCss(_inner));
        Layout(_inner) -> declSheet(layoutTokenToCss(_inner));
        Flex(_inner) -> declSheet(flexTokenToCss(_inner));
        Border(_inner) -> declSheet(borderTokenToCss(_inner));
        Effect(_inner) -> declSheet(effectTokenToCss(_inner));
        Hover(inner) -> nestVariant(tokensToSheet(inner, th), hoverVariant());
        Focus(inner) -> nestVariant(tokensToSheet(inner, th), focusVariant());
        Active(inner) -> nestVariant(tokensToSheet(inner, th), activeVariant());
        Md(inner) -> nestVariant(tokensToSheet(inner, th), mdVariant(th));
        Lg(inner) -> nestVariant(tokensToSheet(inner, th), lgVariant(th));
        Xl(inner) -> nestVariant(tokensToSheet(inner, th), xlVariant(th));
    };
    return out;
}

// Fold a token list into one sheet. LIST ORDER IS PRESERVED, which is what
// makes token order class identity and what makes the last token setting a
// property the one that wins.
fn tokensToSheet(tokens: Token[], th: Theme) -> Sheet {
    return tokens.fold(emptySheet(), { acc, t -> mergeSheet(acc, tokenToSheet(t, th)) });
}

// ── the six V1 modifiers, as variants ───────────────────────────────────
//
// FRONT 34 OWNS THE VARIANT TABLE. These six are the modifiers the V1 `Token`
// enum already carries, written against the reference's variant table rather
// than against the literals they used to emit: `hover` is
// `@media (hover: hover) { &:hover }` and not a bare `:hover`, and a breakpoint
// is `@media (width >= 48rem)` and not `@media(min-width:768px)`. Front 34
// moves them into its own table and adds the other ninety.
//
// A breakpoint reads its width FROM THE THEME, so a project that overrides
// `--breakpoint-md` gets its own media query rather than emilia's — and so the
// theme is genuinely an input to the class hash, which is the clause of
// contract 4 this front amends.
pub fn hoverVariant() -> Variant {
    return Variant(atRule: "@media (hover: hover)", selector: "&:hover");
}

pub fn focusVariant() -> Variant {
    return Variant(atRule: "", selector: "&:focus");
}

pub fn activeVariant() -> Variant {
    return Variant(atRule: "", selector: "&:active");
}

fn breakpointVariant(th: Theme, name: string) -> Variant {
    return Variant(atRule: "@media (width >= " + themeValue(th, name) + ")", selector: "&");
}

pub fn mdVariant(th: Theme) -> Variant {
    return breakpointVariant(th, "--breakpoint-md");
}

pub fn lgVariant(th: Theme) -> Variant {
    return breakpointVariant(th, "--breakpoint-lg");
}

pub fn xlVariant(th: Theme) -> Variant {
    return breakpointVariant(th, "--breakpoint-xl");
}

//// ═══ END FRONT 56 — everything below is fronts 33-47, 57 and 58 ═════════

fn textTokenToCss(t: Token.Text) -> string {
    val out = case t {
        Bold -> "font-weight:bold";
        Italic -> "font-style:italic";
        Underline -> "text-decoration:underline";
        LineThrough -> "text-decoration:line-through";
        Left -> "text-align:left";
        Center -> "text-align:center";
        Right -> "text-align:right";
        Justify -> "text-align:justify";
        Size(_inner) -> textSizeToCss(_inner);
    };
    return out;
}

fn textSizeToCss(s: Token.Text.Size) -> string {
    val out = case s {
        Xs -> "font-size:0.75rem";
        Sm -> "font-size:0.875rem";
        Base -> "font-size:1rem";
        Lg -> "font-size:1.125rem";
        Xl -> "font-size:1.25rem";
        X2xl -> "font-size:1.5rem";
        X3xl -> "font-size:1.875rem";
        X4xl -> "font-size:2.25rem";
    };
    return out;
}

fn fontTokenToCss(t: Token.Font) -> string {
    val out = case t {
        Sans -> "font-family:ui-sans-serif,system-ui,sans-serif";
        Serif -> "font-family:ui-serif,Georgia,serif";
        Mono -> "font-family:ui-monospace,SFMono-Regular,Menlo,monospace";
        Weight(_inner) -> fontWeightToCss(_inner);
    };
    return out;
}

fn fontWeightToCss(w: Token.Font.Weight) -> string {
    val out = case w {
        Light -> "font-weight:300";
        Normal -> "font-weight:400";
        Medium -> "font-weight:500";
        Bold -> "font-weight:700";
        Black -> "font-weight:900";
    };
    return out;
}

fn colorTokenToCss(t: Token.Color) -> string {
    val out = case t {
        Red(_inner) -> "color:red";
        Blue(_inner) -> "color:blue";
        Green(_inner) -> "color:green";
        Gray(_inner) -> "color:gray";
        White -> "color:#ffffff";
        Black -> "color:#000000";
        Hex(value) -> "color:" + value;
    };
    return out;
}

fn bgTokenToCss(t: Token.Bg) -> string {
    val out = case t {
        Red(_inner) -> "background:red";
        Blue(_inner) -> "background:blue";
        Gray(_inner) -> "background:gray";
        White -> "background:#ffffff";
        Black -> "background:#000000";
        Hex(value) -> "background:" + value;
    };
    return out;
}

fn padTokenToCss(t: Token.Pad) -> string {
    val out = case t {
        X(_inner) -> "padding-x:" + padScaleX(_inner);
        Y(_inner) -> "padding-y:" + padScaleY(_inner);
        All(_inner) -> "padding:" + padScaleAll(_inner);
    };
    return out;
}

fn padScaleX(s: Token.Pad.X) -> string {
    val out = case s {
        __1 -> "0.25rem";
        __2 -> "0.5rem";
        __4 -> "1rem";
        __8 -> "2rem";
        __16 -> "4rem";
    };
    return out;
}

fn padScaleY(s: Token.Pad.Y) -> string {
    val out = case s {
        __1 -> "0.25rem";
        __2 -> "0.5rem";
        __4 -> "1rem";
        __8 -> "2rem";
    };
    return out;
}

fn padScaleAll(s: Token.Pad.All) -> string {
    val out = case s {
        __1 -> "0.25rem";
        __2 -> "0.5rem";
        __4 -> "1rem";
        __8 -> "2rem";
        __16 -> "4rem";
    };
    return out;
}

fn marginTokenToCss(t: Token.Margin) -> string {
    val out = case t {
        X(_inner) -> marginScaleX(_inner);
        Y(_inner) -> "margin-y:" + marginScaleY(_inner);
        All(_inner) -> "margin:" + marginScaleAll(_inner);
    };
    return out;
}

fn marginScaleX(s: Token.Margin.X) -> string {
    val out = case s {
        Auto -> "margin-auto";
        __1 -> "m-0.25";
        __2 -> "m-0.5";
        __4 -> "m-1";
        __8 -> "m-2";
    };
    return out;
}

fn marginScaleY(s: Token.Margin.Y) -> string {
    val out = case s {
        __1 -> "0.25rem";
        __2 -> "0.5rem";
        __4 -> "1rem";
        __8 -> "2rem";
    };
    return out;
}

fn marginScaleAll(s: Token.Margin.All) -> string {
    val out = case s {
        __1 -> "0.25rem";
        __2 -> "0.5rem";
        __4 -> "1rem";
        __8 -> "2rem";
    };
    return out;
}

fn layoutTokenToCss(t: Token.Layout) -> string {
    val out = case t {
        Block -> "display:block";
        InlineBlock -> "display:inline-block";
        Inline -> "display:inline";
        Hidden -> "display:none";
        Flex -> "display:flex";
        Grid -> "display:grid";
    };
    return out;
}

fn flexTokenToCss(t: Token.Flex) -> string {
    val out = case t {
        Row -> "flex-direction:row";
        Col -> "flex-direction:column";
        Wrap -> "flex-wrap:wrap";
        NoWrap -> "flex-wrap:nowrap";
        Items(_inner) -> flexItemsToCss(_inner);
        Justify(_inner) -> flexJustifyToCss(_inner);
        Gap(_inner) -> "gap:" + flexGapScale(_inner);
    };
    return out;
}

fn flexItemsToCss(p: Token.Flex.Items) -> string {
    val out = case p {
        Start -> "align-items:flex-start";
        Center -> "align-items:center";
        End -> "align-items:flex-end";
        Stretch -> "align-items:stretch";
    };
    return out;
}

fn flexJustifyToCss(p: Token.Flex.Justify) -> string {
    val out = case p {
        Start -> "justify-content:flex-start";
        Center -> "justify-content:center";
        End -> "justify-content:flex-end";
        Between -> "justify-content:space-between";
        Around -> "justify-content:space-around";
    };
    return out;
}

fn flexGapScale(s: Token.Flex.Gap) -> string {
    val out = case s {
        __1 -> "0.25rem";
        __2 -> "0.5rem";
        __4 -> "1rem";
        __8 -> "2rem";
    };
    return out;
}

fn borderTokenToCss(t: Token.Border) -> string {
    val out = case t {
        W(_inner) -> borderWidthToCss(_inner);
        Color(_inner) -> borderColorToCss(_inner);
        Rounded(_inner) -> borderRoundedToCss(_inner);
    };
    return out;
}

fn borderWidthToCss(s: Token.Border.W) -> string {
    val out = case s {
        __0 -> "border-width:0";
        __1 -> "border-width:1px";
        __2 -> "border-width:2px";
        __4 -> "border-width:4px";
    };
    return out;
}

fn borderColorToCss(c: Token.Border.Color) -> string {
    val out = case c {
        Red(_inner) -> "border-color:red";
        Gray(_inner) -> "border-color:gray";
        Hex(value) -> "border-color:" + value;
    };
    return out;
}

fn borderRoundedToCss(r: Token.Border.Rounded) -> string {
    val out = case r {
        Sm -> "border-radius:0.125rem";
        Md -> "border-radius:0.375rem";
        Lg -> "border-radius:0.5rem";
        Full -> "border-radius:9999px";
    };
    return out;
}

fn effectTokenToCss(t: Token.Effect) -> string {
    val out = case t {
        Shadow(_inner) -> shadowToCss(_inner);
        Opacity(_inner) -> opacityToCss(_inner);
    };
    return out;
}

fn shadowToCss(s: Token.Effect.Shadow) -> string {
    val out = case s {
        Sm -> "box-shadow:sm";
        Md -> "box-shadow:md";
        Lg -> "box-shadow:lg";
        Xl -> "box-shadow:xl";
    };
    return out;
}

fn opacityToCss(o: Token.Effect.Opacity) -> string {
    val out = case o {
        __0 -> "opacity:0";
        __25 -> "opacity:0.25";
        __50 -> "opacity:0.5";
        __75 -> "opacity:0.75";
        __100 -> "opacity:1";
    };
    return out;
}

fn redPaletteHex(s: Token.Color.Red) -> string {
    val out = case s {
        __100 -> "#fee2e2";
        __200 -> "#fecaca";
        __300 -> "#fca5a5";
        __400 -> "#f87171";
        __500 -> "#ef4444";
        __600 -> "#dc2626";
        __700 -> "#b91c1c";
        __800 -> "#991b1b";
        __900 -> "#7f1d1d";
    };
    return out;
}

// ── front 56 · test helpers ───────────────────────────────────────────

// A document with no theme in it, so a cascade assertion reads as the rules
// the test registered rather than as the stock theme's hundred variables.
fn bareOptions() -> Options {
    return withTheme(defaultOptions(), emptyTheme());
}

fn firstRuleOf(s: Sheet) -> Rule {
    val none: string[] = [];
    val fallback = Rule(layer: "", atRules: none, selector: "", declarations: "", important: false);
    val out = s.rules.at(0) ?? fallback;
    return out;
}

// What one token declares, ignoring where it declares it. The seven leaf tests
// below read this; anything about a selector or an at-rule reads the rule.
fn tokenDeclarations(t: Token) -> string {
    return declarationsOf(tokenToSheet(t, defaultTheme())).join(";");
}

// ── tests · the leaf dispatchers ────────────────────────────────────────
// V1 enum-section dispatch smoke, unchanged in substance by front 56: a
// section sub-dispatcher still answers a declaration string, and these pin
// that. What changed is that the string reaches the document through a `Rule`.

test "tokenToSheet — Text.Bold lowers to font-weight:bold" {
    assert tokenDeclarations(.Text.Bold) == "font-weight:bold";
}

test "tokenToSheet — Text.Size.Lg lowers to font-size:1.125rem" {
    assert tokenDeclarations(.Text.Size.Lg) == "font-size:1.125rem";
}

test "tokenToSheet — Color.Black lowers to color:#000000" {
    assert tokenDeclarations(.Color.Black) == "color:#000000";
}

test "tokenToSheet — Bg.White lowers to background:#ffffff" {
    assert tokenDeclarations(.Bg.White) == "background:#ffffff";
}

test "tokenToSheet — Layout.Flex lowers to display:flex" {
    assert tokenDeclarations(.Layout.Flex) == "display:flex";
}

test "tokenToSheet — Border.Rounded.Full lowers to border-radius:9999px" {
    assert tokenDeclarations(.Border.Rounded.Full) == "border-radius:9999px";
}

test "tokenToSheet — Effect.Shadow.Md lowers to box-shadow:md" {
    assert tokenDeclarations(.Effect.Shadow.Md) == "box-shadow:md";
}

test "tokenToSheet — a section token is one utilities rule on the bare ampersand" {
    val r = firstRuleOf(tokenToSheet(.Text.Bold, defaultTheme()));
    assert r.layer == "utilities";
    assert r.selector == "&";
    assert r.atRules.length == 0;
    assert r.important == false;
}

// ── tests · the six modifiers, against the variant reference ────────────────
//
// Every expected selector below names the row of the reference's variant table
// it comes from. These six assertions used to read `":hover{…}"` and
// `"@media(min-width:768px){…}"`, both of which the table contradicts; front 56
// owns the break.

test "Hover — the `hover` row is `@media (hover: hover) { &:hover }`, not a bare :hover" {
    val inner: Token[] = [.Color.Black];
    val r = firstRuleOf(tokenToSheet(Token.Hover(inner), defaultTheme()));
    assert r.selector == "&:hover";
    assert r.atRules.join("|") == "@media (hover: hover)";
    assert r.declarations == "color:#000000";
}

test "Focus and Active — the `focus` and `active` rows are selector-only" {
    val inner: Token[] = [.Text.Bold];
    val f = firstRuleOf(tokenToSheet(Token.Focus(inner), defaultTheme()));
    assert f.selector == "&:focus";
    assert f.atRules.length == 0;
    val a = firstRuleOf(tokenToSheet(Token.Active(inner), defaultTheme()));
    assert a.selector == "&:active";
    assert a.atRules.length == 0;
}

test "Md, Lg and Xl — the breakpoint rows are `@media (width >= <n>rem)`, read from the theme" {
    val inner: Token[] = [.Text.Bold];
    assert firstRuleOf(tokenToSheet(Token.Md(inner), defaultTheme())).atRules.join("|") == "@media (width >= 48rem)";
    assert firstRuleOf(tokenToSheet(Token.Lg(inner), defaultTheme())).atRules.join("|") == "@media (width >= 64rem)";
    assert firstRuleOf(tokenToSheet(Token.Xl(inner), defaultTheme())).atRules.join("|") == "@media (width >= 80rem)";
    assert firstRuleOf(tokenToSheet(Token.Md(inner), defaultTheme())).selector == "&";
}

test "tokensToSheet — a multi-token list is one rule per token, in order" {
    val list: Token[] = [.Text.Bold, .Color.Black];
    val s = tokensToSheet(list, defaultTheme());
    assert s.rules.length == 2;
    assert declarationsOf(s).join(";") == "font-weight:bold;color:#000000";
}

test "nested modifiers — the outer modifier is outermost, in both halves" {
    val deepest: Token[] = [.Text.Bold];
    val mid: Token[] = [Token.Md(deepest)];
    val r = firstRuleOf(tokenToSheet(Token.Hover(mid), defaultTheme()));
    assert r.selector == "&:hover";
    assert r.atRules.join("|") == "@media (hover: hover)|@media (width >= 48rem)";
}

test "a breakpoint follows the theme, so the theme is an input to the class hash" {
    val wide: ThemeEntry[] = [ThemeEntry(name: "--breakpoint-md", value: "50rem")];
    val th = extendTheme(defaultTheme(), wide);
    val inner: Token[] = [.Text.Bold];
    assert firstRuleOf(tokenToSheet(Token.Md(inner), th)).atRules.join("|") == "@media (width >= 50rem)";
    val tokens: Token[] = [Token.Md(inner)];
    assert emiliaWith(tokens, th) != emiliaWith(tokens, defaultTheme());
    val _drop = await flush();
}

// ── tests · the codec assumption, over the dispatcher's own output ──────────

fn everySectionToken() -> Token[] {
    val hoverInner: Token[] = [.Color.Black];
    val mdInner: Token[] = [.Text.Bold];
    val out: Token[] = [
        .Text.Bold,
        .Text.Size.Lg,
        .Font.Sans,
        .Font.Weight.Bold,
        .Color.Black,
        .Bg.White,
        .Pad.All.__4,
        .Margin.Y.__2,
        .Layout.Flex,
        .Flex.Gap.__4,
        .Border.Rounded.Full,
        .Effect.Shadow.Md,
        Token.Hover(hoverInner),
        Token.Md(mdInner),
    ];
    return out;
}

test "codec — no declaration any dispatcher produces carries a codec separator" {
    val s = tokensToSheet(everySectionToken(), defaultTheme());
    assert s.rules.length == 14;
    assert declarationsOf(s).any({ d -> carriesSeparator(d) }) == false;
    assert s.rules.any({ r -> carriesSeparator(r.selector) }) == false;
    assert s.rules.any({ r -> carriesSeparator(r.atRules.join("")) }) == false;
}

test "codec — a full dispatcher sheet round-trips through the cell encoding" {
    val s = tokensToSheet(everySectionToken(), defaultTheme());
    val raw = encodeSheet(s);
    assert encodeSheet(decodeSheet(raw)) == raw;
    assert decodeSheet(raw).rules.length == 14;
}

// ── tests · the host cell and the drain ────────────────────────────────
//
// The two templates are written twice, once per target, and the whole point of
// moving assembly out of them is that the divergence became testable: every
// assertion here runs on `--target commonJS` and on `--target erlang`, and a
// drain that is green on one only means the other is wrong.

test "drainRules — nothing registered drains to the empty string" {
    val raw = await drainRules();
    assert raw == "";
}

test "drainRules — the payloads come back verbatim, in insertion order" {
    register("e_a", "P1");
    register("e_b", "P2");
    val raw = await drainRules();
    assert raw == "e_a\tP1\ne_b\tP2";
}

test "drainRules — a drain clears the cell, so the second of two is empty" {
    register("e_a", "P1");
    val first = await drainRules();
    val second = await drainRules();
    assert first == "e_a\tP1";
    assert second == "";
}

test "drainRules — re-registering a name keeps its position and replaces its payload" {
    register("e_a", "P1");
    register("e_b", "P2");
    register("e_a", "P3");
    val raw = await drainRules();
    assert raw == "e_a\tP3\ne_b\tP2";
}

test "drainRules — the cell assembles nothing: no `<style>`, no brace, in what it hands back" {
    val tokens: Token[] = [.Bg.Black];
    val _cls = emilia(tokens);
    val raw = await drainRules();
    assert raw.indexOf("<") == -1;
    assert raw.indexOf("{") == -1;
    assert raw.indexOf("}") == -1;
}

// ── tests · the public surface ──────────────────────────────────────

test "emilia of an empty token list is a stable class that contributes no rule" {
    val empty: Token[] = [];
    val a = emilia(empty);
    val b = emilia(empty);
    assert a == b;
    assert a.startsWith("e_");
    val styles = await flushWith(bareOptions());
    assert styles == "<style>@layer theme, base, components, utilities;</style>";
}

test "emilia of one text token produces a single-declaration rule" {
    val tokens: Token[] = [.Text.Bold];
    val cls = emilia(tokens);
    val styles = await flushWith(bareOptions());
    assert styles == "<style>@layer theme, base, components, utilities;@layer utilities{." + cls + "{font-weight:bold}}</style>";
}

test "emilia of mixed tokens folds one class into one rule" {
    val tokens: Token[] = [.Bg.White, .Text.Size.Lg];
    val cls = emilia(tokens);
    val styles = await flushWith(bareOptions());
    assert styles == "<style>@layer theme, base, components, utilities;@layer utilities{." + cls + "{background:#ffffff;font-size:1.125rem}}</style>";
}

test "two emilia sites with the same token list collapse to one class" {
    val tokens: Token[] = [.Bg.White];
    val a = emilia(tokens);
    val b = emilia(tokens);
    assert a == b;
    val styles = await flushWith(bareOptions());
    assert styles == "<style>@layer theme, base, components, utilities;@layer utilities{." + a + "{background:#ffffff}}</style>";
}

// Hex(value) payload variant inside a nested section can't be constructed
// inline via the current dot-shorthand grammar (`[.Color.Hex("#abc")]`
// trips the parser — the dot-chain + payload-call combination doesn't
// propagate the typed-array context inside the array literal). Until the
// shorthand for that shape lands, callers wrap the call in a fn or use
// the typed `val` intermediate. Tracked as part of `enum-sections` tail.

test "a modifier is a SIBLING rule now, not a block nested inside the class" {
    val inner: Token[] = [.Bg.White, .Text.Bold];
    val tokens: Token[] = [.Bg.Black, Token.Hover(inner)];
    val cls = emilia(tokens);
    val styles = await flushWith(bareOptions());
    assert styles == "<style>@layer theme, base, components, utilities;@layer utilities{."
        + cls + "{background:#000000}@media (hover: hover){." + cls
        + ":hover{background:#ffffff;font-weight:bold}}}</style>";
}

test "two consecutive flushes emit two independent documents" {
    val first: Token[] = [.Text.Bold];
    val _a = emilia(first);
    val s1 = await flushWith(bareOptions());
    val s2 = await flushWith(bareOptions());
    assert s1.indexOf("@layer utilities{") != -1;
    assert s2 == "<style>@layer theme, base, components, utilities;</style>";
}

test "flush — the stock render carries the theme layer and the stock keyframes" {
    val tokens: Token[] = [.Text.Bold];
    val cls = emilia(tokens);
    val styles = await flush();
    assert styles.startsWith("<style>@layer theme, base, components, utilities;@layer theme{:root{--spacing:0.25rem;");
    assert styles.indexOf("@layer utilities{." + cls + "{font-weight:bold}}") != -1;
    assert styles.endsWith("@keyframes bounce{0%,100%{transform:translateY(-25%);animation-timing-function:cubic-bezier(0.8,0,1,1)}50%{transform:none;animation-timing-function:cubic-bezier(0,0,0.2,1)}}</style>");
}

// ── tests · the conflict rule ───────────────────────────────────────
//
// The reference's conflict section: the LAST rule in the stylesheet wins, and
// its own worked example is `class="grid flex"` resolving to `display:flex`.
// Inside one `emilia()` call that is the token list order; across calls it is
// registration order. Before front 56 nothing said either.

test "conflict — `grid flex` renders in list order, so the last one wins" {
    val tokens: Token[] = [.Layout.Grid, .Layout.Flex];
    val cls = emilia(tokens);
    val styles = await flushWith(bareOptions());
    assert styles == "<style>@layer theme, base, components, utilities;@layer utilities{." + cls + "{display:grid;display:flex}}</style>";
}

test "conflict — reversing the list reverses the winner, and is a different class" {
    val a: Token[] = [.Layout.Grid, .Layout.Flex];
    val b: Token[] = [.Layout.Flex, .Layout.Grid];
    val clsA = emiliaWith(a, defaultTheme());
    val clsB = emiliaWith(b, defaultTheme());
    assert clsA != clsB;
    val styles = await flushWith(bareOptions());
    assert styles.indexOf("." + clsA + "{display:grid;display:flex}") != -1;
    assert styles.indexOf("." + clsB + "{display:flex;display:grid}") != -1;
}

test "conflict — two emilia calls setting the same property render in CALL order" {
    val first: Token[] = [.Layout.Grid];
    val second: Token[] = [.Layout.Flex];
    val clsA = emilia(first);
    val clsB = emilia(second);
    val styles = await flushWith(bareOptions());
    assert styles.indexOf("." + clsA + "{display:grid}") < styles.indexOf("." + clsB + "{display:flex}");
}

test "conflict — reordering an unrelated token moves no other rule" {
    val one: Token[] = [.Text.Bold, .Layout.Flex, .Color.Black];
    val two: Token[] = [.Layout.Flex, .Text.Bold, .Color.Black];
    val clsA = emilia(one);
    val clsB = emilia(two);
    val styles = await flushWith(bareOptions());
    assert styles.indexOf("." + clsA + "{font-weight:bold;display:flex;color:#000000}") != -1;
    assert styles.indexOf("." + clsB + "{display:flex;font-weight:bold;color:#000000}") != -1;
    assert styles.indexOf("." + clsA) < styles.indexOf("." + clsB);
}

test "conflict — a variant of a rule follows the rule it varies" {
    val inner: Token[] = [.Layout.Grid];
    val tokens: Token[] = [Token.Md(inner), .Layout.Flex];
    val cls = emilia(tokens);
    val styles = await flushWith(bareOptions());
    assert styles == "<style>@layer theme, base, components, utilities;@layer utilities{."
        + cls + "{display:flex}@media (width >= 48rem){." + cls + "{display:grid}}}</style>";
}

