// ── tests · the family and shade grid ────────────────────────────────────────
//
// One test per family: 26 tests and 280 assertions, which is every cell of the
// grid but the six the note above records. Target-independent — emilia has no
// target split, so every assert below runs under `botopink test` and under
// `botopink test --target erlang`, and a colour that differs between the two
// is a defect rather than a backend detail.

test "paletteVar — two plain strings, and the `--color-` prefix spelled once" {
    assert paletteVar("red", "500") == "var(--color-red-500)";
    assert paletteVar("taupe", "950") == "var(--color-taupe-950)";
    assert paletteVar("red", "500") == themeVar(nsPrefix(Ns.Color) + "red-500");
}

test "the shade survives — two shades of one family are no longer the same CSS" {
    assert tokenDeclarations(.Color.Red.50) != tokenDeclarations(.Color.Red.950);
    assert tokenDeclarations(.Color.Red.50) == "color:var(--color-red-50)";
    assert tokenDeclarations(.Color.Red.950) == "color:var(--color-red-950)";
    assert tokenDeclarations(.Color.Blue.200) != tokenDeclarations(.Color.Blue.800);
}

test "the five named colours on `color`" {
    assert tokenDeclarations(.Color.White) == "color:var(--color-white)";
    assert tokenDeclarations(.Color.Black) == "color:var(--color-black)";
    assert tokenDeclarations(.Color.Transparent) == "color:transparent";
    assert tokenDeclarations(.Color.Current) == "color:currentColor";
    assert tokenDeclarations(.Color.Inherit) == "color:inherit";
}

test "the paths that compiled before this front still compile, with a shade in them" {
    assert tokenDeclarations(.Color.Blue.700) == "color:var(--color-blue-700)";
    assert tokenDeclarations(.Color.Gray.400) == "color:var(--color-gray-400)";
    assert tokenDeclarations(.Color.Green.400) == "color:var(--color-green-400)";
    assert tokenDeclarations(.Color.Green.900) == "color:var(--color-green-900)";
}

test "a colour token still renders as one utilities rule on the bare ampersand" {
    val r = firstRuleOf(tokenToSheet(.Color.Sky.500, defaultTheme()));
    assert r.layer == "utilities";
    assert r.selector == "&";
    assert r.declarations == "color:var(--color-sky-500)";
}

// red: 100, 500, 700 are DECLARED and unreachable — no spelling resolves them
// while `Token.Border.Color.Red` carries the same leaves. See the
// BLOCKED note above.
test "palette — red, eight shades on `color`" {
    assert tokenDeclarations(.Color.Red.50) == "color:var(--color-red-50)";
    assert tokenDeclarations(.Color.Red.200) == "color:var(--color-red-200)";
    assert tokenDeclarations(.Color.Red.300) == "color:var(--color-red-300)";
    assert tokenDeclarations(.Color.Red.400) == "color:var(--color-red-400)";
    assert tokenDeclarations(.Color.Red.600) == "color:var(--color-red-600)";
    assert tokenDeclarations(.Color.Red.800) == "color:var(--color-red-800)";
    assert tokenDeclarations(.Color.Red.900) == "color:var(--color-red-900)";
    assert tokenDeclarations(.Color.Red.950) == "color:var(--color-red-950)";
}

