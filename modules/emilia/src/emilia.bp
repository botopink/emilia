// ── the `Bg.Color` sub-section · the `bg-*` colours ──────────────────────────
//
// The same grid, one property along. `fronts.md` assigns `Bg.Color` to this
// front and the rest of `Bg` — gradients, images, attachment, position — to
// front 39, so the sub-section is where the colour half lives and the legacy
// `Bg.Red` / `Bg.Blue` / `Bg.Gray` leaves stay untouched beside it.
//
// The property is `background-color` and not `background`: upstream's `bg-*`
// colour utilities set the longhand (`§ 10.3`), and the shorthand the V1 stub
// emitted resets every other background property of the element as a side
// effect. `.Bg.White` keeps emitting `background:#ffffff`, because that path
// compiles today and this front does not change what a compiling path means.
//
// `.Bg.Color.<Family>.<shade>` also reaches the six shades `.Color.<Family>`
// cannot — `Bg` is a head segment no other enum in the program carries.

fn bgColorTokenToCss(c: Token.Bg.Color, th: Theme) -> string {
    val out = case c {
        Red(_inner) -> "background-color:" + paletteVar("red", bgColorRedShade(_inner));
        Orange(_inner) -> "background-color:" + paletteVar("orange", bgColorOrangeShade(_inner));
        Amber(_inner) -> "background-color:" + paletteVar("amber", bgColorAmberShade(_inner));
        Yellow(_inner) -> "background-color:" + paletteVar("yellow", bgColorYellowShade(_inner));
        Lime(_inner) -> "background-color:" + paletteVar("lime", bgColorLimeShade(_inner));
        Green(_inner) -> "background-color:" + paletteVar("green", bgColorGreenShade(_inner));
        Emerald(_inner) -> "background-color:" + paletteVar("emerald", bgColorEmeraldShade(_inner));
        Teal(_inner) -> "background-color:" + paletteVar("teal", bgColorTealShade(_inner));
        Cyan(_inner) -> "background-color:" + paletteVar("cyan", bgColorCyanShade(_inner));
        Sky(_inner) -> "background-color:" + paletteVar("sky", bgColorSkyShade(_inner));
        Blue(_inner) -> "background-color:" + paletteVar("blue", bgColorBlueShade(_inner));
        Indigo(_inner) -> "background-color:" + paletteVar("indigo", bgColorIndigoShade(_inner));
        Violet(_inner) -> "background-color:" + paletteVar("violet", bgColorVioletShade(_inner));
        Purple(_inner) -> "background-color:" + paletteVar("purple", bgColorPurpleShade(_inner));
        Fuchsia(_inner) -> "background-color:" + paletteVar("fuchsia", bgColorFuchsiaShade(_inner));
        Pink(_inner) -> "background-color:" + paletteVar("pink", bgColorPinkShade(_inner));
        Rose(_inner) -> "background-color:" + paletteVar("rose", bgColorRoseShade(_inner));
        Slate(_inner) -> "background-color:" + paletteVar("slate", bgColorSlateShade(_inner));
        Gray(_inner) -> "background-color:" + paletteVar("gray", bgColorGrayShade(_inner));
        Zinc(_inner) -> "background-color:" + paletteVar("zinc", bgColorZincShade(_inner));
        Neutral(_inner) -> "background-color:" + paletteVar("neutral", bgColorNeutralShade(_inner));
        Stone(_inner) -> "background-color:" + paletteVar("stone", bgColorStoneShade(_inner));
        Mauve(_inner) -> "background-color:" + paletteVar("mauve", bgColorMauveShade(_inner));
        Olive(_inner) -> "background-color:" + paletteVar("olive", bgColorOliveShade(_inner));
        Mist(_inner) -> "background-color:" + paletteVar("mist", bgColorMistShade(_inner));
        Taupe(_inner) -> "background-color:" + paletteVar("taupe", bgColorTaupeShade(_inner));
        White -> "background-color:" + themeVar(nsPrefix(Ns.Color) + "white");
        Black -> "background-color:" + themeVar(nsPrefix(Ns.Color) + "black");
        Transparent -> "background-color:transparent";
        Current -> "background-color:currentColor";
        Inherit -> "background-color:inherit";
    };
    return out;
}


fn bgColorRedShade(s: Token.Bg.Color.Red) -> string {
    val out = case s {
        __50 -> "50"; __100 -> "100"; __200 -> "200"; __300 -> "300";
        __400 -> "400"; __500 -> "500"; __600 -> "600"; __700 -> "700";
        __800 -> "800"; __900 -> "900"; __950 -> "950";
    };
    return out;
}

