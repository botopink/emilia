// ── tests · the `Bg.Color` mirror ────────────────────────────────────────────
//
// The same 26 tests, eleven asserts each: 286 assertions and no gap, because
// the four-segment path has no competitor to lose a hash-order tie to.

test "the five named colours on `background-color`" {
    assert tokenDeclarations(.Bg.Color.White) == "background-color:var(--color-white)";
    assert tokenDeclarations(.Bg.Color.Black) == "background-color:var(--color-black)";
    assert tokenDeclarations(.Bg.Color.Transparent) == "background-color:transparent";
    assert tokenDeclarations(.Bg.Color.Current) == "background-color:currentColor";
    assert tokenDeclarations(.Bg.Color.Inherit) == "background-color:inherit";
}

test "the legacy Bg leaves keep the shorthand and the output they had" {
    assert tokenDeclarations(.Bg.White) == "background:#ffffff";
    assert tokenDeclarations(.Bg.Black) == "background:#000000";
    assert tokenDeclarations(.Bg.Red.500) == "background:red";
    assert tokenDeclarations(.Bg.Blue.500) == "background:blue";
    assert tokenDeclarations(.Bg.Gray.500) == "background:gray";
}

test "the sub-section emits the longhand the shorthand was hiding" {
    assert tokenDeclarations(.Bg.Color.Red.500) == "background-color:var(--color-red-500)";
    assert tokenDeclarations(.Bg.White).startsWith("background:");
    assert tokenDeclarations(.Bg.Color.White).startsWith("background-color:");
}

test "the four-segment path reaches the six shades `.Color` cannot" {
    assert tokenDeclarations(.Bg.Color.Red.100) == "background-color:var(--color-red-100)";
    assert tokenDeclarations(.Bg.Color.Red.500) == "background-color:var(--color-red-500)";
    assert tokenDeclarations(.Bg.Color.Red.700) == "background-color:var(--color-red-700)";
    assert tokenDeclarations(.Bg.Color.Gray.100) == "background-color:var(--color-gray-100)";
    assert tokenDeclarations(.Bg.Color.Gray.500) == "background-color:var(--color-gray-500)";
    assert tokenDeclarations(.Bg.Color.Gray.700) == "background-color:var(--color-gray-700)";
}

