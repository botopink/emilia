    assert tokenDeclarations(.Bg.Color.Mist.400) == "background-color:var(--color-mist-400)";
    assert tokenDeclarations(.Bg.Color.Mist.500) == "background-color:var(--color-mist-500)";
    assert tokenDeclarations(.Bg.Color.Mist.600) == "background-color:var(--color-mist-600)";
    assert tokenDeclarations(.Bg.Color.Mist.700) == "background-color:var(--color-mist-700)";
    assert tokenDeclarations(.Bg.Color.Mist.800) == "background-color:var(--color-mist-800)";
    assert tokenDeclarations(.Bg.Color.Mist.900) == "background-color:var(--color-mist-900)";
    assert tokenDeclarations(.Bg.Color.Mist.950) == "background-color:var(--color-mist-950)";
}

test "palette — taupe, eleven shades on `background-color`" {
    assert tokenDeclarations(.Bg.Color.Taupe.50) == "background-color:var(--color-taupe-50)";
    assert tokenDeclarations(.Bg.Color.Taupe.100) == "background-color:var(--color-taupe-100)";
    assert tokenDeclarations(.Bg.Color.Taupe.200) == "background-color:var(--color-taupe-200)";
    assert tokenDeclarations(.Bg.Color.Taupe.300) == "background-color:var(--color-taupe-300)";
    assert tokenDeclarations(.Bg.Color.Taupe.400) == "background-color:var(--color-taupe-400)";
    assert tokenDeclarations(.Bg.Color.Taupe.500) == "background-color:var(--color-taupe-500)";
    assert tokenDeclarations(.Bg.Color.Taupe.600) == "background-color:var(--color-taupe-600)";
    assert tokenDeclarations(.Bg.Color.Taupe.700) == "background-color:var(--color-taupe-700)";
    assert tokenDeclarations(.Bg.Color.Taupe.800) == "background-color:var(--color-taupe-800)";
    assert tokenDeclarations(.Bg.Color.Taupe.900) == "background-color:var(--color-taupe-900)";
    assert tokenDeclarations(.Bg.Color.Taupe.950) == "background-color:var(--color-taupe-950)";
}
