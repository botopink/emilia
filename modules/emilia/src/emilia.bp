fn everySpacingCss() -> string {
    return declarationsOf(tokensToSheet(everySpacingToken(), defaultTheme())).join(";");
}

test "the walk is complete — one rule per leaf, and none of them is empty" {
    val s = tokensToSheet(everySpacingToken(), defaultTheme());
    assert s.rules.length == 1074;
    assert declarationsOf(s).any({ d -> d == "" }) == false;
}

test "no spacing token emits a property name that is not a CSS property" {
    val css = everySpacingCss();
    assert css.indexOf("padding-x") == -1;
    assert css.indexOf("padding-y") == -1;
    assert css.indexOf("margin-x") == -1;
    assert css.indexOf("margin-y") == -1;
}

test "no spacing token emits a Tailwind class fragment" {
    val css = everySpacingCss();
    assert css.indexOf("m-0.25") == -1;
    assert css.indexOf("m-0.5") == -1;
    assert css.indexOf("m-1") == -1;
    assert css.indexOf("m-2") == -1;
    assert css.indexOf("margin-auto") == -1;
}

test "no spacing token resolves a length — every value is a reference, `auto` or the pixel step" {
    val css = everySpacingCss();
    assert css.indexOf("rem") == -1;
    assert css.indexOf("calc(var(--spacing) * ") != -1;
}

test "the paths that compiled before this front still compile" {
    assert tokenDeclarations(.Pad.X.4).indexOf("padding-left") == 0;
    assert tokenDeclarations(.Pad.All.16).indexOf("padding:") == 0;
    assert tokenDeclarations(.Margin.Y.8).indexOf("margin-top") == 0;
    assert tokenDeclarations(.Margin.X.Auto).indexOf("margin-left:auto") == 0;
}

test "Size — the numeric leaf is the spacing ladder again, on any axis" {
    assert tokenDeclarations(.Size.W.0) == "width:0";
    assert tokenDeclarations(.Size.W.1) == "width:calc(var(--spacing) * 1)";
    assert tokenDeclarations(.Size.W.64) == "width:calc(var(--spacing) * 64)";
    assert tokenDeclarations(.Size.W.Px) == "width:1px";
    assert tokenDeclarations(.Size.H.0) == "height:0";
    assert tokenDeclarations(.Size.H.1) == "height:calc(var(--spacing) * 1)";
}

test "Size — the viewport unit differs by axis, and both halves are pinned" {
    assert tokenDeclarations(.Size.W.Screen) == "width:100vw";
    assert tokenDeclarations(.Size.H.Screen) == "height:100vh";
    assert tokenDeclarations(.Size.W.Svw) == "width:100svw";
    assert tokenDeclarations(.Size.W.Lvw) == "width:100lvw";
    assert tokenDeclarations(.Size.W.Dvw) == "width:100dvw";
    assert tokenDeclarations(.Size.H.Svh) == "height:100svh";
    assert tokenDeclarations(.Size.H.Lvh) == "height:100lvh";
    assert tokenDeclarations(.Size.H.Dvh) == "height:100dvh";
    assert tokenDeclarations(.Size.MinH.Screen) == "min-height:100vh";
    assert tokenDeclarations(.Size.MaxH.Screen) == "max-height:100vh";
}

test "Size — intrinsic sizes, `auto`, `none` and `full`" {
    assert tokenDeclarations(.Size.W.Full) == "width:100%";
    assert tokenDeclarations(.Size.H.Full) == "height:100%";
    assert tokenDeclarations(.Size.W.Min) == "width:min-content";
    assert tokenDeclarations(.Size.W.Max) == "width:max-content";
    assert tokenDeclarations(.Size.W.Fit) == "width:fit-content";
    assert tokenDeclarations(.Size.W.Auto) == "width:auto";
    assert tokenDeclarations(.Size.H.Auto) == "height:auto";
    assert tokenDeclarations(.Size.MinW.0) == "min-width:0";
    assert tokenDeclarations(.Size.MinW.Full) == "min-width:100%";
    assert tokenDeclarations(.Size.MinW.Min) == "min-width:min-content";
    assert tokenDeclarations(.Size.MinW.Max) == "min-width:max-content";
    assert tokenDeclarations(.Size.MinW.Fit) == "min-width:fit-content";
    assert tokenDeclarations(.Size.MaxW.None) == "max-width:none";
    assert tokenDeclarations(.Size.MaxH.None) == "max-height:none";
    assert tokenDeclarations(.Size.MinH.Fit) == "min-height:fit-content";
    assert tokenDeclarations(.Size.MaxH.Full) == "max-height:100%";
}

// `1/2` is neither an identifier nor a digit run, so a fraction cannot be a
// leaf: `Frac` carries the eleven upstream fractions by name. The six-decimal
// forms are the ones `§ 8.1` prints.
test "Size — the eleven fractions, to the decimal place upstream prints" {
    assert tokenDeclarations(.Size.W.Frac.Half) == "width:50%";
    assert tokenDeclarations(.Size.W.Frac.Third) == "width:33.333333%";
    assert tokenDeclarations(.Size.W.Frac.TwoThirds) == "width:66.666667%";
    assert tokenDeclarations(.Size.W.Frac.Quarter) == "width:25%";
    assert tokenDeclarations(.Size.W.Frac.ThreeQuarters) == "width:75%";
    assert tokenDeclarations(.Size.W.Frac.Fifth) == "width:20%";
    assert tokenDeclarations(.Size.W.Frac.TwoFifths) == "width:40%";
    assert tokenDeclarations(.Size.W.Frac.ThreeFifths) == "width:60%";
    assert tokenDeclarations(.Size.W.Frac.FourFifths) == "width:80%";
    assert tokenDeclarations(.Size.W.Frac.Sixth) == "width:16.666667%";
    assert tokenDeclarations(.Size.W.Frac.FiveSixths) == "width:83.333333%";
    assert tokenDeclarations(.Size.H.Frac.Half) == "height:50%";
}

// `max-w-md` is `max-width:var(--container-md)` upstream and here. The `rem`
// behind each name is the THEME's, written once in `theme.bp`, so a project
// that redefines `--container-md` moves every `max-w-md` in the build — which
// a literal ladder in this file would have made impossible. The second half of
// each assertion reads the value back through the theme, so the reference and
// the length `§ 8.3` prints are both pinned.
test "Size — the named container widths are theme references, not lengths" {
    assert tokenDeclarations(.Size.MaxW.X3xs) == "max-width:var(--container-3xs)";
    assert tokenDeclarations(.Size.MaxW.X2xs) == "max-width:var(--container-2xs)";
    assert tokenDeclarations(.Size.MaxW.Xs) == "max-width:var(--container-xs)";
    assert tokenDeclarations(.Size.MaxW.Sm) == "max-width:var(--container-sm)";
    assert tokenDeclarations(.Size.MaxW.Md) == "max-width:var(--container-md)";
    assert tokenDeclarations(.Size.MaxW.Lg) == "max-width:var(--container-lg)";
    assert tokenDeclarations(.Size.MaxW.Xl) == "max-width:var(--container-xl)";
    assert tokenDeclarations(.Size.MaxW.X2xl) == "max-width:var(--container-2xl)";
    assert tokenDeclarations(.Size.MaxW.X3xl) == "max-width:var(--container-3xl)";
    assert tokenDeclarations(.Size.MaxW.X4xl) == "max-width:var(--container-4xl)";
    assert tokenDeclarations(.Size.MaxW.X5xl) == "max-width:var(--container-5xl)";
    assert tokenDeclarations(.Size.MaxW.X6xl) == "max-width:var(--container-6xl)";
    assert tokenDeclarations(.Size.MaxW.X7xl) == "max-width:var(--container-7xl)";
}

test "Size — and each of those names resolves to the width `§ 8.3` prints" {
    val th = defaultTheme();
    assert themeValue(th, "--container-3xs") == "16rem";
    assert themeValue(th, "--container-2xs") == "18rem";
    assert themeValue(th, "--container-xs") == "20rem";
    assert themeValue(th, "--container-sm") == "24rem";
    assert themeValue(th, "--container-md") == "28rem";
    assert themeValue(th, "--container-lg") == "32rem";
    assert themeValue(th, "--container-xl") == "36rem";
    assert themeValue(th, "--container-2xl") == "42rem";
    assert themeValue(th, "--container-3xl") == "48rem";
    assert themeValue(th, "--container-4xl") == "56rem";
    assert themeValue(th, "--container-5xl") == "64rem";
    assert themeValue(th, "--container-6xl") == "72rem";
    assert themeValue(th, "--container-7xl") == "80rem";
}

test "Size — `max-w-screen-*` reads the breakpoint ladder, the same way" {
    val th = defaultTheme();
    assert tokenDeclarations(.Size.MaxW.Screen.Sm) == "max-width:var(--breakpoint-sm)";
    assert tokenDeclarations(.Size.MaxW.Screen.Md) == "max-width:var(--breakpoint-md)";
    assert tokenDeclarations(.Size.MaxW.Screen.Lg) == "max-width:var(--breakpoint-lg)";
    assert tokenDeclarations(.Size.MaxW.Screen.Xl) == "max-width:var(--breakpoint-xl)";
    assert tokenDeclarations(.Size.MaxW.Screen.X2xl) == "max-width:var(--breakpoint-2xl)";
    assert themeValue(th, "--breakpoint-sm") == "40rem";
    assert themeValue(th, "--breakpoint-md") == "48rem";
    assert themeValue(th, "--breakpoint-lg") == "64rem";
    assert themeValue(th, "--breakpoint-xl") == "80rem";
    assert themeValue(th, "--breakpoint-2xl") == "96rem";
}

test "Size.Both — upstream's `size-*`, two declarations from one leaf" {
    assert tokenDeclarations(.Size.Both.12) == "width:calc(var(--spacing) * 12);height:calc(var(--spacing) * 12)";
    assert tokenDeclarations(.Size.Both.Full) == "width:100%;height:100%";
    assert tokenDeclarations(.Size.Both.Frac.Half) == "width:50%;height:50%";
    assert tokenDeclarations(.Size.Both.Auto) == "width:auto;height:auto";
}

test "Size — the six logical forms, which follow the writing direction" {
    assert tokenDeclarations(.Size.Inline.4) == "inline-size:calc(var(--spacing) * 4)";
    assert tokenDeclarations(.Size.Block.4) == "block-size:calc(var(--spacing) * 4)";
    assert tokenDeclarations(.Size.MinInline.Full) == "min-inline-size:100%";
    assert tokenDeclarations(.Size.MaxInline.Md) == "max-inline-size:var(--container-md)";
    assert tokenDeclarations(.Size.MinBlock.Full) == "min-block-size:100%";
    assert tokenDeclarations(.Size.MaxBlock.Full) == "max-block-size:100%";
}

