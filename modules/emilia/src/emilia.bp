// `space-x-*` AND `space-y-*` ARE NOT DECLARATIONS ON THE ELEMENT. They set a
// margin on the element's CHILDREN, so this is the one dispatcher in the front
// that answers a `Sheet` rather than a declaration string — the second of the
// two shapes contract 4a defines — and its one line in `tokenToSheet` skips
// `declSheet`.
//
// The selector is a nesting template with EXACTLY ONE `&`, which is where the
// class name goes: `.e_1f2 > :not(:last-child)`. It is written once, here, and
// FRONT 40 MUST CALL `siblingSelector()` rather than re-spelling it — its
// `divide-*` family separates the same children the same way, and two fronts
// that write the same selector by hand are two fronts that will eventually
// write it differently. A test pins the string so a change to it is a visible
// change rather than a silent one.
//
// REFERENCE GAP, recorded rather than hidden: `space-x-*` is absent from the
// local `TAILWIND_CSS_DOCS.md` entirely, so both the child selector and the
// property are this front's PROPOSAL and not a transcription. The logical
// `margin-inline-end` / `margin-block-end` pair is chosen over
// `margin-left` / `margin-top` for the same reason `Pad.S`/`Pad.E` exist: it
// follows the writing direction. `--tw-space-x-reverse` is an upstream-internal
// custom property name and is unverified; nothing in emilia reads it yet.
pub fn siblingSelector() -> string {
    return "& > :not(:last-child)";
}

// A rule that declares on the CHILDREN of the class, not on the class. Front
// 56's `staticSheet` is the constructor for a LITERAL selector — one with no
// `&`, which the class name never reaches — so this front builds its own
// two-line one rather than stretch that contract.
fn childSheet(decls: string) -> Sheet {
    val none: string[] = [];
    val rules: Rule[] = [Rule(
        layer: "utilities",
        atRules: none,
        selector: siblingSelector(),
        declarations: decls,
        important: false,
    )];
    val blocks: Block[] = [];
    return Sheet(rules: rules, blocks: blocks);
}

fn spaceTokenToSheet(t: Token.Space, th: Theme) -> Sheet {
    val out = case t {
        X(_inner) -> childSheet(oneDecl("margin-inline-end", spaceScaleX(_inner, th)));
        Y(_inner) -> childSheet(oneDecl("margin-block-end", spaceScaleY(_inner, th)));
        XReverse -> childSheet(oneDecl("--tw-space-x-reverse", "1"));
        YReverse -> childSheet(oneDecl("--tw-space-y-reverse", "1"));
    };
    return out;
}

fn spaceScaleX(s: Token.Space.X, th: Theme) -> string {
    val out = case s {
        __0 -> spacing(0); __1 -> spacing(1); __2 -> spacing(2); __3 -> spacing(3);
        __4 -> spacing(4); __5 -> spacing(5); __6 -> spacing(6); __7 -> spacing(7);
        __8 -> spacing(8); __9 -> spacing(9); __10 -> spacing(10); __11 -> spacing(11);
        __12 -> spacing(12); __14 -> spacing(14); __16 -> spacing(16); __20 -> spacing(20);
        __24 -> spacing(24); __28 -> spacing(28); __32 -> spacing(32); __36 -> spacing(36);
        __40 -> spacing(40); __44 -> spacing(44); __48 -> spacing(48); __52 -> spacing(52);
        __56 -> spacing(56); __60 -> spacing(60); __64 -> spacing(64); __72 -> spacing(72);
        __80 -> spacing(80); __96 -> spacing(96);
        Px -> "1px";
        Half(_inner) -> spaceHalfX(_inner, th);
        Neg(_inner) -> spaceNegX(_inner, th);
    };
    return out;
}

fn spaceHalfX(h: Token.Space.X.Half, th: Theme) -> string {
    val out = case h {
        __0 -> spacingHalf(0); __1 -> spacingHalf(1); __2 -> spacingHalf(2);
        __3 -> spacingHalf(3);
    };
    return out;
}

fn spaceNegX(s: Token.Space.X.Neg, th: Theme) -> string {
    val out = case s {
        __1 -> spacing(-1); __2 -> spacing(-2); __3 -> spacing(-3); __4 -> spacing(-4);
        __5 -> spacing(-5); __6 -> spacing(-6); __7 -> spacing(-7); __8 -> spacing(-8);
        __9 -> spacing(-9); __10 -> spacing(-10); __11 -> spacing(-11);
        __12 -> spacing(-12); __14 -> spacing(-14); __16 -> spacing(-16);
        __20 -> spacing(-20); __24 -> spacing(-24); __28 -> spacing(-28);
        __32 -> spacing(-32); __36 -> spacing(-36); __40 -> spacing(-40);
        __44 -> spacing(-44); __48 -> spacing(-48); __52 -> spacing(-52);
        __56 -> spacing(-56); __60 -> spacing(-60); __64 -> spacing(-64);
        __72 -> spacing(-72); __80 -> spacing(-80); __96 -> spacing(-96);
        Px -> "-1px";
        Half(_inner) -> spaceNegHalfX(_inner, th);
    };
    return out;
}

fn spaceNegHalfX(h: Token.Space.X.Neg.Half, th: Theme) -> string {
    val out = case h {
        __1 -> spacingHalf(-1); __2 -> spacingHalf(-2); __3 -> spacingHalf(-3);
    };
    return out;
}

fn spaceScaleY(s: Token.Space.Y, th: Theme) -> string {
    val out = case s {
        __0 -> spacing(0); __1 -> spacing(1); __2 -> spacing(2); __3 -> spacing(3);
        __4 -> spacing(4); __5 -> spacing(5); __6 -> spacing(6); __7 -> spacing(7);
        __8 -> spacing(8); __9 -> spacing(9); __10 -> spacing(10); __11 -> spacing(11);
        __12 -> spacing(12); __14 -> spacing(14); __16 -> spacing(16); __20 -> spacing(20);
        __24 -> spacing(24); __28 -> spacing(28); __32 -> spacing(32); __36 -> spacing(36);
        __40 -> spacing(40); __44 -> spacing(44); __48 -> spacing(48); __52 -> spacing(52);
        __56 -> spacing(56); __60 -> spacing(60); __64 -> spacing(64); __72 -> spacing(72);
        __80 -> spacing(80); __96 -> spacing(96);
        Px -> "1px";
        Half(_inner) -> spaceHalfY(_inner, th);
        Neg(_inner) -> spaceNegY(_inner, th);
    };
    return out;
}

fn spaceHalfY(h: Token.Space.Y.Half, th: Theme) -> string {
    val out = case h {
        __0 -> spacingHalf(0); __1 -> spacingHalf(1); __2 -> spacingHalf(2);
        __3 -> spacingHalf(3);
    };
    return out;
}

fn spaceNegY(s: Token.Space.Y.Neg, th: Theme) -> string {
    val out = case s {
        __1 -> spacing(-1); __2 -> spacing(-2); __3 -> spacing(-3); __4 -> spacing(-4);
        __5 -> spacing(-5); __6 -> spacing(-6); __7 -> spacing(-7); __8 -> spacing(-8);
        __9 -> spacing(-9); __10 -> spacing(-10); __11 -> spacing(-11);
        __12 -> spacing(-12); __14 -> spacing(-14); __16 -> spacing(-16);
        __20 -> spacing(-20); __24 -> spacing(-24); __28 -> spacing(-28);
        __32 -> spacing(-32); __36 -> spacing(-36); __40 -> spacing(-40);
        __44 -> spacing(-44); __48 -> spacing(-48); __52 -> spacing(-52);
        __56 -> spacing(-56); __60 -> spacing(-60); __64 -> spacing(-64);
        __72 -> spacing(-72); __80 -> spacing(-80); __96 -> spacing(-96);
        Px -> "-1px";
        Half(_inner) -> spaceNegHalfY(_inner, th);
    };
    return out;
}

fn spaceNegHalfY(h: Token.Space.Y.Neg.Half, th: Theme) -> string {
    val out = case h {
        __1 -> spacingHalf(-1); __2 -> spacingHalf(-2); __3 -> spacingHalf(-3);
    };
    return out;
}

// ── tests · front 35 ─────────────────────────────────────────────────────────
//
// The front's own block of assertions lives HERE, beside the dispatchers it
// covers, rather than at the end of the file: front 33 appends its own block
// there and a front that appends to the same line of the same file cannot be
// merged without a conflict that says nothing.

test "the scale — every shape of leaf, read through the public `Pad.All` path" {
    assert tokenDeclarations(.Pad.All.0) == "padding:0";
    assert tokenDeclarations(.Pad.All.1) == "padding:calc(var(--spacing) * 1)";
    assert tokenDeclarations(.Pad.All.4) == "padding:calc(var(--spacing) * 4)";
    assert tokenDeclarations(.Pad.All.96) == "padding:calc(var(--spacing) * 96)";
    assert tokenDeclarations(.Pad.All.Half.0) == "padding:calc(var(--spacing) * 0.5)";
    assert tokenDeclarations(.Pad.All.Half.1) == "padding:calc(var(--spacing) * 1.5)";
    assert tokenDeclarations(.Pad.All.Half.3) == "padding:calc(var(--spacing) * 3.5)";
    assert tokenDeclarations(.Pad.All.Px) == "padding:1px";
}

test "the nine padding directions, each with its own property and its own expansion" {
    assert tokenDeclarations(.Pad.All.4) == "padding:calc(var(--spacing) * 4)";
    assert tokenDeclarations(.Pad.X.4) == "padding-left:calc(var(--spacing) * 4);padding-right:calc(var(--spacing) * 4)";
    assert tokenDeclarations(.Pad.Y.4) == "padding-top:calc(var(--spacing) * 4);padding-bottom:calc(var(--spacing) * 4)";
    assert tokenDeclarations(.Pad.T.4) == "padding-top:calc(var(--spacing) * 4)";
    assert tokenDeclarations(.Pad.R.4) == "padding-right:calc(var(--spacing) * 4)";
    assert tokenDeclarations(.Pad.B.4) == "padding-bottom:calc(var(--spacing) * 4)";
    assert tokenDeclarations(.Pad.L.4) == "padding-left:calc(var(--spacing) * 4)";
    assert tokenDeclarations(.Pad.S.4) == "padding-inline-start:calc(var(--spacing) * 4)";
    assert tokenDeclarations(.Pad.E.4) == "padding-inline-end:calc(var(--spacing) * 4)";
}

test "the nine margin directions, each with its own property and its own expansion" {
    assert tokenDeclarations(.Margin.All.4) == "margin:calc(var(--spacing) * 4)";
    assert tokenDeclarations(.Margin.X.4) == "margin-left:calc(var(--spacing) * 4);margin-right:calc(var(--spacing) * 4)";
    assert tokenDeclarations(.Margin.Y.4) == "margin-top:calc(var(--spacing) * 4);margin-bottom:calc(var(--spacing) * 4)";
    assert tokenDeclarations(.Margin.T.4) == "margin-top:calc(var(--spacing) * 4)";
    assert tokenDeclarations(.Margin.R.4) == "margin-right:calc(var(--spacing) * 4)";
    assert tokenDeclarations(.Margin.B.4) == "margin-bottom:calc(var(--spacing) * 4)";
    assert tokenDeclarations(.Margin.L.4) == "margin-left:calc(var(--spacing) * 4)";
    assert tokenDeclarations(.Margin.S.4) == "margin-inline-start:calc(var(--spacing) * 4)";
    assert tokenDeclarations(.Margin.E.4) == "margin-inline-end:calc(var(--spacing) * 4)";
}

test "`Auto` is on every margin direction, not only on the X axis" {
    assert tokenDeclarations(.Margin.All.Auto) == "margin:auto";
    assert tokenDeclarations(.Margin.X.Auto) == "margin-left:auto;margin-right:auto";
    assert tokenDeclarations(.Margin.Y.Auto) == "margin-top:auto;margin-bottom:auto";
    assert tokenDeclarations(.Margin.T.Auto) == "margin-top:auto";
    assert tokenDeclarations(.Margin.R.Auto) == "margin-right:auto";
    assert tokenDeclarations(.Margin.B.Auto) == "margin-bottom:auto";
    assert tokenDeclarations(.Margin.L.Auto) == "margin-left:auto";
    assert tokenDeclarations(.Margin.S.Auto) == "margin-inline-start:auto";
    assert tokenDeclarations(.Margin.E.Auto) == "margin-inline-end:auto";
}

test "`Neg` is on every margin direction — the `-mt-4` form, spelled as a path" {
    assert tokenDeclarations(.Margin.All.Neg.4) == "margin:calc(var(--spacing) * -4)";
    assert tokenDeclarations(.Margin.X.Neg.4) == "margin-left:calc(var(--spacing) * -4);margin-right:calc(var(--spacing) * -4)";
    assert tokenDeclarations(.Margin.Y.Neg.4) == "margin-top:calc(var(--spacing) * -4);margin-bottom:calc(var(--spacing) * -4)";
    assert tokenDeclarations(.Margin.T.Neg.4) == "margin-top:calc(var(--spacing) * -4)";
    assert tokenDeclarations(.Margin.R.Neg.4) == "margin-right:calc(var(--spacing) * -4)";
    assert tokenDeclarations(.Margin.B.Neg.4) == "margin-bottom:calc(var(--spacing) * -4)";
    assert tokenDeclarations(.Margin.L.Neg.4) == "margin-left:calc(var(--spacing) * -4)";
    assert tokenDeclarations(.Margin.S.Neg.4) == "margin-inline-start:calc(var(--spacing) * -4)";
    assert tokenDeclarations(.Margin.E.Neg.4) == "margin-inline-end:calc(var(--spacing) * -4)";
}

test "a negative margin carries the pixel step and the half steps too" {
    assert tokenDeclarations(.Margin.T.Neg.Px) == "margin-top:-1px";
    assert tokenDeclarations(.Margin.T.Neg.Half.1) == "margin-top:calc(var(--spacing) * -1.5)";
    assert tokenDeclarations(.Margin.X.Neg.2) == "margin-left:calc(var(--spacing) * -2);margin-right:calc(var(--spacing) * -2)";
}

