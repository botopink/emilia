// ── the theme contribution · the 286 numeric values ──────────────────────────
//
// The other half of the mechanism. The utility side emits
// `var(--color-red-500)`; SOMETHING has to declare `--color-red-500`, and this
// is it — as a plain `ThemeEntry[]`, not as a rendered block, so a consumer
// composes it with front 54's `extendTheme` and front 54's `themeCss` renders
// it into the `theme` layer:
//
//     val th = extendTheme(defaultTheme(), paletteEntries());
//     val doc = await flushWith(withTheme(defaultOptions(), th));
//
// KEEPING IT A LIST RATHER THAN A STRING is what lets a project that already
// imports upstream's own theme leave it out and still use every colour token —
// the tokens name variables, and whoever declares them is the consumer's call.
// `emilia(...)` emits no `@theme` block of its own, at any size of token list.
//
// SOURCE: upstream `tailwindcss` **4.3.2**, `theme.css`, transcribed
// mechanically — 26 families x 11 shades = 286 entries, in the reference's own
// family order (17 chromatic, then 9 neutral). `--color-white` and
// `--color-black` are NOT here: `defaultTheme()` already carries them, and
// `extendTheme` would override in place rather than duplicate, which would
// still be a second author for a value that has one.
//
// ON THE TWO ANCHOR VALUES. `§ 3.6` prints exactly two of the 286, and it
// prints them in the decimal-lightness spelling — `oklch(0.637 0.237 25.331)`
// for red-500, `oklch(0.623 0.214 259.815)` for blue-500. Upstream's own
// `theme.css` writes the SAME TWO COLOURS as `oklch(63.7% 0.237 25.331)` and
// `oklch(62.3% 0.214 259.815)`: `63.7%` and `0.637` are the same lightness in
// OKLCH, so the reference and upstream agree on the colour and disagree on the
// spelling. This front takes upstream's, because byte-parity with the emitted
// `@theme` block is the thing worth having and because two of 286 entries in a
// second spelling would be a table with two authors. The test below pins both
// anchors AND their decimal equivalents, so the disagreement is recorded where
// it would otherwise be discovered.

pub fn paletteEntries() -> ThemeEntry[] {
    return paletteRedEntries()
        .append(paletteOrangeEntries())
        .append(paletteAmberEntries())
        .append(paletteYellowEntries())
        .append(paletteLimeEntries())
        .append(paletteGreenEntries())
        .append(paletteEmeraldEntries())
        .append(paletteTealEntries())
        .append(paletteCyanEntries())
        .append(paletteSkyEntries())
        .append(paletteBlueEntries())
        .append(paletteIndigoEntries())
        .append(paletteVioletEntries())
        .append(palettePurpleEntries())
        .append(paletteFuchsiaEntries())
        .append(palettePinkEntries())
        .append(paletteRoseEntries())
        .append(paletteSlateEntries())
        .append(paletteGrayEntries())
        .append(paletteZincEntries())
        .append(paletteNeutralEntries())
        .append(paletteStoneEntries())
        .append(paletteMauveEntries())
        .append(paletteOliveEntries())
        .append(paletteMistEntries())
        .append(paletteTaupeEntries());
}


