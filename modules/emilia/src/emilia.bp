test "every Size leaf declares a property, and none of them resolves a rem" {
    val s = tokensToSheet(everySizeToken(), defaultTheme());
    assert s.rules.length == 566;
    val css = declarationsOf(s).join(";");
    assert declarationsOf(s).any({ d -> d == "" }) == false;
    assert css.indexOf("rem") == -1;
    assert css.indexOf("padding") == -1;
    assert css.indexOf("margin") == -1;
}

// ── tests · Space ────────────────────────────────────────────────────────────

fn spaceRule(t: Token) -> Rule {
    return firstRuleOf(tokenToSheet(t, defaultTheme()));
}

test "Space — the declaration is on the CHILDREN, under the sibling selector" {
    val r = spaceRule(.Space.Y.4);
    assert r.selector == "& > :not(:last-child)";
    assert r.declarations == "margin-block-end:calc(var(--spacing) * 4)";
    assert r.layer == "utilities";
    assert r.atRules.length == 0;
    assert r.important == false;
}

test "Space — the X axis is the inline end, the Y axis the block end" {
    assert spaceRule(.Space.X.4).declarations == "margin-inline-end:calc(var(--spacing) * 4)";
    assert spaceRule(.Space.Y.4).declarations == "margin-block-end:calc(var(--spacing) * 4)";
    assert spaceRule(.Space.X.0).declarations == "margin-inline-end:0";
    assert spaceRule(.Space.X.Px).declarations == "margin-inline-end:1px";
    assert spaceRule(.Space.Y.Half.1).declarations == "margin-block-end:calc(var(--spacing) * 1.5)";
}

test "Space — a negative child margin, the pull-up form" {
    assert spaceRule(.Space.X.Neg.2).declarations == "margin-inline-end:calc(var(--spacing) * -2)";
    assert spaceRule(.Space.Y.Neg.4).declarations == "margin-block-end:calc(var(--spacing) * -4)";
    assert spaceRule(.Space.Y.Neg.Px).declarations == "margin-block-end:-1px";
}

test "Space — the two reverse tokens set the upstream custom property" {
    assert spaceRule(.Space.XReverse).declarations == "--tw-space-x-reverse:1";
    assert spaceRule(.Space.YReverse).declarations == "--tw-space-y-reverse:1";
    assert spaceRule(.Space.XReverse).selector == "& > :not(:last-child)";
}

// The selector is a nesting template, so it carries EXACTLY ONE `&` — with
// none it would replace the rule it was meant to describe, with two it would
// duplicate it, and front 56 refuses both with no opt-out. Front 40's `divide-*`
// separates the same children the same way and must call `siblingSelector()`
// rather than re-spell it; this is the assertion that makes a divergence
// visible the day it is written.
test "Space — the sibling selector is one template, with exactly one ampersand" {
    val sel = siblingSelector();
    assert sel == "& > :not(:last-child)";
    assert sel.split("&").length - 1 == 1;
    assert spaceRule(.Space.X.4).selector == sel;
    assert spaceRule(.Space.YReverse).selector == sel;
}

test "Space — a modifier wraps the child selector, it does not replace it" {
    val inner: Token[] = [.Space.Y.4];
    val r = firstRuleOf(tokenToSheet(Token.Hover(inner), defaultTheme()));
    assert r.selector == "&:hover > :not(:last-child)";
    assert r.declarations == "margin-block-end:calc(var(--spacing) * 4)";
}

// A `Space` token and a plain declaration in ONE token list are two rules of
// one class, because they do not describe the same elements. The spec writes
// the composition as one declaration string; it cannot be one — a declaration
// string has no room for a selector — so what is pinned here is the rendered
// document, which is where the question is actually answered.
test "Space — composing with a Pad token in one list gives two rules, in order" {
    val tokens: Token[] = [.Pad.All.4, .Space.Y.4];
    val cls = emilia(tokens);
    val styles = await flushWith(bareOptions());
    assert styles == "<style>@layer theme, base, components, utilities;@layer utilities{."
        + cls + "{padding:calc(var(--spacing) * 4)}."
        + cls + " > :not(:last-child){margin-block-end:calc(var(--spacing) * 4)}}</style>";
}

// ── tests · end to end ───────────────────────────────────────────────────────

// The centred article shell every layout starts from: a max width from the
// theme's container ladder, `mx-auto`, and horizontal padding. Three tokens,
// one class, and — because all three sit in the same context — ONE rule.
test "end to end — a centred shell is one class, one rule, and no length in it" {
    val tokens: Token[] = [.Size.MaxW.X3xl, .Margin.X.Auto, .Pad.X.6];
    val cls = emilia(tokens);
    val styles = await flushWith(bareOptions());
    assert styles == "<style>@layer theme, base, components, utilities;@layer utilities{."
        + cls + "{max-width:var(--container-3xl);margin-left:auto;margin-right:auto;"
        + "padding-left:calc(var(--spacing) * 6);padding-right:calc(var(--spacing) * 6)}}</style>";
}

// The same three tokens under the STOCK theme: every length the shell resolves
// to is in the `:root` block rather than in the rule, which is the whole point
// of the front. A project that overrides either variable moves the shell
// without emilia re-emitting a byte of it.
test "end to end — the lengths live in the theme layer, not in the utility" {
    val tokens: Token[] = [.Size.MaxW.X3xl, .Margin.X.Auto, .Pad.X.6];
    val cls = emilia(tokens);
    val styles = await flush();
    assert styles.indexOf("--spacing:0.25rem") != -1;
    assert styles.indexOf("--container-3xl:48rem") != -1;
    assert styles.indexOf("@layer utilities{." + cls + "{max-width:var(--container-3xl);"
        + "margin-left:auto;margin-right:auto;padding-left:calc(var(--spacing) * 6);"
        + "padding-right:calc(var(--spacing) * 6)}}") != -1;
}

// A stacked thread: the children are spaced by `Space.Y` and the last reply is
// pulled back up by a negative margin. Both are front 35's, and they land in
// two different rules because they describe two different sets of elements.
test "end to end — a stacked thread spaces its children and pulls one back up" {
    val stack: Token[] = [.Space.Y.4, .Pad.All.6];
    val pulled: Token[] = [.Margin.T.Neg.2];
    val stackCls = emilia(stack);
    val pulledCls = emilia(pulled);
    val styles = await flushWith(bareOptions());
    assert styles.indexOf("." + stackCls + "{padding:calc(var(--spacing) * 6)}") != -1;
    assert styles.indexOf("." + stackCls + " > :not(:last-child){margin-block-end:calc(var(--spacing) * 4)}") != -1;
    assert styles.indexOf("." + pulledCls + "{margin-top:calc(var(--spacing) * -2)}") != -1;
}

// ── end front 35 ─────────────────────────────────────────────────────────────

fn layoutTokenToCss(t: Token.Layout) -> string {
    val out = case t {
        Block -> "display:block";
        InlineBlock -> "display:inline-block";
        Inline -> "display:inline";
        Hidden -> "display:none";
        Flex -> "display:flex";
        Grid -> "display:grid";
    };
    return out;
}

fn flexTokenToCss(t: Token.Flex) -> string {
    val out = case t {
        Row -> "flex-direction:row";
        Col -> "flex-direction:column";
        Wrap -> "flex-wrap:wrap";
        NoWrap -> "flex-wrap:nowrap";
        Items(_inner) -> flexItemsToCss(_inner);
        Justify(_inner) -> flexJustifyToCss(_inner);
        Gap(_inner) -> "gap:" + flexGapScale(_inner);
    };
    return out;
}

fn flexItemsToCss(p: Token.Flex.Items) -> string {
    val out = case p {
        Start -> "align-items:flex-start";
        Center -> "align-items:center";
        End -> "align-items:flex-end";
        Stretch -> "align-items:stretch";
    };
    return out;
}

fn flexJustifyToCss(p: Token.Flex.Justify) -> string {
    val out = case p {
        Start -> "justify-content:flex-start";
        Center -> "justify-content:center";
        End -> "justify-content:flex-end";
        Between -> "justify-content:space-between";
        Around -> "justify-content:space-around";
    };
    return out;
}

fn flexGapScale(s: Token.Flex.Gap) -> string {
    val out = case s {
        __1 -> "0.25rem";
        __2 -> "0.5rem";
        __4 -> "1rem";
        __8 -> "2rem";
    };
    return out;
}

fn borderTokenToCss(t: Token.Border) -> string {
    val out = case t {
        W(_inner) -> borderWidthToCss(_inner);
        Color(_inner) -> borderColorToCss(_inner);
        Rounded(_inner) -> borderRoundedToCss(_inner);
    };
    return out;
}

fn borderWidthToCss(s: Token.Border.W) -> string {
    val out = case s {
        __0 -> "border-width:0";
        __1 -> "border-width:1px";
        __2 -> "border-width:2px";
        __4 -> "border-width:4px";
    };
    return out;
}

fn borderColorToCss(c: Token.Border.Color) -> string {
    val out = case c {
        Red(_inner) -> "border-color:red";
        Gray(_inner) -> "border-color:gray";
        Hex(value) -> "border-color:" + value;
    };
    return out;
}

fn borderRoundedToCss(r: Token.Border.Rounded) -> string {
    val out = case r {
        Sm -> "border-radius:0.125rem";
        Md -> "border-radius:0.375rem";
        Lg -> "border-radius:0.5rem";
        Full -> "border-radius:9999px";
    };
    return out;
}

fn effectTokenToCss(t: Token.Effect) -> string {
    val out = case t {
        Shadow(_inner) -> shadowToCss(_inner);
        Opacity(_inner) -> opacityToCss(_inner);
    };
    return out;
}

fn shadowToCss(s: Token.Effect.Shadow) -> string {
    val out = case s {
        Sm -> "box-shadow:sm";
        Md -> "box-shadow:md";
        Lg -> "box-shadow:lg";
        Xl -> "box-shadow:xl";
    };
    return out;
}

fn opacityToCss(o: Token.Effect.Opacity) -> string {
    val out = case o {
        __0 -> "opacity:0";
        __25 -> "opacity:0.25";
        __50 -> "opacity:0.5";
        __75 -> "opacity:0.75";
        __100 -> "opacity:1";
    };
    return out;
}

// ── front 56 · test helpers ───────────────────────────────────────────

// A document with no theme in it, so a cascade assertion reads as the rules
// the test registered rather than as the stock theme's hundred variables.
fn bareOptions() -> Options {
    return withTheme(defaultOptions(), emptyTheme());
}

fn firstRuleOf(s: Sheet) -> Rule {
    val none: string[] = [];
    val fallback = Rule(layer: "", atRules: none, selector: "", declarations: "", important: false);
    val out = s.rules.at(0) ?? fallback;
    return out;
}

// What one token declares, ignoring where it declares it. The seven leaf tests
// below read this; anything about a selector or an at-rule reads the rule.
fn tokenDeclarations(t: Token) -> string {
    return declarationsOf(tokenToSheet(t, defaultTheme())).join(";");
}

// ── tests · the leaf dispatchers ────────────────────────────────────────
// V1 enum-section dispatch smoke, unchanged in substance by front 56: a
// section sub-dispatcher still answers a declaration string, and these pin
// that. What changed is that the string reaches the document through a `Rule`.

test "tokenToSheet — Text.Bold lowers to font-weight:bold" {
    assert tokenDeclarations(.Text.Bold) == "font-weight:bold";
}

test "tokenToSheet — Text.Size.Lg lowers to font-size:1.125rem" {
    assert tokenDeclarations(.Text.Size.Lg) == "font-size:1.125rem";
}

test "tokenToSheet — Color.Black lowers to the theme reference, not a hex" {
    assert tokenDeclarations(.Color.Black) == "color:var(--color-black)";
}

test "tokenToSheet — Bg.White lowers to background:#ffffff" {
    assert tokenDeclarations(.Bg.White) == "background:#ffffff";
}

test "tokenToSheet — Layout.Flex lowers to display:flex" {
    assert tokenDeclarations(.Layout.Flex) == "display:flex";
}

test "tokenToSheet — Border.Rounded.Full lowers to border-radius:9999px" {
    assert tokenDeclarations(.Border.Rounded.Full) == "border-radius:9999px";
}

test "tokenToSheet — Effect.Shadow.Md lowers to box-shadow:md" {
    assert tokenDeclarations(.Effect.Shadow.Md) == "box-shadow:md";
}

test "tokenToSheet — a section token is one utilities rule on the bare ampersand" {
    val r = firstRuleOf(tokenToSheet(.Text.Bold, defaultTheme()));
    assert r.layer == "utilities";
    assert r.selector == "&";
    assert r.atRules.length == 0;
    assert r.important == false;
}

// ── tests · the six modifiers, against the variant reference ────────────────
//
// Every expected selector below names the row of the reference's variant table
// it comes from. These six assertions used to read `":hover{…}"` and
// `"@media(min-width:768px){…}"`, both of which the table contradicts; front 56
// owns the break.

test "Hover — the `hover` row is `@media (hover: hover) { &:hover }`, not a bare :hover" {
    val inner: Token[] = [.Color.Black];
    val r = firstRuleOf(tokenToSheet(Token.Hover(inner), defaultTheme()));
    assert r.selector == "&:hover";
    assert r.atRules.join("|") == "@media (hover: hover)";
    assert r.declarations == "color:var(--color-black)";
}

test "Focus and Active — the `focus` and `active` rows are selector-only" {
    val inner: Token[] = [.Text.Bold];
    val f = firstRuleOf(tokenToSheet(Token.Focus(inner), defaultTheme()));
    assert f.selector == "&:focus";
    assert f.atRules.length == 0;
    val a = firstRuleOf(tokenToSheet(Token.Active(inner), defaultTheme()));
    assert a.selector == "&:active";
    assert a.atRules.length == 0;
}

test "Md, Lg and Xl — the breakpoint rows are `@media (width >= <n>rem)`, read from the theme" {
    val inner: Token[] = [.Text.Bold];
    assert firstRuleOf(tokenToSheet(Token.Md(inner), defaultTheme())).atRules.join("|") == "@media (width >= 48rem)";
    assert firstRuleOf(tokenToSheet(Token.Lg(inner), defaultTheme())).atRules.join("|") == "@media (width >= 64rem)";
    assert firstRuleOf(tokenToSheet(Token.Xl(inner), defaultTheme())).atRules.join("|") == "@media (width >= 80rem)";
    assert firstRuleOf(tokenToSheet(Token.Md(inner), defaultTheme())).selector == "&";
}

test "tokensToSheet — a multi-token list is one rule per token, in order" {
    val list: Token[] = [.Text.Bold, .Color.Black];
    val s = tokensToSheet(list, defaultTheme());
    assert s.rules.length == 2;
    assert declarationsOf(s).join(";") == "font-weight:bold;color:var(--color-black)";
}

test "nested modifiers — the outer modifier is outermost, in both halves" {
    val deepest: Token[] = [.Text.Bold];
    val mid: Token[] = [Token.Md(deepest)];
    val r = firstRuleOf(tokenToSheet(Token.Hover(mid), defaultTheme()));
    assert r.selector == "&:hover";
    assert r.atRules.join("|") == "@media (hover: hover)|@media (width >= 48rem)";
}

test "a breakpoint follows the theme, so the theme is an input to the class hash" {
    val wide: ThemeEntry[] = [ThemeEntry(name: "--breakpoint-md", value: "50rem")];
    val th = extendTheme(defaultTheme(), wide);
    val inner: Token[] = [.Text.Bold];
    assert firstRuleOf(tokenToSheet(Token.Md(inner), th)).atRules.join("|") == "@media (width >= 50rem)";
    val tokens: Token[] = [Token.Md(inner)];
    assert emiliaWith(tokens, th) != emiliaWith(tokens, defaultTheme());
    val _drop = await flush();
}

// ── tests · the codec assumption, over the dispatcher's own output ──────────

fn everySectionToken() -> Token[] {
    val hoverInner: Token[] = [.Color.Black];
    val mdInner: Token[] = [.Text.Bold];
    val out: Token[] = [
        .Text.Bold,
        .Text.Size.Lg,
        .Font.Sans,
        .Font.Weight.Bold,
        .Color.Black,
        .Bg.White,
        .Pad.All.__4,
        .Margin.Y.__2,
        .Layout.Flex,
        .Flex.Gap.__4,
        .Border.Rounded.Full,
        .Effect.Shadow.Md,
        Token.Hover(hoverInner),
        Token.Md(mdInner),
    ];
    return out;
}

test "codec — no declaration any dispatcher produces carries a codec separator" {
    val s = tokensToSheet(everySectionToken(), defaultTheme());
    assert s.rules.length == 14;
    assert declarationsOf(s).any({ d -> carriesSeparator(d) }) == false;
    assert s.rules.any({ r -> carriesSeparator(r.selector) }) == false;
    assert s.rules.any({ r -> carriesSeparator(r.atRules.join("")) }) == false;
}

test "codec — a full dispatcher sheet round-trips through the cell encoding" {
    val s = tokensToSheet(everySectionToken(), defaultTheme());
    val raw = encodeSheet(s);
    assert encodeSheet(decodeSheet(raw)) == raw;
    assert decodeSheet(raw).rules.length == 14;
}

// ── tests · the host cell and the drain ────────────────────────────────
//
// The two templates are written twice, once per target, and the whole point of
// moving assembly out of them is that the divergence became testable: every
// assertion here runs on `--target commonJS` and on `--target erlang`, and a
// drain that is green on one only means the other is wrong.

test "drainRules — nothing registered drains to the empty string" {
    val raw = await drainRules();
    assert raw == "";
}

test "drainRules — the payloads come back verbatim, in insertion order" {
    register("e_a", "P1");
    register("e_b", "P2");
    val raw = await drainRules();
    assert raw == "e_a\tP1\ne_b\tP2";
}

test "drainRules — a drain clears the cell, so the second of two is empty" {
    register("e_a", "P1");
    val first = await drainRules();
    val second = await drainRules();
    assert first == "e_a\tP1";
    assert second == "";
}

test "drainRules — re-registering a name keeps its position and replaces its payload" {
    register("e_a", "P1");
    register("e_b", "P2");
    register("e_a", "P3");
    val raw = await drainRules();
    assert raw == "e_a\tP3\ne_b\tP2";
}

test "drainRules — the cell assembles nothing: no `<style>`, no brace, in what it hands back" {
    val tokens: Token[] = [.Bg.Black];
    val _cls = emilia(tokens);
    val raw = await drainRules();
    assert raw.indexOf("<") == -1;
    assert raw.indexOf("{") == -1;
    assert raw.indexOf("}") == -1;
}

// ── tests · the public surface ──────────────────────────────────────

test "emilia of an empty token list is a stable class that contributes no rule" {
    val empty: Token[] = [];
    val a = emilia(empty);
    val b = emilia(empty);
    assert a == b;
    assert a.startsWith("e_");
    val styles = await flushWith(bareOptions());
    assert styles == "<style>@layer theme, base, components, utilities;</style>";
}

test "emilia of one text token produces a single-declaration rule" {
    val tokens: Token[] = [.Text.Bold];
    val cls = emilia(tokens);
    val styles = await flushWith(bareOptions());
    assert styles == "<style>@layer theme, base, components, utilities;@layer utilities{." + cls + "{font-weight:bold}}</style>";
}

test "emilia of mixed tokens folds one class into one rule" {
    val tokens: Token[] = [.Bg.White, .Text.Size.Lg];
    val cls = emilia(tokens);
    val styles = await flushWith(bareOptions());
    assert styles == "<style>@layer theme, base, components, utilities;@layer utilities{." + cls + "{background:#ffffff;font-size:1.125rem}}</style>";
}

test "two emilia sites with the same token list collapse to one class" {
    val tokens: Token[] = [.Bg.White];
    val a = emilia(tokens);
    val b = emilia(tokens);
    assert a == b;
    val styles = await flushWith(bareOptions());
    assert styles == "<style>@layer theme, base, components, utilities;@layer utilities{." + a + "{background:#ffffff}}</style>";
}

// Hex(value) payload variant inside a nested section can't be constructed
// inline via the current dot-shorthand grammar (`[.Color.Hex("#abc")]`
// trips the parser — the dot-chain + payload-call combination doesn't
// propagate the typed-array context inside the array literal). Until the
// shorthand for that shape lands, callers wrap the call in a fn or use
// the typed `val` intermediate. Tracked as part of `enum-sections` tail.

test "a modifier is a SIBLING rule now, not a block nested inside the class" {
    val inner: Token[] = [.Bg.White, .Text.Bold];
    val tokens: Token[] = [.Bg.Black, Token.Hover(inner)];
    val cls = emilia(tokens);
    val styles = await flushWith(bareOptions());
    assert styles == "<style>@layer theme, base, components, utilities;@layer utilities{."
        + cls + "{background:#000000}@media (hover: hover){." + cls
        + ":hover{background:#ffffff;font-weight:bold}}}</style>";
}

test "two consecutive flushes emit two independent documents" {
    val first: Token[] = [.Text.Bold];
    val _a = emilia(first);
    val s1 = await flushWith(bareOptions());
    val s2 = await flushWith(bareOptions());
    assert s1.indexOf("@layer utilities{") != -1;
    assert s2 == "<style>@layer theme, base, components, utilities;</style>";
}

test "flush — the stock render carries the theme layer and the stock keyframes" {
    val tokens: Token[] = [.Text.Bold];
    val cls = emilia(tokens);
    val styles = await flush();
    assert styles.startsWith("<style>@layer theme, base, components, utilities;@layer theme{:root{--spacing:0.25rem;");
    assert styles.indexOf("@layer utilities{." + cls + "{font-weight:bold}}") != -1;
    assert styles.endsWith("@keyframes bounce{0%,100%{transform:translateY(-25%);animation-timing-function:cubic-bezier(0.8,0,1,1)}50%{transform:none;animation-timing-function:cubic-bezier(0,0,0.2,1)}}</style>");
}

// ── tests · the conflict rule ───────────────────────────────────────
//
// The reference's conflict section: the LAST rule in the stylesheet wins, and
// its own worked example is `class="grid flex"` resolving to `display:flex`.
// Inside one `emilia()` call that is the token list order; across calls it is
// registration order. Before front 56 nothing said either.

test "conflict — `grid flex` renders in list order, so the last one wins" {
    val tokens: Token[] = [.Layout.Grid, .Layout.Flex];
    val cls = emilia(tokens);
    val styles = await flushWith(bareOptions());
    assert styles == "<style>@layer theme, base, components, utilities;@layer utilities{." + cls + "{display:grid;display:flex}}</style>";
}

test "conflict — reversing the list reverses the winner, and is a different class" {
    val a: Token[] = [.Layout.Grid, .Layout.Flex];
    val b: Token[] = [.Layout.Flex, .Layout.Grid];
    val clsA = emiliaWith(a, defaultTheme());
    val clsB = emiliaWith(b, defaultTheme());
    assert clsA != clsB;
    val styles = await flushWith(bareOptions());
    assert styles.indexOf("." + clsA + "{display:grid;display:flex}") != -1;
    assert styles.indexOf("." + clsB + "{display:flex;display:grid}") != -1;
}

test "conflict — two emilia calls setting the same property render in CALL order" {
    val first: Token[] = [.Layout.Grid];
    val second: Token[] = [.Layout.Flex];
    val clsA = emilia(first);
    val clsB = emilia(second);
    val styles = await flushWith(bareOptions());
    assert styles.indexOf("." + clsA + "{display:grid}") < styles.indexOf("." + clsB + "{display:flex}");
}

test "conflict — reordering an unrelated token moves no other rule" {
    val one: Token[] = [.Text.Bold, .Layout.Flex, .Color.Black];
    val two: Token[] = [.Layout.Flex, .Text.Bold, .Color.Black];
    val clsA = emilia(one);
    val clsB = emilia(two);
    val styles = await flushWith(bareOptions());
    assert styles.indexOf("." + clsA + "{font-weight:bold;display:flex;color:var(--color-black)}") != -1;
    assert styles.indexOf("." + clsB + "{display:flex;font-weight:bold;color:var(--color-black)}") != -1;
    assert styles.indexOf("." + clsA) < styles.indexOf("." + clsB);
}

test "conflict — a variant of a rule follows the rule it varies" {
    val inner: Token[] = [.Layout.Grid];
    val tokens: Token[] = [Token.Md(inner), .Layout.Flex];
    val cls = emilia(tokens);
    val styles = await flushWith(bareOptions());
    assert styles == "<style>@layer theme, base, components, utilities;@layer utilities{."
        + cls + "{display:flex}@media (width >= 48rem){." + cls + "{display:grid}}}</style>";
}

//// ═══ FRONT 33 · the colour palette ═══════════════════════════════════════
////
//// The 26 families x 11 shades of `§ 3.6` / `§ 21.1` on `color` here, the
//// same grid on `background-color` under `Bg.Color`, the five named colours,
//// and the `Alpha` opacity wrapper.
////
//// THE TOKEN EMITS A REFERENCE, NEVER A VALUE. Upstream does not inline a
//// colour into a utility rule: it declares the shade once in the theme layer
//// and every utility names it — `--color-red-500: oklch(…)` inside `@theme`,
//// `color: var(--color-red-500)` inside `.text-red-500`. emilia mirrors that
//// exactly. It is what makes the utility half byte-equal with upstream
//// without holding 286 numbers at the call site, and what makes a project's
//// own `--color-red-500` override reach every rule that names it.
////
//// So THE PALETTE RESOLVES THROUGH THE THEME, never through a literal
//// ladder. `paletteVar(family, shade)` is one line over front 54's
//// `themeVar`, and the `--color-` prefix it builds on is front 54's
//// `nsPrefix(Ns.Color)` — the prefix has one author in this library and this
//// front is not a second one. The file used to carry `redPaletteHex`, a
//// correct nine-shade ladder of Tailwind v3 hex values that NOTHING CALLED,
//// beside a dispatcher that answered `"color:red"` for every shade; both are
//// gone.
////
//// The 286 numeric values are the other half, and they are data rather than
//// code: `paletteEntries()` hands them over as `ThemeEntry[]` for a consumer
//// to compose — `extendTheme(defaultTheme(), paletteEntries())`. Keeping them
//// a list rather than a rendered block is what lets a project that already
//// imports upstream's own theme leave them out and still use every colour
//// token. `emilia(...)` emits no `@theme` block of its own.

// `paletteVar("red", "500")` is `var(--color-red-500)` — the reference a
// utility emits, built from front 54's namespace prefix and front 54's
// `themeVar`. It takes two plain STRINGS and no token, and the property name
// lives in the dispatcher rather than in the value: the palette is a
// string-to-string mapping with the enum only at its edge, so front 57's
// escape hatch can hand it a family and a shade it did not get from a leaf and
// get the same well-formed reference back, without a second palette table and
// without this front changing shape.
pub fn paletteVar(family: string, shade: string) -> string {
    return themeVar(nsPrefix(Ns.Color) + family + "-" + shade);
}

// ── the `Color` section · the `text-*` colours ───────────────────────────────
//
// One arm per family, and NO ARM DISCARDS ITS PAYLOAD — which is the whole
// defect this front closes. `Red(_inner) -> "color:red"` rendered
// `.Color.Red.100` and `.Color.Red.900` byte-identically, so the shade level
// existed in the type and did nothing in the output.
//
// `White` and `Black` reference the theme too: `defaultTheme()` already
// carries `--color-white` / `--color-black`, and a project that overrides them
// expects `.Color.Black` to follow. That is a deliberate break with the two
// front-56 assertions that read `color:#000000` — the hex was the stub's, not
// a contract. `Transparent`, `Current` and `Inherit` are CSS-wide keywords
// with no theme entry, so those three stay literal. `Hex(value)` is retained
// unchanged, as the proof that a string payload splices (see the note under
// the tests).
//
// BLOCKED — SIX OF THE 286 CELLS ARE DECLARED AND UNREACHABLE.
// `.Color.Red.100`, `.Color.Red.500`, `.Color.Red.700`, `.Color.Gray.100`,
// `.Color.Gray.500` and `.Color.Gray.700` do not compile in any spelling.
// `tryResolveEnumSectionPath` (compiler-core `comptime/infer.zig`) resolves a
// leading-dot path by iterating `env.typeDefs` — a hash map that holds the
// SYNTHESISED SECTION ENUMS beside the real ones — and returning the first
// enum whose section tree carries the path. `Token` carries `Color.Red.500`
// and so does `__Token__Border` (front 40's `Border.Color` stub, whose Red and
// Gray also run 100/500/700), so the winner is decided by hash order and the
// expected type is never consulted: `val t: Token = .Color.Red.500;` reds with
// `type mismatch: expected Token, got __Token__Border`, and so does the array
// literal, the call argument and the fully-qualified `Token.Color.Red.500`
// (which the resolver does not accept at all). It fails LOUDLY at the call
// site rather than emitting the wrong CSS. The fix is the compiler's: prefer
// the enum the expected type names, and refuse rather than guess when two
// enums match. Until it lands, `.Bg.Color.Red.500` reaches the same shade —
// `Bg` is a head segment no other enum carries.

fn colorTokenToCss(t: Token.Color, th: Theme) -> string {
    val out = case t {
        Red(_inner) -> "color:" + paletteVar("red", colorRedShade(_inner));
        Orange(_inner) -> "color:" + paletteVar("orange", colorOrangeShade(_inner));
        Amber(_inner) -> "color:" + paletteVar("amber", colorAmberShade(_inner));
        Yellow(_inner) -> "color:" + paletteVar("yellow", colorYellowShade(_inner));
        Lime(_inner) -> "color:" + paletteVar("lime", colorLimeShade(_inner));
        Green(_inner) -> "color:" + paletteVar("green", colorGreenShade(_inner));
        Emerald(_inner) -> "color:" + paletteVar("emerald", colorEmeraldShade(_inner));
        Teal(_inner) -> "color:" + paletteVar("teal", colorTealShade(_inner));
        Cyan(_inner) -> "color:" + paletteVar("cyan", colorCyanShade(_inner));
        Sky(_inner) -> "color:" + paletteVar("sky", colorSkyShade(_inner));
        Blue(_inner) -> "color:" + paletteVar("blue", colorBlueShade(_inner));
        Indigo(_inner) -> "color:" + paletteVar("indigo", colorIndigoShade(_inner));
        Violet(_inner) -> "color:" + paletteVar("violet", colorVioletShade(_inner));
        Purple(_inner) -> "color:" + paletteVar("purple", colorPurpleShade(_inner));
        Fuchsia(_inner) -> "color:" + paletteVar("fuchsia", colorFuchsiaShade(_inner));
        Pink(_inner) -> "color:" + paletteVar("pink", colorPinkShade(_inner));
        Rose(_inner) -> "color:" + paletteVar("rose", colorRoseShade(_inner));
        Slate(_inner) -> "color:" + paletteVar("slate", colorSlateShade(_inner));
        Gray(_inner) -> "color:" + paletteVar("gray", colorGrayShade(_inner));
        Zinc(_inner) -> "color:" + paletteVar("zinc", colorZincShade(_inner));
        Neutral(_inner) -> "color:" + paletteVar("neutral", colorNeutralShade(_inner));
        Stone(_inner) -> "color:" + paletteVar("stone", colorStoneShade(_inner));
        Mauve(_inner) -> "color:" + paletteVar("mauve", colorMauveShade(_inner));
        Olive(_inner) -> "color:" + paletteVar("olive", colorOliveShade(_inner));
        Mist(_inner) -> "color:" + paletteVar("mist", colorMistShade(_inner));
        Taupe(_inner) -> "color:" + paletteVar("taupe", colorTaupeShade(_inner));
        White -> "color:" + themeVar(nsPrefix(Ns.Color) + "white");
        Black -> "color:" + themeVar(nsPrefix(Ns.Color) + "black");
        Transparent -> "color:transparent";
        Current -> "color:currentColor";
        Inherit -> "color:inherit";
        Hex(value) -> "color:" + value;
    };
    return out;
}


fn colorRedShade(s: Token.Color.Red) -> string {
    val out = case s {
        __50 -> "50"; __100 -> "100"; __200 -> "200"; __300 -> "300";
        __400 -> "400"; __500 -> "500"; __600 -> "600"; __700 -> "700";
        __800 -> "800"; __900 -> "900"; __950 -> "950";
    };
    return out;
}

fn colorOrangeShade(s: Token.Color.Orange) -> string {
    val out = case s {
        __50 -> "50"; __100 -> "100"; __200 -> "200"; __300 -> "300";
        __400 -> "400"; __500 -> "500"; __600 -> "600"; __700 -> "700";
        __800 -> "800"; __900 -> "900"; __950 -> "950";
    };
    return out;
}

fn colorAmberShade(s: Token.Color.Amber) -> string {
    val out = case s {
        __50 -> "50"; __100 -> "100"; __200 -> "200"; __300 -> "300";
        __400 -> "400"; __500 -> "500"; __600 -> "600"; __700 -> "700";
        __800 -> "800"; __900 -> "900"; __950 -> "950";
    };
    return out;
}

fn colorYellowShade(s: Token.Color.Yellow) -> string {
    val out = case s {
        __50 -> "50"; __100 -> "100"; __200 -> "200"; __300 -> "300";
