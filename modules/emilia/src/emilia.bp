// The value `paletteEntries()` carries for a name, or `""` when it carries
// none. `themeValue` reads a `Theme`; this reads the list before it is one.
fn paletteValue(name: string) -> string {
    return paletteEntries()
        .filter({ e -> e.name == name })
        .map({ e -> e.value })
        .join("");
}


// ── tests · the theme contribution ───────────────────────────────────────────

test "paletteEntries — 286 entries, 26 families x 11 shades, and nothing else" {
    assert paletteEntries().length == 286;
    assert paletteEntries().filter({ e -> e.name.startsWith("--color-") }).length == 286;
    assert paletteEntries().filter({ e -> e.name.startsWith("--color-red-") }).length == 11;
    assert paletteEntries().filter({ e -> e.name.startsWith("--color-taupe-") }).length == 11;
}

test "paletteEntries — the two values the reference prints, in upstream's spelling" {
    assert paletteValue("--color-red-500") == "oklch(63.7% 0.237 25.331)";
    assert paletteValue("--color-blue-500") == "oklch(62.3% 0.214 259.815)";
}

test "paletteEntries — white and black stay front 54's and are not duplicated" {
    assert paletteValue("--color-white") == "";
    assert paletteValue("--color-black") == "";
    assert themeValue(defaultTheme(), "--color-white") == "#fff";
    assert themeValue(defaultTheme(), "--color-black") == "#000";
}

test "paletteEntries — every entry's name is one a utility can reference" {
    val th = extendTheme(defaultTheme(), paletteEntries());
    assert themeValue(th, "--color-red-500") == "oklch(63.7% 0.237 25.331)";
    assert themeValue(th, "--color-slate-900") == "oklch(20.8% 0.042 265.755)";
    assert themeValue(th, "--color-mist-50") != "";
    assert paletteVar("red", "500") == "var(--color-red-500)";
    assert themeValue(th, "--color-white") == "#fff";
}

test "paletteEntries — composing it does not disturb the rest of the theme" {
    val th = extendTheme(defaultTheme(), paletteEntries());
    assert themeValue(th, "--spacing") == "0.25rem";
    assert themeValue(th, "--breakpoint-md") == "48rem";
    assert namespace(th, Ns.Color).length == 288;
    assert th.keyframes.length == defaultTheme().keyframes.length;
}

test "emilia emits no @theme block of its own — composing the palette is the caller's" {
    val tokens: Token[] = [.Color.Sky.500, .Bg.Color.Slate.900];
    val _cls = emilia(tokens);
    val styles = await flushWith(bareOptions());
    assert styles.indexOf("@theme") == -1;
    assert styles.indexOf("oklch") == -1;
    assert styles.indexOf("var(--color-sky-500)") != -1;
}

test "end to end — a two-token list renders one rule of two theme references" {
    val tokens: Token[] = [.Bg.Color.Slate.900, .Color.Slate.50];
    val cls = emilia(tokens);
    val styles = await flushWith(bareOptions());
    assert styles == "<style>@layer theme, base, components, utilities;@layer utilities{."
        + cls + "{background-color:var(--color-slate-900);color:var(--color-slate-50)}}</style>";
}

// ── the `Alpha` wrapper · upstream's `/N` opacity suffix ─────────────────────
//
// `bg-red-500/50` is the most used colour form in real markup and v0 had no
// token that expressed it. Upstream expands the suffix by MIXING the colour
// with transparent, so `bg-red-500/50` is
// `background-color: color-mix(in oklab, var(--color-red-500) 50%,
// transparent)`; `oklab` is the mixing space, and it is the one piece of this
// front the local reference does not print — `§ 3.6` shows the class form and
// never its CSS. Checked against upstream before it was written here.
//
// WHY IT IS A WRAPPER AND NOT A LEAF. Opacity cannot hang under the family:
// the shade is already the leaf, and a second numeric level would multiply the
// grid to 26 x 11 x 21. It cannot be a payload leaf inside the section either
// — a payload variant nested in a section has no constructible spelling
// (`Tok.Color.Hex("#abc")` reds `'Hex' is not declared in any behavior
// implemented for 'Tok'`). A TOP-LEVEL variant with a builtin-typed field is
// the one shape that builds, which is the shape `Hover(inner: Token[])`
// already has.
//
// IT REWRITES A SHEET, NOT A STRING. The spec's `alphaWrap(percent,
// tokensToCss(inner))` predates front 56: a token list produces a `Sheet` now,
// and folding it back to one string would flatten away the selector and the
// at-rule of any modifier inside it. Mapping the rewrite over each rule's
// declarations keeps both, which is what makes `Alpha` nest with a modifier in
// EITHER order — `Hover([Alpha(…)])` and `Alpha([Hover(…)])` both work, and
// the tests pin both.
//
// A NON-COLOUR TOKEN IS REWRITTEN TOO, and the result is meaningless CSS
// (`font-weight:color-mix(in oklab, bold 50%, transparent)`). That is
// deliberate: silently dropping the declaration would hide the mistake, and a
// declaration a browser discards is visible in devtools the moment it is
// looked for. The type system is where that gets refused, if it ever is.

// Split one `prop:value` declaration at its FIRST colon and rebuild the value
// as a mix with transparent. A declaration with no colon is returned
// unchanged — there is nothing to rewrite and inventing one would be worse.
//
// `String.slice` is never called here, in this file or anywhere in this
// library: the commonJS `String` prelude's `charCodeAt` patch is
// self-recursive, and one `slice` installs the prelude and blows the stack
// program-wide. `split` + `at` + the ARRAY `slice` do the same job.
fn alphaDecl(percent: i32, d: string) -> string {
    val parts = d.split(":");
    val prop = parts.at(0) ?? "";
    val value = parts.slice(1, parts.length).join(":");
    val mixed = "color-mix(in oklab, " + value + " " + percent.toString() + "%, transparent)";
    val out = if (parts.length < 2) d else prop + ":" + mixed;
    return out;
}

// Rewrite every declaration of a `;`-joined declaration string. Public because
// it takes and answers plain STRINGS — front 57's escape hatch can hand it a
// declaration it did not get from a token and get the same rewrite.
pub fn alphaWrap(percent: i32, css: string) -> string {
    return css.split(";").map({ d -> alphaDecl(percent, d) }).join(";");
}

fn alphaRule(r: Rule, percent: i32) -> Rule {
    return Rule(
        layer: r.layer,
        atRules: r.atRules,
        selector: r.selector,
        declarations: alphaWrap(percent, r.declarations),
        important: r.important,
    );
}

// The declarations change; the layer, the at-rules, the selector and the
// important flag do not, so a variant wrapped inside an `Alpha` keeps
// everything that made it a variant. Blocks pass through — a `@keyframes` body
// is not a declaration list.
fn alphaSheet(s: Sheet, percent: i32) -> Sheet {
    return Sheet(rules: s.rules.map({ r -> alphaRule(r, percent) }), blocks: s.blocks);
}

// ── tests · the `Alpha` wrapper ──────────────────────────────────────────────

test "Alpha — the two rows the reference shows as classes" {
    val bg: Token[] = [.Bg.Color.Red.500];
    assert tokenDeclarations(Token.Alpha(percent: 50, inner: bg))
        == "background-color:color-mix(in oklab, var(--color-red-500) 50%, transparent)";
    val fg: Token[] = [.Color.Blue.600];
    assert tokenDeclarations(Token.Alpha(percent: 80, inner: fg))
        == "color:color-mix(in oklab, var(--color-blue-600) 80%, transparent)";
}

test "Alpha — four percentages over the same colour" {
    val inner: Token[] = [.Color.Sky.500];
    assert tokenDeclarations(Token.Alpha(percent: 5, inner: inner))
        == "color:color-mix(in oklab, var(--color-sky-500) 5%, transparent)";
    assert tokenDeclarations(Token.Alpha(percent: 25, inner: inner))
        == "color:color-mix(in oklab, var(--color-sky-500) 25%, transparent)";
    assert tokenDeclarations(Token.Alpha(percent: 75, inner: inner))
        == "color:color-mix(in oklab, var(--color-sky-500) 75%, transparent)";
    assert tokenDeclarations(Token.Alpha(percent: 100, inner: inner))
        == "color:color-mix(in oklab, var(--color-sky-500) 100%, transparent)";
}

test "Alpha — over two colour tokens, both declarations are rewritten" {
    val inner: Token[] = [.Color.Blue.600, .Bg.Color.Red.500];
    val s = tokenToSheet(Token.Alpha(percent: 40, inner: inner), defaultTheme());
    assert s.rules.length == 2;
    assert declarationsOf(s).join(";")
        == "color:color-mix(in oklab, var(--color-blue-600) 40%, transparent);"
         + "background-color:color-mix(in oklab, var(--color-red-500) 40%, transparent)";
}

test "Alpha — a non-colour token is rewritten too, and the result is meaningless CSS" {
    val inner: Token[] = [.Text.Bold];
    assert tokenDeclarations(Token.Alpha(percent: 50, inner: inner))
        == "font-weight:color-mix(in oklab, bold 50%, transparent)";
}

test "Alpha — a keyword colour survives structurally, mixed with transparent" {
    val inner: Token[] = [.Color.Current];
    assert tokenDeclarations(Token.Alpha(percent: 60, inner: inner))
        == "color:color-mix(in oklab, currentColor 60%, transparent)";
}

test "Alpha nests inside Hover, and the variant keeps its selector and at-rule" {
    val deepest: Token[] = [.Color.Red.600];
    val alpha: Token[] = [Token.Alpha(percent: 50, inner: deepest)];
    val r = firstRuleOf(tokenToSheet(Token.Hover(alpha), defaultTheme()));
    assert r.selector == "&:hover";
    assert r.atRules.join("|") == "@media (hover: hover)";
    assert r.declarations == "color:color-mix(in oklab, var(--color-red-600) 50%, transparent)";
}

test "Hover nests inside Alpha, and the rewrite reaches the varied rule" {
    val deepest: Token[] = [.Color.Red.600];
    val hover: Token[] = [Token.Hover(deepest)];
    val r = firstRuleOf(tokenToSheet(Token.Alpha(percent: 50, inner: hover), defaultTheme()));
    assert r.selector == "&:hover";
    assert r.atRules.join("|") == "@media (hover: hover)";
    assert r.declarations == "color:color-mix(in oklab, var(--color-red-600) 50%, transparent)";
}

test "alphaWrap — plain strings in, plain strings out, and a colonless one is untouched" {
    assert alphaWrap(50, "color:red") == "color:color-mix(in oklab, red 50%, transparent)";
    assert alphaWrap(50, "") == "";
    assert alphaWrap(50, "nonsense") == "nonsense";
    assert alphaWrap(50, "background-image:url(a:b)")
        == "background-image:color-mix(in oklab, url(a:b) 50%, transparent)";
}

test "Alpha — the rewritten declaration carries no codec separator" {
    val inner: Token[] = [.Bg.Color.Red.500];
    val s = tokenToSheet(Token.Alpha(percent: 50, inner: inner), defaultTheme());
    assert declarationsOf(s).any({ d -> carriesSeparator(d) }) == false;
    assert encodeSheet(decodeSheet(encodeSheet(s))) == encodeSheet(s);
}

test "Alpha — end to end, the `bg-red-500/50` row as a document" {
    val inner: Token[] = [.Bg.Color.Red.500];
    val tokens: Token[] = [Token.Alpha(percent: 50, inner: inner)];
    val cls = emilia(tokens);
    val styles = await flushWith(bareOptions());
    assert styles == "<style>@layer theme, base, components, utilities;@layer utilities{."
        + cls + "{background-color:color-mix(in oklab, var(--color-red-500) 50%, transparent)}}</style>";
}

// ── the palette is a string-to-string mapping, with the enum at its edge ─────
//
// Front 57 will need to hand a colour emilia's enum does not carry — an
// arbitrary value — to the same formatter and get a well-formed declaration
// back. Nothing in this front stands in the way, and that is a design
// constraint rather than an accident:
//
//   - `paletteVar(family, shade)` takes two plain STRINGS and is `pub`. It
//     never sees a `Token.Color`, so a family and a shade that did not come
//     from a leaf format identically.
//   - `alphaWrap(percent, css)` takes a declaration string and is `pub`, for
//     the same reason.
//   - THE PROPERTY NAME LIVES IN THE DISPATCHER, not in the value. `color:` and
//     `background-color:` are written in `colorTokenToCss` / `bgColorTokenToCss`
//     and nowhere else, so a front that needs a third property reuses the value
//     half without a second palette table.
//   - No function in this front takes a `Token.Color` where a `string` would do.
//
// `Color.Hex(value: string)` is the proof that a string payload splices into
// the emitted CSS, and its arm is retained unchanged. It is also
// UNCONSTRUCTIBLE, and measured rather than assumed — against
// `zig-out/bin/botopink`, on this enum:
//
//     Token.Color.Hex("#abc")
//       error: 'Hex' is not declared in any behavior implemented for 'Token'
//     val h: Token = .Color.Hex("#abc");
//       error: unbound variable 'Color'
//
// A payload leaf NESTED INSIDE A SECTION has no constructible spelling; the
// variant type-checks in a `case` pattern, so the surface looks complete and
// is not. The shape that does build is a TOP-LEVEL variant with builtin-typed
// fields — which is what `Token.Alpha(percent: i32, inner: Token[])` above is,
// and what front 57's escape hatch will have to be. Contract 4a says so for
// every payload-carrying token in the milestone.

test "the palette formats a family and a shade it did not get from a leaf" {
    assert paletteVar("brand", "500") == "var(--color-brand-500)";
    assert paletteVar("red", "550") == "var(--color-red-550)";
    assert alphaWrap(30, "color:" + paletteVar("brand", "500"))
        == "color:color-mix(in oklab, var(--color-brand-500) 30%, transparent)";
}

test "the property name is the dispatcher's, so the same value serves both" {
    val shared = paletteVar("red", "500");
    assert tokenDeclarations(.Color.Red.600).indexOf(paletteVar("red", "600")) != -1;
    assert tokenDeclarations(.Bg.Color.Red.500) == "background-color:" + shared;
    assert tokenDeclarations(.Color.Red.400) == "color:" + paletteVar("red", "400");
}

test "a project override reaches every rule, because the token emits a reference" {
    val brand: ThemeEntry[] = [ThemeEntry(name: "--color-red-500", value: "#ff0000")];
    val th = extendTheme(extendTheme(defaultTheme(), paletteEntries()), brand);
    assert themeValue(th, "--color-red-500") == "#ff0000";
    assert tokenDeclarations(.Bg.Color.Red.500) == "background-color:var(--color-red-500)";
    assert themeValue(th, "--color-red-600") == "oklch(57.7% 0.245 27.325)";
}
