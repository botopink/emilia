// THE NINE DIRECTIONS OF MARGIN, each carrying two things padding has no use
// for. `Auto` is a VALUE on the ladder, so `.Margin.X.Auto` gets the
// two-property form from the same axis expansion every multiplier gets, and
// `.Margin.All.Auto` gets the shorthand. `Neg` is `-mt-4`, the form upstream
// spells with a leading minus and for which there is no alternative: it takes
// no `0` and no `Auto`, a negative zero and a negative auto being no utility at
// all, and it answers `spacing(-n)` — front 54 needs no second function for it.
//
// `Neg.Half` carries `1, 2, 3` where the positive `Half` carries `0, 1, 2, 3`.
// `spacingHalf(-0)` is `spacingHalf(0)` — an i32 has no negative zero — so
// `-0.5` is the one rung of the ladder front 54 cannot spell, and this front
// will not spell a second `calc(var(--spacing) * …)` of its own to reach it.
// The gap is front 54's to close (a signed half step); until it does,
// `-mt-0.5` has no token and no wrong token either.
fn marginTokenToCss(t: Token.Margin, th: Theme) -> string {
    val out = case t {
        All(_inner) -> oneDecl("margin", marginScaleAll(_inner, th));
        X(_inner) -> axisDecl("margin-left", "margin-right", marginScaleX(_inner, th));
        Y(_inner) -> axisDecl("margin-top", "margin-bottom", marginScaleY(_inner, th));
        T(_inner) -> oneDecl("margin-top", marginScaleT(_inner, th));
        R(_inner) -> oneDecl("margin-right", marginScaleR(_inner, th));
        B(_inner) -> oneDecl("margin-bottom", marginScaleB(_inner, th));
        L(_inner) -> oneDecl("margin-left", marginScaleL(_inner, th));
        S(_inner) -> oneDecl("margin-inline-start", marginScaleS(_inner, th));
        E(_inner) -> oneDecl("margin-inline-end", marginScaleE(_inner, th));
    };
    return out;
}

fn marginScaleAll(s: Token.Margin.All, th: Theme) -> string {
    val out = case s {
        Auto -> "auto"; __0 -> spacing(0); __1 -> spacing(1); __2 -> spacing(2);
        __3 -> spacing(3); __4 -> spacing(4); __5 -> spacing(5); __6 -> spacing(6);
        __7 -> spacing(7); __8 -> spacing(8); __9 -> spacing(9); __10 -> spacing(10);
        __11 -> spacing(11); __12 -> spacing(12); __14 -> spacing(14); __16 -> spacing(16);
        __20 -> spacing(20); __24 -> spacing(24); __28 -> spacing(28); __32 -> spacing(32);
        __36 -> spacing(36); __40 -> spacing(40); __44 -> spacing(44); __48 -> spacing(48);
        __52 -> spacing(52); __56 -> spacing(56); __60 -> spacing(60); __64 -> spacing(64);
        __72 -> spacing(72); __80 -> spacing(80); __96 -> spacing(96);
        Px -> "1px";
        Half(_inner) -> marginHalfAll(_inner, th);
        Neg(_inner) -> marginNegAll(_inner, th);
    };
    return out;
}

