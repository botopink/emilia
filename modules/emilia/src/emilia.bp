// THE THIRTEEN SUB-SECTIONS OF SIZE — `§ 8.1`-`§ 8.7`. `W`/`H` and their min
// and max forms, `Both` (upstream's `size-*`, two properties from one leaf),
// and the six logical forms `inline-size` / `block-size` with their own min and
// max, which follow the writing direction where width and height do not.
//
// Four kinds of leaf. A NUMBER is the spacing ladder again, so `w-64` is
// `width:calc(var(--spacing) * 64)` and a project's `--spacing` moves it. A
// FRACTION is a percentage — `1/2` is not an identifier and not a digit run, so
// it cannot be a leaf and `Frac { Half, Third, … }` carries it by name. A
// KEYWORD is an intrinsic size or a viewport unit, and the viewport unit
// DIFFERS BY AXIS: `w-screen` is `100vw` where `h-screen` is `100vh`. A NAMED
// WIDTH is the theme's container ladder, not this front's — `max-w-md` is
// `max-width:var(--container-md)` — and `MaxW.Screen.*` reads the breakpoint
// ladder the same way, so a project that redefines `--container-md` or
// `--breakpoint-lg` moves every utility that names it. The `rem` values behind
// those two ladders are written once, in `theme.bp`, and never here.

// `containerVar("md")` is `var(--container-md)`, built from front 54's
// namespace prefix and front 54's `themeVar` — the same shape as front 33's
// `paletteVar`, and for the same reason: the prefix has one author.
fn containerVar(name: string) -> string {
    return themeVar(nsPrefix(Ns.Container) + name);
}

fn breakpointVar(name: string) -> string {
    return themeVar(nsPrefix(Ns.Breakpoint) + name);
}

fn sizeTokenToCss(t: Token.Size, th: Theme) -> string {
    val out = case t {
        W(_inner) -> oneDecl("width", sizeWToCss(_inner, th));
        H(_inner) -> oneDecl("height", sizeHToCss(_inner, th));
        Both(_inner) -> axisDecl("width", "height", sizeBothToCss(_inner, th));
        MinW(_inner) -> oneDecl("min-width", sizeMinWToCss(_inner, th));
        MaxW(_inner) -> oneDecl("max-width", sizeMaxWToCss(_inner, th));
        MinH(_inner) -> oneDecl("min-height", sizeMinHToCss(_inner, th));
        MaxH(_inner) -> oneDecl("max-height", sizeMaxHToCss(_inner, th));
        Inline(_inner) -> oneDecl("inline-size", sizeInlineToCss(_inner, th));
        Block(_inner) -> oneDecl("block-size", sizeBlockToCss(_inner, th));
        MinInline(_inner) -> oneDecl("min-inline-size", sizeMinInlineToCss(_inner, th));
        MaxInline(_inner) -> oneDecl("max-inline-size", sizeMaxInlineToCss(_inner, th));
        MinBlock(_inner) -> oneDecl("min-block-size", sizeMinBlockToCss(_inner, th));
        MaxBlock(_inner) -> oneDecl("max-block-size", sizeMaxBlockToCss(_inner, th));
    };
    return out;
}

fn sizeMaxWScreenToCss(s: Token.Size.MaxW.Screen, th: Theme) -> string {
    val out = case s {
        Sm -> breakpointVar("sm"); Md -> breakpointVar("md"); Lg -> breakpointVar("lg");
        Xl -> breakpointVar("xl"); X2xl -> breakpointVar("2xl");
    };
    return out;
}

fn sizeWToCss(s: Token.Size.W, th: Theme) -> string {
    val out = case s {
        __0 -> spacing(0); __1 -> spacing(1); __2 -> spacing(2); __3 -> spacing(3);
