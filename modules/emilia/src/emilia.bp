// ── the walks ────────────────────────────────────────────────────────────
//
// The table is long, so the invariants are asserted over the WHOLE of it
// rather than row by row. `everyVariant` is every `Variant`-returning fn in
// this front; `everyModifier` is every top-level variant `tokens.bp`
// declares under the same banner, each wrapping one declaration.

fn everyVariant(th: Theme) -> Variant[] {
    val out: Variant[] = [
        smVariant(th),
        mdVariant(th),
        lgVariant(th),
        xlVariant(th),
        x2xlVariant(th),
        maxSmVariant(th),
        maxMdVariant(th),
        maxLgVariant(th),
        maxXlVariant(th),
        maxX2xlVariant(th),
        darkVariant(th),
        printVariant(),
        portraitVariant(),
        landscapeVariant(),
        motionSafeVariant(),
        motionReduceVariant(),
        contrastMoreVariant(),
        contrastLessVariant(),
        forcedColorsVariant(),
        hoverVariant(),
        focusVariant(),
        focusWithinVariant(),
        focusVisibleVariant(),
        activeVariant(),
        visitedVariant(),
        targetVariant(),
        openVariant(),
        inertVariant(),
        disabledVariant(),
        enabledVariant(),
        checkedVariant(),
        indeterminateVariant(),
        defaultVariant(),
        optionalVariant(),
        requiredVariant(),
        validVariant(),
        invalidVariant(),
        userValidVariant(),
        userInvalidVariant(),
        inRangeVariant(),
        outOfRangeVariant(),
        placeholderShownVariant(),
        autofillVariant(),
        readOnlyVariant(),
        firstVariant(),
        lastVariant(),
        onlyVariant(),
        oddVariant(),
        evenVariant(),
        firstOfTypeVariant(),
        lastOfTypeVariant(),
        onlyOfTypeVariant(),
        emptyVariant(),
        nthVariant(3),
        nthLastVariant(5),
        beforeVariant(),
        afterVariant(),
        firstLetterVariant(),
        firstLineVariant(),
        placeholderVariant(),
        fileVariant(),
        markerVariant(),
        selectionVariant(),
        backdropVariant(),
        groupHoverVariant(),
        groupFocusVariant(),
        groupActiveVariant(),
        groupVisitedVariant(),
        groupDisabledVariant(),
        groupOpenVariant(),
        peerHoverVariant(),
        peerFocusVariant(),
        peerActiveVariant(),
        peerCheckedVariant(),
        peerInvalidVariant(),
        peerRequiredVariant(),
        peerDisabledVariant(),
        peerPlaceholderShownVariant(),
        rtlVariant(),
        ltrVariant(),
        childrenVariant(),
        descendantsVariant(),
    ];
    return out;
}

fn everyModifier() -> Token[] {
    val inner = boldInner();
    val out: Token[] = [
        Token.Sm(inner),
        Token.Md(inner),
        Token.Lg(inner),
        Token.Xl(inner),
        Token.X2xl(inner),
        Token.MaxSm(inner),
