// emilia-card — a small jhonstart page styled via emilia's `Token` enum.
//
// V0 surface (this example): `emilia(...)` is called as an ordinary fn
// whose return is the class NAME (a `string`); the spec's
// `#[emilia(...)] div([])` decorator form and the `[emilia]={…}` html DSL
// attribute form need the two generic jhonstart hooks (F0 second half,
// deferred — both depend on compiler features outside this lib).
//
// What this example DOES prove end-to-end:
//   - Mixed token lists lower to flat CSS declarations joined with `;`.
//   - Modifier variants (`.Hover([...])`, `.Md([...])`) compose pseudo /
//     media wrappers around their inner tokens.
//   - Identical token lists on two sites collapse to ONE class name
//     (content-derived `e_<hash>`).
//   - `flush()` returns a `<style>...</style>` document and clears
//     the per-render registry.
//
// Front 56 changed WHAT that document looks like. A modifier is no longer a
// block nested inside the class body: it is a SIBLING rule, hoisted out with
// its own selector and its own at-rule, inside the `utilities` cascade layer,
// under a document that opens with `@layer theme, base, components,
// utilities;` and a `:root` block carrying the theme.
//
// Composition mirrors the SSR contract from the spec ("Render output"):
//   `renderToString(page) + flush()` — markup first, then the
//   `<style>` block. Here we just smoke-test that both pieces produce
//   the expected golden strings.

// `emilia` is the bare entry point; `flush` is the per-render serializer
// (the SSR caller pairs it with `renderToString`). The `import emilia from
// "emilia"` package-handle form binds the handle but doesn't lower the bare
// fn call yet — recorded follow-up; the `{emilia, flush}` named imports
// reach both today.

import { emilia, flush, Token } from "emilia";
import { div, p, h1, renderToString } from "jhonstart";

// A card: outer container + heading + body, all styled via emilia tokens.
// The class names returned by `emilia(...)` are stable hashes — call sites
// using identical token lists share one class (`cardBg` below).
//
// V1 enum-section path access: `.Pad.All.__4`, `.Color.Red.600`, etc.
// Numeric leaves are pure digits in the chain (`.600`) — the `__600`
// spelling is the `case`-pattern one and also reads in expression
// position.
//
// The shades here are 600 and NOT 500, which is what this example carried
// before front 33 widened the palette. `.Color.Red.500` and
// `.Color.Gray.500` are declared and unreachable: the compiler's
// leading-dot section resolver picks between `Token` and the synthesised
// `__Token__Border` by hash order, and `Token.Border.Color` (front 40's
// stub) carries Red and Gray at 100/500/700 too. See the BLOCKED note in
// `emilia.bp` under the front 33 banner.
val cardTokens: Token[] = [
    .Pad.All.__4,
    .Bg.White,
    .Color.Black,
];
val cardBg = emilia(cardTokens);

val titleTokens: Token[] = [
    .Text.Size.X3xl,
    .Text.Bold,
    .Color.Red.600,
];
val titleStyle = emilia(titleTokens);

val hoverInner: Token[] = [.Color.Red.600];
val mdInner: Token[] = [.Text.Size.Lg];
val bodyTokens: Token[] = [
    .Text.Size.Base,
    .Color.Gray.600,
    Token.Hover(hoverInner),
    Token.Md(mdInner),
];
val bodyStyle = emilia(bodyTokens);

// The element tree. Builders take `Children`; V0's `Element` has no
// attribute slot, so the class names produced above are not yet
// inlined into the rendered HTML — they live in the `<style>` block.
// Once jhonstart grows an attribute carrier + the
// annotation-on-builder hook, the spec form (`#[emilia([…])] div([…])`)
// will write the class into the rendered tag.
val page = div([
    h1([], []),
    p([], []),
], []);

// Pretty-print the test summary (`@print` is the test-runner ergonomic).
#[@future]
fn main() -> @Future<void> {
    @print(renderToString(page));
    @print(cardBg);
    @print(titleStyle);
    @print(bodyStyle);
    @print(await flush());
}

// ── tests — the smoke contract ──────────────────────────────────────────────

test "page renders to the expected jhonstart tree" {
    assert renderToString(page) == "<div><h1></h1><p></p></div>";
}

test "all three style sites produce `e_<hash>`-shaped class names" {
    assert cardBg.startsWith("e_");
    assert titleStyle.startsWith("e_");
    assert bodyStyle.startsWith("e_");
}

test "identical token lists collapse to the same class name" {
    val cardTokens2: Token[] = [
        .Pad.All.__4,
        .Bg.White,
        .Color.Black,
    ];
    val cardBg2 = emilia(cardTokens2);
    assert cardBg2 == cardBg;
}

test "flush returns a layered `<style>...</style>` document with the registered rules" {
    val styles = await flush();
    assert styles.startsWith("<style>@layer theme, base, components, utilities;@layer theme{:root{");
    assert styles.endsWith("</style>");
    // Three distinct classes were registered above (cardBg, titleStyle,
    // bodyStyle) PLUS one re-registration in the previous test — the Map
    // dedup keeps just the three unique entries.
    assert styles.indexOf(cardBg) != -1;
    assert styles.indexOf(titleStyle) != -1;
    assert styles.indexOf(bodyStyle) != -1;
    // Modifier composition is a SIBLING rule now, hoisted out of the class
    // body with the selector and the at-rule the variant reference gives it —
    // `@media (hover: hover) { &:hover }` for hover, `@media (width >= 48rem)`
    // for the `md` breakpoint, read from the theme's `--breakpoint-md`.
    // Front 33 landed the palette: `.Color.Red.600` lowers to the theme
    // reference `var(--color-red-600)`, not to the CSS keyword `red` the V1
    // stub emitted for every shade of the family.
    assert styles.indexOf("@media (hover: hover){." + bodyStyle + ":hover{color:var(--color-red-600)}}") != -1;
    assert styles.indexOf("@media (width >= 48rem){." + bodyStyle + "{font-size:1.125rem}}") != -1;
    // `.Text.Size.Base` and `.Text.Size.X3xl` are MISSING from the two class
    // bodies below, and they were missing before front 56 too (the pre-56
    // document read `.e_x{;font-weight:bold;color:red}` — the empty leading
    // declaration is the same token going nowhere). The cause is a commonJS
    // codegen defect, not an emilia one: a `case` arm whose variant name is
    // unique in the program lowers to `instanceof`, and a consumer package
    // re-emits its own copy of the enum classes, so a value built in
    // `emilia-card` is never `instanceof` the class `emilia` matches against
    // and the whole `case` answers `undefined`. `Sm`/`Lg`/`Xl` survive only
    // because their names repeat elsewhere in `Token`, which makes the same
    // compiler lower those arms to a `tag` comparison instead. Reported to
    // botopink-lang; the assertions below pin what is actually emitted so the
    // fix is visible as a change here.
    assert styles.indexOf("." + bodyStyle + "{color:var(--color-gray-600)}") != -1;
    assert styles.indexOf("." + titleStyle + "{font-weight:bold;color:var(--color-red-600)}") != -1;
}
