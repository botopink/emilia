import { Token };

fn tokenToCss(t: Token) -> string {
    val out = case t {
        Text(_inner)   -> textTokenToCss(_inner);
        _              -> "other";
    };
    return out;
}

fn textTokenToCss(t: TokenText) -> string {
    val out = case t {
        Bold         -> "font-weight:bold";
        Italic       -> "font-style:italic";
        Underline    -> "text-decoration:underline";
        LineThrough  -> "text-decoration:line-through";
        Left         -> "text-align:left";
        Center       -> "text-align:center";
        Right        -> "text-align:right";
        Justify      -> "text-align:justify";
        Size(_inner) -> textSizeToCss(_inner);
    };
    return out;
}

fn textSizeToCss(s: TokenTextSize) -> string {
    val out = case s {
        Xs   -> "font-size:0.75rem";
        Sm   -> "font-size:0.875rem";
        Base -> "font-size:1rem";
        Lg   -> "font-size:1.125rem";
        Xl   -> "font-size:1.25rem";
        X2xl -> "font-size:1.5rem";
        X3xl -> "font-size:1.875rem";
        X4xl -> "font-size:2.25rem";
    };
    return out;
}

fn fontTokenToCss(t: TokenFont) -> string {
    val out = case t {
        Sans           -> "font-family:ui-sans-serif,system-ui,sans-serif";
        Serif          -> "font-family:ui-serif,Georgia,serif";
        Mono           -> "font-family:ui-monospace,SFMono-Regular,Menlo,monospace";
        Weight(_inner) -> fontWeightToCss(_inner);
    };
    return out;
}

fn fontWeightToCss(w: TokenFontWeight) -> string {
    val out = case w {
        Light  -> "font-weight:300";
        Normal -> "font-weight:400";
        Medium -> "font-weight:500";
        Bold   -> "font-weight:700";
        Black  -> "font-weight:900";
    };
    return out;
}

fn colorTokenToCss(t: TokenColor) -> string {
    val out = case t {
        Red(_inner)   -> "color:red";
        Blue(_inner)  -> "color:blue";
        Green(_inner) -> "color:green";
        Gray(_inner)  -> "color:gray";
        White         -> "color:#ffffff";
        Black         -> "color:#000000";
        Hex(value)    -> "color:" + value;
    };
    return out;
}

fn bgTokenToCss(t: TokenBg) -> string {
    val out = case t {
        Red(_inner)  -> "background:red";
        Blue(_inner) -> "background:blue";
        Gray(_inner) -> "background:gray";
        White        -> "background:#ffffff";
        Black        -> "background:#000000";
        Hex(value)   -> "background:" + value;
    };
    return out;
}

fn padTokenToCss(t: TokenPad) -> string {
    val out = case t {
        X(_inner)   -> "padding-x:" + padScaleX(_inner);
        Y(_inner)   -> "padding-y:" + padScaleY(_inner);
        All(_inner) -> "padding:" + padScaleAll(_inner);
    };
    return out;
}

fn padScaleX(s: TokenPadX) -> string {
    val out = case s {
        __1  -> "0.25rem";
        __2  -> "0.5rem";
        __4  -> "1rem";
        __8  -> "2rem";
        __16 -> "4rem";
    };
    return out;
}

fn padScaleY(s: TokenPadY) -> string {
    val out = case s {
        __1 -> "0.25rem";
        __2 -> "0.5rem";
        __4 -> "1rem";
        __8 -> "2rem";
    };
    return out;
}

fn padScaleAll(s: TokenPadAll) -> string {
    val out = case s {
        __1  -> "0.25rem";
        __2  -> "0.5rem";
        __4  -> "1rem";
        __8  -> "2rem";
        __16 -> "4rem";
    };
    return out;
}

fn marginTokenToCss(t: TokenMargin) -> string {
    val out = case t {
        X(_inner)   -> marginScaleX(_inner);
        Y(_inner)   -> "margin-y:" + marginScaleY(_inner);
        All(_inner) -> "margin:" + marginScaleAll(_inner);
    };
    return out;
}

fn marginScaleX(s: TokenMarginX) -> string {
    val out = case s {
        Auto -> "margin-auto";
        __1  -> "m-0.25";
        __2  -> "m-0.5";
        __4  -> "m-1";
        __8  -> "m-2";
    };
    return out;
}

fn marginScaleY(s: TokenMarginY) -> string {
    val out = case s {
        __1 -> "0.25rem";
        __2 -> "0.5rem";
        __4 -> "1rem";
        __8 -> "2rem";
    };
    return out;
}

fn marginScaleAll(s: TokenMarginAll) -> string {
    val out = case s {
        __1 -> "0.25rem";
        __2 -> "0.5rem";
        __4 -> "1rem";
        __8 -> "2rem";
    };
    return out;
}

fn layoutTokenToCss(t: TokenLayout) -> string {
    val out = case t {
        Block       -> "display:block";
        InlineBlock -> "display:inline-block";
        Inline      -> "display:inline";
        Hidden      -> "display:none";
        Flex        -> "display:flex";
        Grid        -> "display:grid";
    };
    return out;
}

fn flexTokenToCss(t: TokenFlex) -> string {
    val out = case t {
        Row             -> "flex-direction:row";
        Col             -> "flex-direction:column";
        Wrap            -> "flex-wrap:wrap";
        NoWrap          -> "flex-wrap:nowrap";
        Items(_inner)   -> flexItemsToCss(_inner);
        Justify(_inner) -> flexJustifyToCss(_inner);
        Gap(_inner)     -> "gap:" + flexGapScale(_inner);
    };
    return out;
}

fn flexItemsToCss(p: TokenFlexItems) -> string {
    val out = case p {
        Start   -> "align-items:flex-start";
        Center  -> "align-items:center";
        End     -> "align-items:flex-end";
        Stretch -> "align-items:stretch";
    };
    return out;
}

fn flexJustifyToCss(p: TokenFlexJustify) -> string {
    val out = case p {
        Start   -> "justify-content:flex-start";
        Center  -> "justify-content:center";
        End     -> "justify-content:flex-end";
        Between -> "justify-content:space-between";
        Around  -> "justify-content:space-around";
    };
    return out;
}

fn flexGapScale(s: TokenFlexGap) -> string {
    val out = case s {
        __1 -> "0.25rem";
        __2 -> "0.5rem";
        __4 -> "1rem";
        __8 -> "2rem";
    };
    return out;
}

fn borderTokenToCss(t: TokenBorder) -> string {
    val out = case t {
        W(_inner)       -> borderWidthToCss(_inner);
        Color(_inner)   -> borderColorToCss(_inner);
        Rounded(_inner) -> borderRoundedToCss(_inner);
    };
    return out;
}

fn borderWidthToCss(s: TokenBorderW) -> string {
    val out = case s {
        __0 -> "border-width:0";
        __1 -> "border-width:1px";
        __2 -> "border-width:2px";
        __4 -> "border-width:4px";
    };
    return out;
}

fn borderColorToCss(c: TokenBorderColor) -> string {
    val out = case c {
        Red(_inner)  -> "border-color:red";
        Gray(_inner) -> "border-color:gray";
        Hex(value)   -> "border-color:" + value;
    };
    return out;
}

fn borderRoundedToCss(r: TokenBorderRounded) -> string {
    val out = case r {
        Sm   -> "border-radius:0.125rem";
        Md   -> "border-radius:0.375rem";
        Lg   -> "border-radius:0.5rem";
        Full -> "border-radius:9999px";
    };
    return out;
}

fn effectTokenToCss(t: TokenEffect) -> string {
    val out = case t {
        Shadow(_inner)  -> shadowToCss(_inner);
        Opacity(_inner) -> opacityToCss(_inner);
    };
    return out;
}

fn shadowToCss(s: TokenEffectShadow) -> string {
    val out = case s {
        Sm -> "box-shadow:sm";
        Md -> "box-shadow:md";
        Lg -> "box-shadow:lg";
        Xl -> "box-shadow:xl";
    };
    return out;
}

fn opacityToCss(o: TokenEffectOpacity) -> string {
    val out = case o {
        __0   -> "opacity:0";
        __25  -> "opacity:0.25";
        __50  -> "opacity:0.5";
        __75  -> "opacity:0.75";
        __100 -> "opacity:1";
    };
    return out;
}

fn redPaletteHex(s: TokenColorRed) -> string {
    val out = case s {
        __100 -> "#fee2e2";
        __200 -> "#fecaca";
        __300 -> "#fca5a5";
        __400 -> "#f87171";
        __500 -> "#ef4444";
        __600 -> "#dc2626";
        __700 -> "#b91c1c";
        __800 -> "#991b1b";
        __900 -> "#7f1d1d";
    };
    return out;
}
