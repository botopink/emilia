//// emilia/tokens — the typed `Token` enum: the entire authored surface.
////
//// A consumer writes styles by LISTING typed tokens; never by writing CSS
//// strings. Each variant maps to a fixed CSS declaration via `tokenToCss`
//// (in `emilia.bp`). Unknown tokens are type errors at the call site, not
//// runtime fall-throughs.
////
//// V1 SHAPE (post enum-sections, landed in feat `bd5c69d`). The `Token`
//// enum uses NESTED SECTIONS with path access (`.Text.Bold`,
//// `.Color.Red.500`, `.Pad.X.4`). Sections compose to any depth; numeric
//// leaves are valid inside a section (the language extension's two
//// relaxations over today's enum grammar). Modifier variants
//// (`Hover([Token])`, `Md([Token])`, …) carry a recursive `Token[]`
//// payload — siblings of section heads at the top level.
////
//// SECTIONS:
////   Text     — Bold/Italic/Underline/LineThrough, Left/Center/Right/Justify,
////              + Size { Xs, Sm, Base, Lg, Xl, X2xl, X3xl, X4xl }
////   Font     — Sans/Serif/Mono + Weight { Light, Normal, Medium, Bold, Black }
////   Color    — Red/Blue/Green/Gray (palette per family) + Hex(string) escape
////   Bg       — Red/Blue/Gray palettes + White/Black/Hex(string)
////   Pad      — X/Y/All scales (1=0.25rem, 4=1rem, 16=4rem)
////   Margin   — X/Y/All scales (X carries Auto as a bare variant)
////   Layout   — Block/InlineBlock/Inline/Hidden/Flex/Grid
////   Flex     — Row/Col/Wrap/NoWrap + Items{}, Justify{}, Gap{}
////   Border   — W{}, Color{} (palette + Hex), Rounded{Sm,Md,Lg,Full}
////   Effect   — Shadow{Sm,Md,Lg,Xl}, Opacity{0,25,50,75,100}
////
//// MODIFIERS:
////   .Hover([Token])  → ":hover{…}"
////   .Focus([Token])  → ":focus{…}"
////   .Active([Token]) → ":active{…}"
////   .Md([Token])     → "@media(min-width:768px){…}"
////   .Lg([Token])     → "@media(min-width:1024px){…}"
////   .Xl([Token])     → "@media(min-width:1280px){…}"

pub enum Token {
    Text {
        Bold,
        Italic,
        Underline,
        LineThrough,
        Left,
        Center,
        Right,
        Justify,
        Size {
            Xs, Sm, Base, Lg, Xl, X2xl, X3xl, X4xl,
        }
    }

    Font {
        Sans,
        Serif,
        Mono,
        Weight {
            Light, Normal, Medium, Bold, Black,
        }
    }

    Color {
        Red   { 100, 200, 300, 400, 500, 600, 700, 800, 900 }
        Blue  { 100, 200, 300, 400, 500, 600, 700, 800, 900 }
        Green { 100, 300, 500, 700, 900 }
        Gray  { 100, 200, 300, 400, 500, 600, 700, 800, 900 }
        White,
        Black,
        Hex(value: string),
    }

    Bg {
        Red   { 100, 500, 700 }
        Blue  { 100, 500, 700 }
        Gray  { 100, 200, 500, 900 }
        White,
        Black,
        Hex(value: string),
    }

    Pad {
        X   { 1, 2, 4, 8, 16 }
        Y   { 1, 2, 4, 8 }
        All { 1, 2, 4, 8, 16 }
    }

    Margin {
        X   { Auto, 1, 2, 4, 8 }
        Y   { 1, 2, 4, 8 }
        All { 1, 2, 4, 8 }
    }

    Layout {
        Block,
        InlineBlock,
        Inline,
        Hidden,
        Flex,
        Grid,
    }

    Flex {
        Row,
        Col,
        Wrap,
        NoWrap,
        Items   { Start, Center, End, Stretch }
        Justify { Start, Center, End, Between, Around }
        Gap     { 1, 2, 4, 8 }
    }

    Border {
        W { 0, 1, 2, 4 }
        Color {
            Red  { 100, 500, 700 }
            Gray { 100, 500, 700 }
            Hex(value: string),
        }
        Rounded { Sm, Md, Lg, Full }
    }

    Effect {
        Shadow  { Sm, Md, Lg, Xl }
        Opacity { 0, 25, 50, 75, 100 }
    }

    Hover(inner: Token[]),
    Focus(inner: Token[]),
    Active(inner: Token[]),
    Md(inner: Token[]),
    Lg(inner: Token[]),
    Xl(inner: Token[]),
}
